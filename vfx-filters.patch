+static inline uint32_t shm_get(const void *base, size_t off)
+{
+    return __atomic_load_n((const uint32_t *)((const char *)base + off),
+                           __ATOMIC_RELAXED);
+}
+
+static inline void shm_put(void *base, size_t off, uint32_t v)
+{
+    __atomic_store_n((uint32_t *)((char *)base + off), v, __ATOMIC_RELAXED);
+}
