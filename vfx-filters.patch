+        f2b(o->intensity), f2b(o->localtone), f2b(o->localstructure),
+        f2b(o->skin), f2b(o->sharpness),
+        (uint32_t)o->style, (uint32_t)o->automask, (uint32_t)o->preset,
+        f2b(o->work_scale), (uint32_t)o->size, (uint32_t)o->filter,
+        f2b(o->detail), f2b(o->guard), f2b(o->white), (uint32_t)o->sdr16,
+        (uint32_t)o->mvec, (uint32_t)o->mvec_quality,
+    };
+    for (unsigned i = 0; i < sizeof(vals) / sizeof(vals[0]); i++) {
+        h ^= vals[i];
+        h *= 16777619u;
+    }
+    for (int i = 0; i < 3; i++) {
+        const char *s = o->override[i] ? o->override[i] : "";
+        for (; *s; s++) {
+            h ^= (unsigned char)*s;
+            h *= 16777619u;
+        }
+        h ^= 0xffu;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static float clampf(float v, float lo, float hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+// "key=val;key=val" over an already-resolved pass.
+static void apply_override(struct dlssnr_pass *ps, const char *spec)
+{
+    if (!spec || !*spec)
+        return;
+    char buf[512];
+    snprintf(buf, sizeof(buf), "%s", spec);
+
+    char *save = NULL;
+    for (char *tok = strtok_r(buf, ";", &save); tok; tok = strtok_r(NULL, ";", &save)) {
+        char *eq = strchr(tok, '=');
+        if (!eq)
+            continue;
+        *eq = '\0';
+        const char *key = tok;
+        const char *val = eq + 1;
+        char *end = NULL;
+        double dv = strtod(val, &end);
+        if (end == val)
+            continue;
+
+        if (!strcmp(key, "intensity"))       ps->intensity = clampf(dv, 0.0f, 1.0f);
+        else if (!strcmp(key, "localtone"))  ps->localtone = clampf(dv, 0.0f, 2.0f);
+        else if (!strcmp(key, "localstructure"))
+                                             ps->localstructure = clampf(dv, 0.0f, 2.0f);
+        else if (!strcmp(key, "skin"))       ps->skin = clampf(dv, -1.0f, 2.5f);
+        else if (!strcmp(key, "sharpness"))  ps->sharpness = clampf(dv, 0.0f, 1.0f);
+        else if (!strcmp(key, "style"))      ps->style = dv < 0 ? 0 : (dv > 2 ? 2 : (uint32_t)dv);
+        else if (!strcmp(key, "automask"))   ps->automask = dv != 0;
+        else if (!strcmp(key, "preset"))     ps->preset = dv < 0 ? 0 : (uint32_t)dv;
+    }
+}
+
+static void resolve_config(struct vf_dlssnr_opts *o,
+                           struct dlssnr_pass out[DLSSNR_MAX_PASSES])
+{
+    int pi = o->profile;
+    if (pi < 0 || pi > PROFILE_EXTREME)
+        pi = PROFILE_CINEMATIC;      // custom: start from cinematic, override all
+    const struct dlssnr_profile_def *pr = &dlssnr_profiles[pi];
+
+    struct dlssnr_pass base = {
+        .intensity      = pr->intensity,
+        .localtone      = pr->localtone,
+        .localstructure = pr->localstructure,
+        .skin           = pr->skin,
+        .sharpness      = 0.0f,
+        .style          = pr->style,
+        .preset         = 0,
+        .automask       = pr->automask,
+        .mask           = 0,
+    };
+
+    if (o->style >= 0)         base.style = o->style;
+    if (o->intensity > -999)   base.intensity = clampf(o->intensity, 0.0f, 1.0f);
+    if (o->localtone > -999)   base.localtone = clampf(o->localtone, 0.0f, 2.0f);
+    if (o->localstructure > -999)
+        base.localstructure = clampf(o->localstructure, 0.0f, 2.0f);
+    if (o->skin > -999)        base.skin = clampf(o->skin, -1.0f, 2.5f);
+    if (o->sharpness > -999)   base.sharpness = clampf(o->sharpness, 0.0f, 1.0f);
+    if (o->automask >= 0)      base.automask = o->automask != 0;
+    if (o->preset >= 0)        base.preset = o->preset;
+
+    for (int i = 0; i < DLSSNR_MAX_PASSES; i++) {
+        struct dlssnr_pass ps = base;
+        // NeuralScreen zeroes local tone from the second pass on: each pass
+        // re-tonemaps an already-tonemapped frame and the picture drifts dark
+        // by ~2% per pass. An explicit per-pass override still wins.
+        if (i >= 1)
+            ps.localtone = 0.0f;
+        if (i >= 1)
+            apply_override(&ps, o->override[i - 1]);
+        ps.mask = 0;
+        out[i] = ps;
+    }
+
+    // Mask = the fields that differ from pass 1's global values. A sparse
+    // override stays sparse in the header, which is what the helper expects.
+    for (int i = 1; i < DLSSNR_MAX_PASSES; i++) {
+        uint32_t m = 0;
+        if (out[i].intensity != base.intensity)             m |= OV_INTENSITY;
+        if (out[i].localtone != base.localtone)             m |= OV_LOCALTONE;
+        if (out[i].localstructure != base.localstructure)   m |= OV_LOCALSTRUCTURE;
+        if (out[i].skin != base.skin)                       m |= OV_SKINSTRUCTURE;
+        if (out[i].sharpness != base.sharpness)             m |= OV_SHARPNESS;
+        if (out[i].style != base.style)                     m |= OV_STYLE;
+        if (out[i].preset != base.preset)                   m |= OV_PRESET;
+        if (out[i].automask != base.automask)               m |= OV_AUTOMASK;
+        out[i].mask = m;
+    }
+    out[0].mask = 0;
+}
+
+// ── Shared memory ─────────────────────────────────────────────────────────
+
+static size_t shm_total(void)
+{
+    return DLSSNR_SHM_HEADER + (size_t)DLSSNR_SHM_MAX_FRAME * 2;
+}
+
+static void shm_close(struct priv *p)
+{
+    if (p->shm) {
+        munmap(p->shm, p->shm_bytes);
+        p->shm = NULL;
+    }
+    if (p->shm_fd >= 0) {
+        close(p->shm_fd);
+        p->shm_fd = -1;
+    }
+    p->shm_bytes = 0;
+}
+
+static bool shm_open_map(struct mp_filter *f, struct priv *p)
+{
+    if (p->shm)
+        return true;
+
+    char path[512];
+    if (p->opts->shm && p->opts->shm[0]) {
+        snprintf(path, sizeof(path), "%s", p->opts->shm);
+    } else {
+        const char *env = getenv("DLSSNR_SHM");
+        if (env && *env)
+            snprintf(path, sizeof(path), "%s", env);
+        else
+            snprintf(path, sizeof(path), "/tmp/dlssnr-%u/shm.bin", (unsigned)getuid());
+    }
+
+    // The default path lives under /tmp, a world-writable directory: refuse a
+    // symlink, then verify the file is a regular file we own before mapping
+    // (and possibly ftruncate-ing) it.
+    p->shm_fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (p->shm_fd < 0) {
+        if (!p->shm_warned)
+            MP_ERR(f, "dlssnr: cannot open %s: %s (NR stays off)\n",
+                   path, strerror(errno));
+        p->shm_warned = true;
+        return false;
+    }
+
+    size_t total = shm_total();
+    struct stat st;
+    if (fstat(p->shm_fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+        st.st_uid != getuid()) {
+        MP_ERR(f, "dlssnr: %s is not a regular file owned by uid %u "
+                  "(NR stays off)\n", path, (unsigned)getuid());
+        close(p->shm_fd);
+        p->shm_fd = -1;
+        return false;
+    }
+    if ((size_t)st.st_size < total) {
+        if (ftruncate(p->shm_fd, (off_t)total) != 0) {
+            MP_ERR(f, "dlssnr: ftruncate(%s) failed: %s\n", path, strerror(errno));
+            close(p->shm_fd);
+            p->shm_fd = -1;
+            return false;
+        }
+    }
+
+    void *m = mmap(NULL, total, PROT_READ | PROT_WRITE, MAP_SHARED, p->shm_fd, 0);
+    if (m == MAP_FAILED) {
+        MP_ERR(f, "dlssnr: mmap(%s) failed: %s\n", path, strerror(errno));
+        close(p->shm_fd);
+        p->shm_fd = -1;
+        return false;
+    }
+
+    p->shm = m;
+    p->shm_bytes = total;
+
+    uint32_t magic = shm_get(m, SHM_MAGIC);
+    uint32_t version = shm_get(m, SHM_VERSION);
+    if (magic != DLSSNR_SHM_MAGIC) {
+        // Fresh mapping: nobody has initialised the header. We only need the
+        // fields we write ourselves; the helper fills in the rest when it
+        // attaches. Stamp the magic last so a helper starting concurrently
+        // does not see half an init.
+        memset(m, 0, DLSSNR_SHM_HEADER);
+        shm_put(m, SHM_VERSION, DLSSNR_SHM_VERSION);
+        __atomic_store_n((uint32_t *)((char *)m + SHM_MAGIC),
+                         DLSSNR_SHM_MAGIC, __ATOMIC_RELEASE);
+        MP_INFO(f, "dlssnr: initialised %s\n", path);
+    } else if (version != DLSSNR_SHM_VERSION) {
+        MP_ERR(f, "dlssnr: %s speaks protocol %u, this build needs %u "
+                  "(helper and player are out of step)\n",
+               path, (unsigned)version, (unsigned)DLSSNR_SHM_VERSION);
+        shm_close(p);
+        return false;
+    }
+
+    MP_VERBOSE(f, "dlssnr: shared memory %s (%zu bytes)\n", path, total);
+
+    // Adopt the sequence the helper is already at. A stale seq_resp from an
+    // earlier session (a game, a previous mpv, the control tool) would
+    // otherwise satisfy our first wait immediately and we would copy an
+    // answer that was never addressed to us.
+    uint32_t req = shm_get(m, SHM_SEQ_REQ);
+    uint32_t resp = shm_get(m, SHM_SEQ_RESP);
+    p->shm_seq = req > resp ? req : resp;
+
+    return true;
+}
+
+static void shm_write_config(struct priv *p, uint32_t hash)
+{
+    void *h = p->shm;
+    const struct dlssnr_pass *b = &p->pass[0];
+
+    shm_put(h, SHM_ENABLED, 1);
+    shm_put(h, SHM_PASSES, (uint32_t)p->opts->passes);
+    shm_put(h, SHM_PRESET, b->preset);
+    shm_put(h, SHM_STYLE, b->style);
+    shm_put(h, SHM_AUTOMASK, b->automask);
+    shm_put(h, SHM_INTENSITY, f2b(b->intensity));
+    shm_put(h, SHM_LOCALTONE, f2b(b->localtone));
+    shm_put(h, SHM_LOCALSTRUCTURE, f2b(b->localstructure));
+    shm_put(h, SHM_SKINSTRUCTURE, f2b(b->skin));
+    shm_put(h, SHM_SHARPNESS, f2b(b->sharpness));
+
+    for (int i = 0; i < DLSSNR_MAX_PASSES; i++) {
+        size_t o = SHM_PASS + (size_t)i * SHM_PASS_STRIDE;
+        const struct dlssnr_pass *ps = &p->pass[i];
+        shm_put(h, o + SHM_PASS_MASK, ps->mask);
+        if (!ps->mask)
+            continue;
+        shm_put(h, o + SHM_PASS_INTENSITY, f2b(ps->intensity));
+        shm_put(h, o + SHM_PASS_LOCALTONE, f2b(ps->localtone));
+        shm_put(h, o + SHM_PASS_LOCALSTRUCTURE, f2b(ps->localstructure));
+        shm_put(h, o + SHM_PASS_SKINSTRUCTURE, f2b(ps->skin));
+        shm_put(h, o + SHM_PASS_SHARPNESS, f2b(ps->sharpness));
+        shm_put(h, o + SHM_PASS_STYLE, ps->style);
+        shm_put(h, o + SHM_PASS_PRESET, ps->preset);
+        shm_put(h, o + SHM_PASS_AUTOMASK, ps->automask);
+    }
+
+    // The model has no float16 path: every frame crosses as 8-bit RGBA in a
+    // display-referred encode. Saying so up front stops the helper from
+    // building surfaces it would only have to tear down.
+    shm_put(h, SHM_HDR_MODE, 1);       // kHdrOff
+    shm_put(h, SHM_HDR_ACTIVE, 0);
+    shm_put(h, SHM_PROXY_FORMAT, 1);   // kProxyRgba8
+    shm_put(h, SHM_HDR_ENCODE, 0);
+    shm_put(h, SHM_FORMAT, 1);
+    // Two passes with 8-bit ping-pong images round all three channels
+    // independently between passes, and the next pass reads that hue error as
+    // detail and enhances it: flat areas tint and speckle while brightness
+    // stays put (the helper's own note on sdr16Multipass). Sixteen-bit UNORM
+    // intermediates keep the transport at 8 bits and quantise once, at the
+    // end. NeuralScreen ships the same switch in its GUI.
+    shm_put(h, SHM_SDR16_MULTIPASS,
+            (uint32_t)(p->opts->sdr16 < 0 ? p->opts->passes >= 2
+                                          : p->opts->sdr16 != 0));
+
+    shm_put(h, SHM_MVEC_ENABLED, (uint32_t)(p->opts->mvec != 0));
+    shm_put(h, SHM_MVEC_SCALE_MODE, 1);   // kMVecPixels, the header's default
+    shm_put(h, SHM_MVEC_QUALITY, (uint32_t)p->opts->mvec_quality);
+
+    p->cfg_hash = hash;
+    p->cfg_written = true;
+}
+
+static void helper_spawn(struct mp_filter *f, struct priv *p)
+{
+    if (p->helper_spawned || !p->opts->spawn)
+        return;
+    p->helper_spawned = true;
+
+    const char *env = getenv("DLSSNR_HELPER");
+    const char *home = getenv("HOME");
+    char path[1024];
+    if (env && *env) {
+        snprintf(path, sizeof(path), "%s", env);
+    } else if (home && *home) {
+        snprintf(path, sizeof(path), "%s/.local/bin/dlssnr-helper", home);
+    } else {
+        return;
+    }
+
+    // posix_spawn, not system(): system() waits for the shell, and
+    // "<helper> start" launches a Python helper plus a Proton container,
+    // which can take seconds. Waiting there blocks filter creation and the
+    // first frame. Fire and forget -- liveness is reported through
+    // SHM_HELPER_STATE, and the filter fails open if the helper never comes
+    // up (see shm_roundtrip and the fail path in f_process).
+    posix_spawn_file_actions_t fa;
+    posix_spawn_file_actions_init(&fa);
+    posix_spawn_file_actions_addopen(&fa, STDOUT_FILENO, "/dev/null",
+                                     O_WRONLY, 0);
+    posix_spawn_file_actions_addopen(&fa, STDERR_FILENO, "/dev/null",
+                                     O_WRONLY, 0);
+    char *argv[] = {path, "start", NULL};
+    pid_t pid = 0;
+    int rc = posix_spawn(&pid, path, &fa, NULL, argv, environ);
+    posix_spawn_file_actions_destroy(&fa);
+
+    if (rc != 0) {
+        MP_WARN(f, "dlssnr: cannot start %s: %s (NR will stay off until a "
+                   "helper is running)\n", path, strerror(rc));
+        return;
+    }
+    MP_INFO(f, "dlssnr: helper start launched (pid %d)\n", (int)pid);
+}
+
+// ── CUDA context ──────────────────────────────────────────────────────────
+
+static bool ensure_cuda(struct mp_filter *f, struct priv *p, struct mp_image *mpi)
+{
+    CUcontext borrow = mp_cuda_ctx_from_mpi(mpi);
+
+    if (p->cuda_ref && p->cuda_ref->ctx == borrow)
+        return true;
+
+    if (!borrow) {
+        if (!p->passthrough_warned_sw) {
+            MP_ERR(f, "dlssnr: input is not a CUDA frame; the chain needs a "
+                      "hardware decoder (or hwup before this filter)\n");
+            p->passthrough_warned_sw = true;
+        }
+        return false;
+    }
+
+    CUresult cr = cuInit(0);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "dlssnr: cuInit failed (%d)\n", cr);
+        return false;
+    }
+
+    // Rebinding: everything this filter allocated lives on the old context
+    // and is invalid on the new one. Tear it all down inside the old context
+    // (context switches mid-playback are real: soft→hard decode, or a hwdec
+    // reinit after a seek), then rebuild lazily.
+    if (p->cuda_ref) {
+        CUcontext old = p->cuda_ref->ctx;
+        if (old)
+            cuCtxPushCurrent(old);
+        if (p->proc_ready) {
+            dlssnr_proc_uninit(&p->proc);
+            p->proc_ready = false;
+        }
+        if (p->yuv_conv_ready) {
+            yuv_to_rgba_destroy(&p->yuv_conv);
+            p->yuv_conv_ready = false;
+        }
+        if (p->yuv_rgb) {
+            cuMemFree(p->yuv_rgb);
+            p->yuv_rgb = 0;
+            p->yuv_rgb_cap = 0;
+        }
+        if (p->cuda_init_done && p->cuda_stream) {
+            cuStreamDestroy(p->cuda_stream);
+            p->cuda_stream = NULL;
+            p->cuda_init_done = false;
+        }
+        if (old)
+            cuCtxPopCurrent(NULL);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        MP_VERBOSE(f, "dlssnr: CUDA context changed -- everything reset\n");
+    }
+
+    struct mp_cuda_ctx_ref *shared = mp_cuda_ctx_ref_from_mpi(mpi);
+    if (shared) {
+        mp_cuda_ctx_ref_acquire(shared);
+        p->cuda_ref = shared;
+    } else {
+        p->cuda_ref = calloc(1, sizeof(*p->cuda_ref));
+        if (!p->cuda_ref)
+            return false;
+        p->cuda_ref->magic = MP_CUDA_CTX_REF_MAGIC;
+        p->cuda_ref->ctx = borrow;
+        p->cuda_ref->owned = false;
+        p->cuda_ref->ctx_holder = av_buffer_ref(mpi->hwctx);
+        if (!p->cuda_ref->ctx_holder) {
+            free(p->cuda_ref);
+            p->cuda_ref = NULL;
+            return false;
+        }
+        atomic_init(&p->cuda_ref->refs, 1);
+    }
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    // A blocking stream, like every other filter here: the kernels must order
+    // against the hwdec's work on the same context, and a non-blocking stream
+    // has no implicit ordering with the legacy default stream.
+    CUresult scr = cuStreamCreate(&p->cuda_stream, CU_STREAM_DEFAULT);
+    cuCtxPopCurrent(NULL);
+    if (scr != CUDA_SUCCESS) {
+        MP_ERR(f, "dlssnr: cuStreamCreate failed (%d)\n", scr);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        return false;
+    }
+
+    p->cuda_init_done = true;
+    return true;
+}
+
+// ── Output frames ─────────────────────────────────────────────────────────
+
+static bool ensure_av_hw_frames(struct mp_filter *f, struct priv *p, int w, int h)
+{
+    if (!p->cuda_init_done)
+        return false;
+    // sw_format is always RGBA: FFmpeg's CUDA hwframes has no x2rgb10. Both
+    // are 4 bytes per pixel with the same stride semantics, and the real
+    // format travels in the frame's hw_subfmt (see vf_vsr.c).
+    return mp_cuda_ensure_frames(f->log, p->cuda_ref->ctx, AV_PIX_FMT_RGBA,
+                                 w, h, &p->av_hw_device, &p->av_hw_frames,
+                                 &p->av_hw_frames_ctx);
+}
+
+static void free_cuda_buf(void *opaque, uint8_t *data)
+{
+    struct mp_cuda_ctx_ref *r = opaque;
+    if (r && r->ctx)
+        cuCtxPushCurrent(r->ctx);
+    cuMemFree((CUdeviceptr)data);
+    if (r && r->ctx)
+        cuCtxPopCurrent(NULL);
+    if (r)
+        mp_cuda_ctx_ref_release(r);
+}
+
+static void mp_image_dtor(void *ptr)
+{
+    struct mp_image *mpi = ptr;
+    for (int n = 0; n < MP_MAX_PLANES; n++)
+        av_buffer_unref(&mpi->bufs[n]);
+    av_buffer_unref(&mpi->hwctx);
+    av_buffer_unref(&mpi->icc_profile);
+    av_buffer_unref(&mpi->a53_cc);
+    av_buffer_unref(&mpi->dovi);
+    av_buffer_unref(&mpi->film_grain);
+    for (int n = 0; n < mpi->num_ff_side_data; n++)
+        av_buffer_unref(&mpi->ff_side_data[n].buf);
+    av_free(mpi->ff_side_data);
+}
+
+// ── YUV → RGB (only when NR is first in the chain, e.g. the DoVi path) ────
+
+static bool ensure_yuv_conv(struct mp_filter *f, struct priv *p,
+                            int bit_depth, int out_bits,
+                            enum yuv_matrix matrix, enum yuv_range range)
+{
+    // The cache key must include the *input* depth: P010 and P016 both count
+    // as "10-bit" for out_bits purposes but unpack differently, so a format
+    // switch that keeps in_bits would reuse the wrong kernel.
+    if (p->yuv_conv_ready && p->yuv_conv_bits == out_bits &&
+        p->yuv_conv_in_bits == bit_depth &&
+        p->yuv_conv_matrix == matrix && p->yuv_conv_range == range)
+        return true;
+
+    if (p->yuv_conv_ready)
+        yuv_to_rgba_destroy(&p->yuv_conv);
+
+    if (!yuv_to_rgba_init(&p->yuv_conv, bit_depth, matrix, range, out_bits)) {
+        MP_ERR(f, "dlssnr: yuv_to_rgba_init failed (bd=%d out=%d)\n",
+               bit_depth, out_bits);
+        p->yuv_conv_ready = false;
+        return false;
+    }
+
+    MP_VERBOSE(f, "dlssnr: yuv->rgb bd=%d out=%d matrix=%d range=%d\n",
+               bit_depth, out_bits, (int)matrix, (int)range);
+    p->yuv_conv_bits = out_bits;
+    p->yuv_conv_in_bits = bit_depth;
+    p->yuv_conv_matrix = matrix;
+    p->yuv_conv_range = range;
+    p->yuv_conv_ready = true;
+    return true;
+}
+
+static bool ensure_yuv_buf(struct mp_filter *f, struct priv *p, int w, int h)
+{
+    int pitch = w * 4;
+    size_t need = (size_t)pitch * h;
+    if (p->yuv_rgb && p->yuv_rgb_cap >= need && p->yuv_rgb_pitch == pitch)
+        return true;
+    if (p->yuv_rgb) {
+        cuMemFree(p->yuv_rgb);
+        p->yuv_rgb = 0;
+        p->yuv_rgb_cap = 0;
+    }
+    if (cuMemAlloc(&p->yuv_rgb, need) != CUDA_SUCCESS) {
+        MP_ERR(f, "dlssnr: cuMemAlloc(yuv->rgb %zu) failed\n", need);
+        return false;
+    }
+    p->yuv_rgb_cap = need;
+    p->yuv_rgb_pitch = pitch;
+    return true;
+}
+
+// ── Colour: transfer and Dolby Vision ─────────────────────────────────────
+
+static int trc_from_params(struct mp_image_params *params)
+{
+    switch (params->color.transfer) {
+    case PL_COLOR_TRC_PQ:            return DLSSNR_TRC_PQ;
+    case PL_COLOR_TRC_HLG:           return DLSSNR_TRC_HLG;
+    case PL_COLOR_TRC_LINEAR:        return DLSSNR_TRC_SDR;  // approximated
+    default:                         return DLSSNR_TRC_SDR;
+    }
+}
+
+// ── Geometry ──────────────────────────────────────────────────────────────
+
+static void resolve_target(struct mp_filter *f, struct priv *p, int iw, int ih,
+                           int *tw, int *th)
+{
+    if (p->opts->size == SIZE_NATIVE) {
+        *tw = iw;
+        *th = ih;
+        return;
+    }
+
+    struct mp_stream_info *info = mp_filter_find_stream_info(f);
+    if (info && info->get_render_target_size) {
+        int res[2] = {0, 0};
+        info->get_render_target_size(info, res);
+        // Latch the largest target seen: fullscreen playback reports the
+        // panel, a window reports itself, and we do not want the model's
+        // raster to follow every window resize.
+        if (res[0] > p->panel_w)
+            p->panel_w = res[0];
+        if (res[1] > p->panel_h)
+            p->panel_h = res[1];
+    }
+
+    if (p->panel_w <= 0 || p->panel_h <= 0) {
+        *tw = iw;
+        *th = ih;
+        return;
+    }
+
+    float sx = (float)p->panel_w / iw;
+    float sy = (float)p->panel_h / ih;
+    float s = sx < sy ? sx : sy;
+    if (s > 1.0f)
+        s = 1.0f;                        // never upscale: that is vsr's job
+    int w = (int)(iw * s + 0.5f) & ~1;
+    int h = (int)(ih * s + 0.5f) & ~1;
+    *tw = w < 64 ? 64 : w;
+    *th = h < 64 ? 64 : h;
+}
+
+static void resolve_work(struct priv *p, int tw, int th, int *ww, int *wh)
+{
+    float s = clampf(p->opts->work_scale, 0.25f, 1.0f);
+    int w = (int)(tw * s + 0.5f) & ~1;
+    int h = (int)(th * s + 0.5f) & ~1;
+    if (w < 256) w = tw < 256 ? tw : 256;
+    if (h < 256) h = th < 256 ? th : 256;
+    if (w > tw) w = tw;
+    if (h > th) h = th;
+    *ww = w & ~1;
+    *wh = h & ~1;
+}
+
+// ── Shared-memory round trip ──────────────────────────────────────────────
+
+static bool shm_roundtrip(struct mp_filter *f, struct priv *p,
+                          int w, int h, double timeout_ms)
+{
+    void *base = p->shm;
+    uint8_t *in = (uint8_t *)base + DLSSNR_SHM_HEADER;
+    uint8_t *out = in + DLSSNR_SHM_MAX_FRAME;
+
+    // The helper is gone: nothing will ever answer, and the wait below is a
+    // spin on a shared counter. Stay inert instead of stalling every frame.
+    if (p->helper_dead)
+        return false;
+
+    shm_put(base, SHM_WIDTH, (uint32_t)w);
+    shm_put(base, SHM_HEIGHT, (uint32_t)h);
+
+    // Proxy out of the device buffer and into the transport, then announce.
+    CUDA_MEMCPY2D cp = {0};
+    cp.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+    cp.srcDevice = (CUdeviceptr)dlssnr_proc_proxy_ptr(&p->proc);
+    cp.srcPitch = (size_t)w * 4;
+    cp.dstMemoryType = CU_MEMORYTYPE_HOST;
+    cp.dstHost = in;
+    cp.dstPitch = (size_t)w * 4;
+    cp.WidthInBytes = (size_t)w * 4;
+    cp.Height = (size_t)h;
+    if (cuMemcpy2D(&cp) != CUDA_SUCCESS) {
+        MP_ERR(f, "dlssnr: proxy download failed\n");
+        return false;
+    }
+
+    uint32_t req = ++p->shm_seq;
+    // Release: everything written above is visible before the number that
+    // announces it (the helper's acquire pairs with this).
+    __atomic_store_n((uint32_t *)((char *)base + SHM_SEQ_REQ), req,
+                     __ATOMIC_RELEASE);
+
+    double deadline = now_ms() + timeout_ms;
+    double last_check = now_ms();
+    uint32_t resp = 0;
+    for (;;) {
+        resp = __atomic_load_n((uint32_t *)((char *)base + SHM_SEQ_RESP),
+                               __ATOMIC_ACQUIRE);
+        if ((int32_t)(resp - req) >= 0)
+            break;
+        double now = now_ms();
+        if (now >= deadline)
+            return false;
+        // Once this file has failed at least one frame, the helper state
+        // field is trustworthy evidence: if it does not say "running", no
+        // answer is coming and there is no point burning the whole timeout
+        // (4 s by default) on this frame. A helper that is merely slow still
+        // reports running, so it is unaffected.
+        if (p->fail_count > 0 && now - last_check >= 100.0) {
+            last_check = now;
+            if (shm_get(base, SHM_HELPER_STATE) != HELPER_RUNNING)
+                return false;
+        }
+        struct timespec ts = {0, 200000};    // 200 us
+        nanosleep(&ts, NULL);
+    }
+
+    if (shm_get(base, SHM_ANSWERED_W) != (uint32_t)w ||
+        shm_get(base, SHM_ANSWERED_H) != (uint32_t)h) {
+        // Another swapchain's answer, or a stale one from before a resize.
+        return false;
+    }
+    if (shm_get(base, SHM_SEQ_OK) != req)
+        return false;             // the model could not take this frame
+
+    cp.srcMemoryType = CU_MEMORYTYPE_HOST;
+    cp.srcHost = out;
+    cp.srcPitch = (size_t)w * 4;
+    cp.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+    cp.dstDevice = (CUdeviceptr)dlssnr_proc_ans_ptr(&p->proc);
+    cp.dstPitch = (size_t)w * 4;
+    cp.WidthInBytes = (size_t)w * 4;
+    cp.Height = (size_t)h;
+    if (cuMemcpy2D(&cp) != CUDA_SUCCESS) {
+        MP_ERR(f, "dlssnr: answer upload failed\n");
+        return false;
+    }
+    return true;
+}
+
+// ── f_process ─────────────────────────────────────────────────────────────
+
+static void status_update(struct mp_filter *f, struct priv *p, double cost_ms)
+{
+    p->status_cost_ms += cost_ms;
+    p->status_frames++;
+    if (p->status_frames < 30)
+        return;
+    double el = p->status_t0 > 0 ? (now_ms() - p->status_t0) / 1000.0 : 0.0;
+    if (el > 0) {
+        mp_msg(f->log, MSGL_STATUS,
+               "dlssnr-status: passes=%d work=%dx%d cost=%.1fms fps=%.0f fails=%lld\n",
+               p->opts->passes, p->work_w, p->work_h,
+               p->status_cost_ms / p->status_frames,
+               p->status_frames / el, (long long)p->fail_count);
+    }
+    p->status_t0 = now_ms();
+    p->status_frames = 0;
+    p->status_cost_ms = 0;
+}
+
+// ── Debug dump (DLSSNR_DUMP=<dir> [DLSSNR_DUMP_FRAME=n]) ─────────────────
+//
+// One frame, every intermediate raster, as raw files named by stage: the
+// geometries differ (source, anchor, work), and so do the pixel layouts, so
+// the name says which stage it is and the reader is expected to know:
+//
+//   srcY/srcUV   decoder planes exactly as the hwdec hands them over
+//   yuvrgb       packed RGB10 from yuv_to_rgba (R in bits 0-9)
+//   lin_*        float32 RGBA, linear light, A=1
+//   proxy        RGBA8, the exact bytes the model sees
+//   answer       RGBA8, the exact bytes the model returned
+//   delta/dup    float32 RGB, proxy units (delta_up is at target size)
+//   out          packed RGB10, the composite that goes to the VO
+//
+// Everything is written with tight rows (rowbytes = w * bpp), so the raw
+// files are trivially reshaped and need no pitch bookkeeping on the reader
+// side. They are scratch: the filter never reads them back.
+
+static void dump_host_rows(const char *dir, const char *name, int w, int h,
+                           const void *data, size_t pitch, size_t rowbytes)
+{
+    if (!data || !dir)
+        return;
+    char path[512];
+    snprintf(path, sizeof(path), "%s/%s-%dx%d.raw", dir, name, w, h);
+    FILE *fp = fopen(path, "wb");
+    if (!fp) {
+        fprintf(stderr, "dlssnr: dump %s: %s\n", path, strerror(errno));
+        return;
+    }
+    const uint8_t *row = data;
+    for (int y = 0; y < h; y++)
+        fwrite(row + (size_t)y * pitch, 1, rowbytes, fp);
+    fclose(fp);
+    fprintf(stderr, "dlssnr: dumped %s\n", path);
+}
+
+static void dump_dev_rows(const char *dir, const char *name, int w, int h,
+                          CUdeviceptr dev, size_t pitch, size_t rowbytes)
+{
+    if (!dev || !dir)
+        return;
+    uint8_t *host = malloc(pitch * (size_t)h);
+    if (!host)
+        return;
+    if (cuMemcpyDtoH(host, dev, pitch * (size_t)h) == CUDA_SUCCESS)
+        dump_host_rows(dir, name, w, h, host, pitch, rowbytes);
+    free(host);
+}
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_NONE)
+        return;
+
+    if (mp_frame_is_signaling(frame)) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (frame.type != MP_FRAME_VIDEO) {
+        MP_ERR(f, "dlssnr: non-video frame received\n");
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    struct mp_image *mpi = frame.data;
+    bool was_dovi = mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION;
+
+    // passes=0 is the off switch; it must be a true passthrough (no CUDA
+    // work at all), so it is checked before anything is initialised.
+    if (p->opts->passes <= 0) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // The helper stopped answering (see the fail path below): run as a plain
+    // passthrough for the rest of the file rather than stalling each frame.
+    if (p->helper_dead) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // Profile 5 is IPT, not YCbCr. Pass it through untouched rather than
+    // mis-decoding it; one warning, then silence.
+    if (mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION &&
+        p->opts->dovi == DOVI_SKIP) {
+        if (!p->dovi_warned) {
+            MP_INFO(f, "dlssnr: Dolby Vision input -- passing it through "
+                       "untouched (dovi=skip keeps the RPU and FEL intact)\n");
+            p->dovi_warned = true;
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (mpi->imgfmt != IMGFMT_CUDA) {
+        if (!p->passthrough_warned_sw) {
+            MP_ERR(f, "dlssnr: only CUDA frames are supported; put hwup before "
+                      "this filter (frame passed through)\n");
+            p->passthrough_warned_sw = true;
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    double t0 = now_ms();
+
+    if (!p->dump_init) {
+        const char *d = getenv("DLSSNR_DUMP");
+        if (d && *d) {
+            snprintf(p->dump_dir, sizeof(p->dump_dir), "%s", d);
+            const char *fn = getenv("DLSSNR_DUMP_FRAME");
+            p->dump_at = fn ? atoi(fn) : 40;
+            MP_WARN(f, "dlssnr: dumping frame %d to %s\n",
+                    p->dump_at, p->dump_dir);
+        }
+        p->dump_init = true;
+    }
+    bool dumping = p->dump_dir[0] && !p->dump_done &&
+                   p->frame_count >= p->dump_at;
+
+    p->frame_count++;
+
+    if (!ensure_cuda(f, p, mpi)) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    if (!p->cuda_init_done) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (!p->proc_ready) {
+        if (!dlssnr_proc_init(&p->proc)) {
+            MP_ERR(f, "dlssnr: kernel compilation failed (NR disabled)\n");
+            p->opts->passes = 0;
+            cuCtxPopCurrent(NULL);
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+        p->proc_ready = true;
+    }
+
+    if (!shm_open_map(f, p)) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    uint32_t hash = cfg_hash_of(p->opts);
+    if (!p->cfg_written || hash != p->cfg_hash) {
+        resolve_config(p->opts, p->pass);
+        shm_write_config(p, hash);
+    }
+
+    // ── Source pointer ───────────────────────────────────────────────────
+    int src_w = mpi->w, src_h = mpi->h;
+    const void *src_ptr = NULL;
+    int src_pitch = 0;
+    int in_bits = 8;
+
+    bool src_is_rgb = vfx_imgfmt_is_rgb(mpi->params.hw_subfmt);
+    if (src_is_rgb) {
+        src_ptr = mpi->planes[0];
+        src_pitch = mpi->stride[0];
+        in_bits = vfx_bits_from_imgfmt(mpi->params.hw_subfmt);
+    } else {
+        // Packed YUV straight from the decoder: NR is first in the chain.
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(mpi->params.hw_subfmt);
+        int bd = desc.bpp[0];
+        in_bits = bd > 8 ? 10 : 8;
+        enum yuv_matrix mx = matrix_from_repr(&mpi->params);
+        enum yuv_range rn = range_from_levels(mpi->params.repr.levels);
+        if (mpi->num_planes < 2 || !mpi->planes[0] || !mpi->planes[1]) {
+            MP_ERR(f, "dlssnr: unexpected planar layout (fmt=%d)\n",
+                   mpi->params.hw_subfmt);
+            cuCtxPopCurrent(NULL);
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+        if (!ensure_yuv_conv(f, p, bd, in_bits, mx, rn) ||
+            !ensure_yuv_buf(f, p, src_w, src_h)) {
+            cuCtxPopCurrent(NULL);
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+        if (!yuv_to_rgba_convert(&p->yuv_conv,
+                                 mpi->planes[0], mpi->stride[0],
+                                 mpi->planes[1], mpi->stride[1],
+                                 src_w, src_h,
+                                 (void *)p->yuv_rgb, p->yuv_rgb_pitch,
+                                 p->cuda_stream)) {
+            MP_ERR(f, "dlssnr: yuv->rgb failed\n");
+            cuCtxPopCurrent(NULL);
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+        src_ptr = (const void *)p->yuv_rgb;
+        src_pitch = p->yuv_rgb_pitch;
+    }
+
+    // ── Geometry ─────────────────────────────────────────────────────────
+    int tgt_w, tgt_h, work_w, work_h;
+    resolve_target(f, p, src_w, src_h, &tgt_w, &tgt_h);
+    resolve_work(p, tgt_w, tgt_h, &work_w, &work_h);
+
+    p->src_w = src_w; p->src_h = src_h;
+    p->tgt_w = tgt_w; p->tgt_h = tgt_h;
+    p->work_w = work_w; p->work_h = work_h;
+    p->bits = in_bits;
+
+    if (!dlssnr_proc_reserve(&p->proc, src_w, src_h, tgt_w, tgt_h,
+                             work_w, work_h)) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    p->proc.trc        = trc_from_params(&mpi->params);
+    p->proc.in_bits    = in_bits;
+    p->proc.out_bits   = in_bits;
+    p->proc.white_lin  = (p->proc.trc == DLSSNR_TRC_SDR) ? 0.0f
+                                                     : p->opts->white / 10000.0f;
+    p->proc.detail     = clampf(p->opts->detail, 0.0f, 4.0f);
+    p->proc.guard      = clampf(p->opts->guard, 0.0f, 1.0f);
+    // The model invents a ~4-level pedestal where its input was black, fading
+    // to nothing by level 24 (measured on a band chart through this path).
+    // Eight levels is under the knee, so only the invented part is removed.
+    p->proc.blackgate  = clampf(p->opts->blackgate, 0.0f, 64.0f) / 255.0f;
+    p->proc.filter     = p->opts->filter;
+
+    // ── CUDA stages ──────────────────────────────────────────────────────
+    // Both resizes are unconditional: at ratio 1 the separable kernels
+    // reproduce the source exactly (Catmull-Rom is interpolating), so the
+    // 1:1 case needs no branch and no separate copy path.
+    bool ok = dlssnr_proc_lin(&p->proc, p->cuda_stream, src_ptr, src_pitch,
+                              src_w, src_h);
+    if (ok)
+        ok = dlssnr_proc_scale(&p->proc, p->cuda_stream,
+                               p->proc.lin_native, src_w, src_h,
+                               p->proc.lin_anchor, tgt_w, tgt_h);
+    if (ok)
+        ok = dlssnr_proc_scale(&p->proc, p->cuda_stream,
+                               p->proc.lin_anchor, tgt_w, tgt_h,
+                               p->proc.lin_work, work_w, work_h);
+    if (ok)
+        ok = dlssnr_proc_proxy(&p->proc, p->cuda_stream, p->proc.lin_work,
+                               work_w, work_h);
+    if (ok) {
+        // Everything above is asynchronous; the transfer needs the proxy
+        // resident.
+        ok = cuStreamSynchronize(p->cuda_stream) == CUDA_SUCCESS;
+        if (!ok)
+            MP_ERR(f, "dlssnr: stream sync failed\n");
+    }
+
+    if (ok && dumping) {
+        // The decoder's planes are still owned by mpi here, so this is the
+        // input side of the chain end to end: plane, RGB, linear, proxy.
+        if (!src_is_rgb && mpi->planes[0] && mpi->planes[1]) {
+            dump_dev_rows(p->dump_dir, "srcY", src_w, src_h,
+                          (CUdeviceptr)mpi->planes[0], mpi->stride[0],
+                          (size_t)src_w * 2);
+            dump_dev_rows(p->dump_dir, "srcUV", src_w / 2, src_h / 2,
+                          (CUdeviceptr)mpi->planes[1], mpi->stride[1],
+                          (size_t)(src_w / 2) * 2);
+            dump_dev_rows(p->dump_dir, "yuvrgb", src_w, src_h,
+                          p->yuv_rgb, p->yuv_rgb_pitch, (size_t)src_w * 4);
+        }
+        dump_dev_rows(p->dump_dir, "lin_native", src_w, src_h,
+                      p->proc.lin_native, (size_t)src_w * 16,
+                      (size_t)src_w * 16);
+        dump_dev_rows(p->dump_dir, "lin_anchor", tgt_w, tgt_h,
+                      p->proc.lin_anchor, (size_t)tgt_w * 16,
+                      (size_t)tgt_w * 16);
+        dump_dev_rows(p->dump_dir, "lin_work", work_w, work_h,
+                      p->proc.lin_work, (size_t)work_w * 16,
+                      (size_t)work_w * 16);
+        dump_dev_rows(p->dump_dir, "proxy", work_w, work_h,
+                      p->proc.proxy, (size_t)work_w * 4, (size_t)work_w * 4);
+    }
+
+    if (ok)
+        ok = shm_roundtrip(f, p, work_w, work_h,
+                           p->opts->timeout > 0 ? p->opts->timeout : 4000.0);
+
+    if (ok && dumping) {
+        uint8_t *ans = (uint8_t *)p->shm + DLSSNR_SHM_HEADER +
+                       DLSSNR_SHM_MAX_FRAME;
+        dump_host_rows(p->dump_dir, "answer", work_w, work_h, ans,
+                       (size_t)work_w * 4, (size_t)work_w * 4);
+    }
+
+    if (ok)
+        ok = dlssnr_proc_delta(&p->proc, p->cuda_stream, work_w, work_h);
+    if (ok)
+        ok = dlssnr_proc_delta_up(&p->proc, p->cuda_stream,
+                                  work_w, work_h, tgt_w, tgt_h);
+    // Composite domain. The model only ever sees an sRGB proxy, so its
+    // difference is taken between the decoded proxies and applied in linear
+    // light, lifted by the same per-pixel divisor the proxy used. That is
+    // NeuralScreen's HDR composite verbatim; with den == 1 it is also its SDR
+    // path, because the frame's own linear value is ToLinear(proxy). Zero
+    // delta therefore reproduces the anchor exactly in every transfer, and a
+    // five-level black offset stays a five-level offset instead of becoming
+    // five nits.
+    if (ok)
+        ok = dlssnr_proc_composite(&p->proc, p->cuda_stream,
+                                   p->proc.lin_anchor, tgt_w, tgt_h);
+
+    if (!ok) {
+        p->fail_count++;
+        if (p->fail_count == 1 || p->opts->verbose)
+            MP_WARN(f, "dlssnr: frame %lld not denoised (falling back to the "
+                       "source frame)\n", (long long)p->frame_count);
+        if (p->fail_count >= 3 && !p->helper_dead) {
+            p->helper_dead = true;
+            MP_ERR(f, "dlssnr: %lld failed frames in a row -- NR disabled for "
+                      "this file. Start the helper again (dlssnr-helper "
+                      "start) and seek or reopen to retry.\n",
+                   (long long)p->fail_count);
+        }
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (cuStreamSynchronize(p->cuda_stream) != CUDA_SUCCESS) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // The latch is documented as "3 failed frames in a row", so a frame that
+    // came back from the engine has to clear the streak. Without this a
+    // handful of unrelated transient failures spread over a long file would
+    // disable NR permanently.
+    p->fail_count = 0;
+
+    if (dumping) {
+        dump_dev_rows(p->dump_dir, "delta", work_w, work_h,
+                      p->proc.delta, (size_t)work_w * 16,
+                      (size_t)work_w * 16);
+        dump_dev_rows(p->dump_dir, "dup", tgt_w, tgt_h,
+                      p->proc.delta_up, (size_t)tgt_w * 16,
+                      (size_t)tgt_w * 16);
+        dump_dev_rows(p->dump_dir, "out", tgt_w, tgt_h,
+                      p->proc.out, (size_t)tgt_w * 4, (size_t)tgt_w * 4);
+        p->dump_done = true;
+    }
+
+    // ── Output ───────────────────────────────────────────────────────────
+    if (!ensure_av_hw_frames(f, p, tgt_w, tgt_h)) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    CUdeviceptr dev = dlssnr_proc_take_out(&p->proc);
+    if (!dev) {
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    mp_cuda_ctx_ref_acquire(p->cuda_ref);
+    struct mp_image *out = talloc_zero(NULL, struct mp_image);
+    talloc_set_destructor(out, mp_image_dtor);
+    out->bufs[0] = av_buffer_create((uint8_t *)dev, (int)((size_t)tgt_w * 4 * tgt_h),
+                                    free_cuda_buf, p->cuda_ref, 0);
+    if (!out->bufs[0]) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        talloc_free(out);
+        cuMemFree(dev);
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    mp_image_setfmt(out, IMGFMT_CUDA);
+    mp_image_sethwfmt(out, IMGFMT_CUDA, vfx_imgfmt_from_bits(in_bits));
+    out->params.w = tgt_w;
+    out->params.h = tgt_h;
+    mp_image_params_guess_csp(&out->params);
+    out->params.color = mpi->params.color;      // keep PQ/HLG and primaries
+    // The frame is now full-range RGB. Dropping the DoVi tag is deliberate:
+    // the values no longer live in the YCbCr+reshape domain the tag describes.
+    out->params.repr.sys = PL_COLOR_SYSTEM_RGB;
+    out->params.repr.levels = PL_COLOR_LEVELS_FULL;
+    out->params.repr.alpha = PL_ALPHA_NONE;
+    out->params.repr.dovi = NULL;
+    memset(&out->params.repr.bits, 0, sizeof(out->params.repr.bits));
+    if (was_dovi) {
+        // P7 FEL: el_pair runs *after* the user chain (it is a post filter),
+        // so without these two flags it would attach the enhancement layer to
+        // this frame and stamp a DoVi tag back on -- onto RGB values that were
+        // resampled to panel size and are no longer in the reshape domain.
+        // libplacebo would then apply the RPU to them. Mark the frame BL-only
+        // instead: el_pair drops the EL (no_enhancement_layer) and leaves the
+        // tags alone (no_dovi). FEL detail is the price of NR + rescaling.
+        out->params.no_dovi = true;
+        out->params.no_enhancement_layer = true;
+        if (!p->fel_warned) {
+            MP_INFO(f, "dlssnr: Dolby Vision base layer only -- NR rescales "
+                       "the frame out of the DoVi domain, so the FEL "
+                       "enhancement layer cannot be combined. Use dovi=skip "
+                       "to keep FEL and give up NR.");
+            p->fel_warned = true;
+        }
+    }
+    out->params.p_w = mpi->params.p_w;
+    out->params.p_h = mpi->params.p_h;
+    // Orientation/timing metadata is invariant under the rebuild.
+    out->params.rotate   = mpi->params.rotate;
+    out->params.vflip    = mpi->params.vflip;
+    out->params.stereo3d = mpi->params.stereo3d;
+    out->fields          = mpi->fields;
+    out->pkt_duration    = mpi->pkt_duration;
+    out->w = tgt_w;
+    out->h = tgt_h;
+    out->planes[0] = (uint8_t *)dev;
+    out->stride[0] = tgt_w * 4;
+    out->num_planes = 1;
+    out->hwctx = av_buffer_ref(p->av_hw_frames);
+    out->pts = mpi->pts;
+    out->dts = mpi->dts;
+    out->nominal_fps = mpi->nominal_fps;
+
+    MP_DBG(f, "dlssnr: frame %lld %dx%d -> %dx%d (work %dx%d, trc=%d, %d-bit)\n",
+           (long long)p->frame_count, src_w, src_h, tgt_w, tgt_h,
+           work_w, work_h, p->proc.trc, in_bits);
+
+    talloc_free(mpi);
+    cuCtxPopCurrent(NULL);
+
+    status_update(f, p, now_ms() - t0);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+}
+
+// ── vf-command: live tuning without rebuilding the chain ──────────────────
+
+// "vf-command dlssnr profile cinematic" is what the docs show; only the
+// numeric form used to work because the argument was parsed as a double
+// before the command name was looked at.
+static int profile_from_name(const char *s)
+{
+    static const char *const names[] = {
+        [PROFILE_FAITHFUL]  = "faithful",
+        [PROFILE_NATURAL]   = "natural",
+        [PROFILE_CINEMATIC] = "cinematic",
+        [PROFILE_EXTREME]   = "extreme",
+        [PROFILE_CUSTOM]    = "custom",
+    };
+    for (int i = 0; i < MP_ARRAY_SIZE(names); i++) {
+        if (names[i] && !strcmp(s, names[i]))
+            return i;
+    }
+    return -1;
+}
+
+static bool dlssnr_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+
+    if (!cmd->arg)
+        return false;
+
+    const char *c = cmd->cmd;
+
+    char *end = NULL;
+    double v = strtod(cmd->arg, &end);
+    if (end == cmd->arg || *end) {
+        if (!strcmp(c, "profile")) {
+            int pr = profile_from_name(cmd->arg);
+            if (pr < 0)
+                return false;
+            p->opts->profile = pr;
+            MP_INFO(f, "dlssnr: profile = %s\n", cmd->arg);
+            return true;
+        }
+        return false;
+    }
+
+    if (!strcmp(c, "passes"))
+        p->opts->passes = v < 0 ? 0 : (v > DLSSNR_MAX_PASSES ? DLSSNR_MAX_PASSES : (int)v);
+    else if (!strcmp(c, "intensity"))
+        p->opts->intensity = clampf(v, 0.0f, 1.0f);
+    else if (!strcmp(c, "localtone"))
+        p->opts->localtone = clampf(v, 0.0f, 2.0f);
+    else if (!strcmp(c, "localstructure"))
+        p->opts->localstructure = clampf(v, 0.0f, 2.0f);
+    else if (!strcmp(c, "skin"))
+        p->opts->skin = clampf(v, -1.0f, 2.5f);
+    else if (!strcmp(c, "sharpness"))
+        p->opts->sharpness = clampf(v, 0.0f, 1.0f);
+    else if (!strcmp(c, "style"))
+        p->opts->style = v < 0 ? 0 : (v > 2 ? 2 : (int)v);
+    else if (!strcmp(c, "automask"))
+        p->opts->automask = v != 0;
+    else if (!strcmp(c, "preset"))
+        p->opts->preset = v < 0 ? 0 : (int)v;
+    else if (!strcmp(c, "profile"))
+        p->opts->profile = v < 0 ? 0 : (v > PROFILE_EXTREME ? PROFILE_EXTREME : (int)v);
+    else if (!strcmp(c, "work-scale") || !strcmp(c, "work_scale"))
+        p->opts->work_scale = clampf(v, 0.25f, 1.0f);
+    else if (!strcmp(c, "detail"))
+        p->opts->detail = clampf(v, 0.0f, 4.0f);
+    else if (!strcmp(c, "guard"))
+        p->opts->guard = clampf(v, 0.0f, 1.0f);
+    else if (!strcmp(c, "blackgate"))
+        p->opts->blackgate = clampf(v, 0.0f, 64.0f);
+    else if (!strcmp(c, "sdr16"))
+        p->opts->sdr16 = v < 0 ? -1 : (v != 0);
+    else
+        return false;
+
+    MP_INFO(f, "dlssnr: %s = %g\n", c, v);
+    return true;
+}
+
+// ── Lifecycle ─────────────────────────────────────────────────────────────
+
+static void f_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    // The helper, the compiled kernels and the geometry are all per-file
+    // state; a seek must not cost a helper restart or a recompile.
+    p->frame_count = 0;
+    p->fail_count = 0;
+    p->helper_dead = false;     // a seek is the retry point for a dead helper
+    p->status_t0 = 0;
+    p->status_frames = 0;
+    p->status_cost_ms = 0;
+    MP_VERBOSE(f, "dlssnr: reset (helper and kernels kept)\n");
+}
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    bool ctx_pushed = false;
+    if (p->cuda_ref && p->cuda_ref->ctx) {
+        ctx_pushed = cuCtxPushCurrent(p->cuda_ref->ctx) == CUDA_SUCCESS;
+    }
+
+    if (p->proc_ready)
+        dlssnr_proc_uninit(&p->proc);
+
+    if (p->yuv_conv_ready) {
+        yuv_to_rgba_destroy(&p->yuv_conv);
+        p->yuv_conv_ready = false;
+    }
+    if (p->yuv_rgb) {
+        if (ctx_pushed)
+            cuMemFree(p->yuv_rgb);
+        p->yuv_rgb = 0;
+        p->yuv_rgb_cap = 0;
+    }
+
+    if (ctx_pushed)
+        cuCtxPopCurrent(NULL);
+
+    if (p->cuda_init_done && p->cuda_stream) {
+        if (ctx_pushed)
+            cuCtxPushCurrent(p->cuda_ref->ctx);
+        cuStreamDestroy(p->cuda_stream);
+        if (ctx_pushed)
+            cuCtxPopCurrent(NULL);
+        p->cuda_stream = NULL;
+        p->cuda_init_done = false;
+    }
+
+    if (p->cuda_ref) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+    }
+
+    av_buffer_unref(&p->av_hw_device);
+    av_buffer_unref(&p->av_hw_frames);
+    p->av_hw_frames_ctx = NULL;
+
+    shm_close(p);
+}
+
+static const struct mp_filter_info vf_dlssnr_filter = {
+    .name      = "dlssnr",
+    .priv_size = sizeof(struct priv),
+    .process   = f_process,
+    .reset     = f_reset,
+    .destroy   = f_destroy,
+    .command   = dlssnr_command,
+};
+
+static struct mp_filter *vf_dlssnr_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_dlssnr_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    p->shm_fd = -1;
+
+    // Resolve once so the first frame does not pay for it, and so a typo in
+    // an override string shows up as a log line rather than a silent default.
+    resolve_config(p->opts, p->pass);
+    p->cfg_hash = cfg_hash_of(p->opts);
+
+    MP_VERBOSE(f, "dlssnr: passes=%d profile=%d work_scale=%.2f size=%d\n",
+               p->opts->passes, p->opts->profile, p->opts->work_scale,
+               p->opts->size);
+
+    if (p->opts->passes > 0)
+        helper_spawn(f, p);
+
+    return f;
+}
+
+const struct mp_user_filter_entry vf_dlssnr = {
+    .desc = {
+        .name          = "dlssnr",
+        .description   = "DLSS 5 noise reduction (NGX feature 18)",
+        .priv_size     = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &vf_dlssnr_opts_def,
+        .options       = vf_opts_fields,
+    },
+    .create = vf_dlssnr_create,
+};
diff --git a/video/filter/vf_hwup.c b/video/filter/vf_hwup.c
new file mode 100644
index 000000000..688511aac
--- /dev/null
+++ b/video/filter/vf_hwup.c
@@ -0,0 +1,564 @@
+// vf_hwup.c — SW→HW unification pre-filter
+//
+// Pipeline: decode → [vf_hwup] → [vf_rife] → [vf_vsr] → VO
+//
+// SW frames (any YUV) are uploaded as CUDA frames (NV12/P010, matching bit
+// depth), so downstream rife/vsr only handle the HW path (rife/vsr no longer
+// need their own SW support).
+// HW CUDA frames (hwdec NV12/P010) pass through unchanged.
+//
+// Output frame hwctx = a self-created av_hw_frames, size = max(RT, video).
+// The RT size is not for rife (a rife output frame = video size, borrowing
+// the video-size hwctx is enough) — it is for the vsr output frame + the VO
+// download path in the SW-decode case: SW-decoded input has no hwdec → the
+// VO has no CUDA interop (hwdec_devs empty) → autoconvert inserts
+// hwdownload → av_hwframe_transfer_data resolves from hwctx by frame size,
+// hwctx < frame size (vsr output = video×scale) crashes out of range
+// (measured: mp_image_hw_download assert). The RT size is ≥ the common
+// video×scale output, so hwctx = max(RT, video) makes the download path
+// safe; when the window is smaller than the video, the video size is used
+// (frame size matches).
+//
+// CUDA context: self-created (SW input has no hwdec frame to borrow from).
+// The single-ctx design continues — downstream rife/vsr borrow this filter's
+// ctx through the frame hwctx, the whole chain shares it (multiple ctx
+// running concurrently hang the GPU, see cuda_shared.h).
+
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "video/img_format.h"
+#include "video/fmt-conversion.h"
+#include "video/mp_image.h"
+#include "video/sws_utils.h"
+#include "common/msg.h"
+#include "options/m_option.h"
+
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include <cuda.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cuda_shared.h"
+
+// ── Filter private state ───────────────────────────────────────────────────
+// CUDA context ownership: shared struct (cuda_shared.h). This filter is the
+// CREATOR for SW input (owned=true, self-created context); HW frames pass
+// through without ever touching CUDA. Output frames carry the shared struct
+// as bufs[0] opaque — the context lives as long as any frame references it,
+// so frames that outlive the filter (pin teardown after f_destroy) can still
+// release their buffer on a live context.
+
+// ── Options ────────────────────────────────────────────────────────────────
+// cuda-uuid: the CUDA device UUID to use (32 hex digits, '-' allowed).
+// At startup the client passes down the selected **Vulkan** physical device
+// UUID — zero-copy requires the CUDA context and the Vulkan device to be the
+// same card, and CUDA's index order is unrelated to Vulkan's enumeration
+// order (they diverge on multi-GPU machines and under CUDA_VISIBLE_DEVICES
+// remapping). Empty falls back to the historical cuDeviceGet(0) behaviour.
+struct vf_hwup_opts {
+    char *cuda_uuid;
+};
+
+struct priv {
+    struct vf_hwup_opts *opts;
+    struct mp_cuda_ctx_ref *cuda_ref;
+    CUstream  cuda_stream;
+    bool      cuda_init_done;
+
+    AVBufferRef *av_hw_device;   // CUDA device ctx (wraps cuda_ref->ctx)
+    AVBufferRef *av_hw_frames;   // CUDA/NV12·P010 frames ctx (max(RT, video))
+    CUcontext    av_hw_frames_ctx;  // ctx av_hw_frames was created on
+
+    CUdeviceptr out_buf;         // Y + UV two segments (single buf)
+    size_t      out_buf_size;
+};
+
+// ── AVBufferRef free callback for CUDA memory ──────────────────────────────
+
+static void mp_image_dtor(void *ptr)
+{
+    struct mp_image *mpi = ptr;
+    for (int p = 0; p < MP_MAX_PLANES; p++)
+        av_buffer_unref(&mpi->bufs[p]);
+    av_buffer_unref(&mpi->hwctx);
+    av_buffer_unref(&mpi->icc_profile);
+    av_buffer_unref(&mpi->a53_cc);
+    av_buffer_unref(&mpi->dovi);
+    av_buffer_unref(&mpi->film_grain);
+    for (int n = 0; n < mpi->num_ff_side_data; n++)
+        av_buffer_unref(&mpi->ff_side_data[n].buf);
+}
+
+static void free_cuda_buf(void *opaque, uint8_t *data)
+{
+    struct mp_cuda_ctx_ref *r = opaque;
+    if (r && r->ctx) cuCtxPushCurrent(r->ctx);
+    // No stream sync — see vf_vsr.c free_cuda_buf for the reasoning: the
+    // buffer is only freed after its consumers (rife/vsr's copies on their
+    // streams, or the VO's map copy under retained-frame semantics) are done,
+    // and a stream-0 sync on the shared context would wait on the render
+    // thread.
+    cuMemFree((CUdeviceptr)data);
+    if (r && r->ctx) cuCtxPopCurrent(NULL);
+    if (r)
+        mp_cuda_ctx_ref_release(r);
+}
+
+// ── CUDA context setup ─────────────────────────────────────────────────────
+// SW frames have no hwctx to borrow from — the filter creates its own context
+// (vf_vsr's SW-decode path was removed per contract: SW→HW happens only in
+// this node). Once created it lives for the filter's whole
+// lifetime: decode output is either all-HW or all-SW (no per-frame switching),
+// and HW frames pass through without touching CUDA at all.
+
+// "30a67003a20e3136a9b1cef1823e88b1" / "30a67003-a20e-…" → 16 bytes
+static bool parse_uuid16(const char *s, unsigned char out[16])
+{
+    if (!s) return false;
+    int n = 0, hi = -1;
+    for (; *s; s++) {
+        int c = *s;
+        if (c == '-' || c == ':') continue;
+        int v;
+        if (c >= '0' && c <= '9') v = c - '0';
+        else if (c >= 'a' && c <= 'f') v = c - 'a' + 10;
+        else if (c >= 'A' && c <= 'F') v = c - 'A' + 10;
+        else return false;
+        if (hi < 0) hi = v;
+        else {
+            if (n >= 16) return false;
+            out[n++] = (unsigned char)((hi << 4) | v);
+            hi = -1;
+        }
+    }
+    return n == 16 && hi < 0;
+}
+
+// Select the CUDA device by UUID; when unset/not found fall back to device 0
+// (keeping the old behaviour).
+static CUresult pick_cuda_device(struct mp_filter *f, struct priv *p, CUdevice *out)
+{
+    const char *want = p->opts ? p->opts->cuda_uuid : NULL;
+    unsigned char want_uuid[16];
+    if (!want || !*want || !parse_uuid16(want, want_uuid)) {
+        if (want && *want)
+            MP_WARN(f, "hwup: cannot parse cuda-uuid=\"%s\", falling back to CUDA device 0\n", want);
+        return cuDeviceGet(out, 0);
+    }
+    int count = 0;
+    if (cuDeviceGetCount(&count) == CUDA_SUCCESS) {
+        for (int i = 0; i < count; i++) {
+            CUdevice dev;
+            if (cuDeviceGet(&dev, i) != CUDA_SUCCESS)
+                continue;
+            CUuuid id;
+            if (cuDeviceGetUuid(&id, dev) != CUDA_SUCCESS)
+                continue;
+            if (memcmp(id.bytes, want_uuid, 16) == 0) {
+                const char *name = "?";
+                char buf[128] = {0};
+                if (cuDeviceGetName(buf, sizeof(buf) - 1, dev) == CUDA_SUCCESS)
+                    name = buf;
+                MP_INFO(f, "hwup: matched CUDA device by UUID: %s (index %d)\n", name, i);
+                *out = dev;
+                return CUDA_SUCCESS;
+            }
+        }
+    }
+    MP_WARN(f, "hwup: no CUDA device with UUID %s; falling back to device 0 -- "
+               "if that is a different GPU than Vulkan's, the import fails "
+               "(black picture). Pin it with "
+               "CUDA_VISIBLE_DEVICES=GPU-<uuid of the same card>\n", want);
+    return cuDeviceGet(out, 0);
+}
+
+static bool ensure_cuda(struct mp_filter *f, struct priv *p)
+{
+    if (p->cuda_ref)
+        return true;
+
+    CUresult cr = cuInit(0);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "hwup: cuInit failed (%d)\n", cr);
+        return false;
+    }
+    CUdevice dev;
+    cr = pick_cuda_device(f, p, &dev);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "hwup: cuDeviceGet failed (%d)\n", cr);
+        return false;
+    }
+    CUcontext ctx;
+    cr = cuCtxCreate(&ctx, CU_CTX_SCHED_AUTO, dev, 0);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "hwup: cuCtxCreate failed (%d)\n", cr);
+        return false;
+    }
+
+    p->cuda_ref = calloc(1, sizeof(*p->cuda_ref));
+    p->cuda_ref->magic = MP_CUDA_CTX_REF_MAGIC;
+    p->cuda_ref->ctx = ctx;
+    p->cuda_ref->owned = true;
+    atomic_init(&p->cuda_ref->refs, 1);
+
+    cuCtxPushCurrent(ctx);
+    cr = cuStreamCreate(&p->cuda_stream, CU_STREAM_NON_BLOCKING);
+    cuCtxPopCurrent(NULL);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "hwup: cuStreamCreate failed (%d)\n", cr);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        return false;
+    }
+    p->cuda_init_done = true;
+    MP_VERBOSE(f, "hwup: created CUDA context on device 0 (SW input)\n");
+    return true;
+}
+
+// ── AVHWFramesContext for the output CUDA frames ───────────────────────────
+// Upload frames carry a self-created NV12/P010 frames ctx (hwctx sw_format
+// must match the frame's subfmt — shared helper mp_cuda_ensure_frames).
+
+static bool ensure_av_hw_frames(struct mp_filter *f, struct priv *p,
+                                enum mp_imgfmt swfmt, int w, int h)
+{
+    if (!p->cuda_init_done) return false;
+    bool had = p->av_hw_frames != NULL;
+    if (!mp_cuda_ensure_frames(f->log, p->cuda_ref->ctx, imgfmt2pixfmt(swfmt),
+                               w, h, &p->av_hw_device, &p->av_hw_frames,
+                               &p->av_hw_frames_ctx))
+        return false;
+    if (!had)
+        MP_VERBOSE(f, "hwup: CUDA/%s hw_frames_ctx %dx%d\n",
+                   mp_imgfmt_to_name(swfmt), w, h);
+    return true;
+}
+
+// ── f_process ──────────────────────────────────────────────────────────────
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+
+    if (mp_frame_is_signaling(frame)) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (frame.type != MP_FRAME_VIDEO) {
+        MP_ERR(f, "hwup: non-video frame received\n");
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    struct mp_image *mpi = frame.data;
+
+    // ── HW CUDA frame: passthrough (hwdec NV12/P010, usable directly by
+    // downstream rife/vsr) ────────────────────────────────────────────────
+    if (mpi->imgfmt == IMGFMT_CUDA) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // ── SW frame: upload as a CUDA frame (NV12/P010, matching bit depth) ──
+    if (!ensure_cuda(f, p)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(mpi->imgfmt);
+    int bd = desc.bpp[0];
+    // mpv has no P016: 16bit+ input is truncated to P010 (upper 10 bits kept,
+    // handled by sws)
+    enum mp_imgfmt fmt = bd <= 8 ? IMGFMT_NV12 : IMGFMT_P010;
+    int bpp = bd <= 8 ? 1 : 2;
+
+    // RT size (obtained the same way as vf_vsr resolve_scale: libmpv
+    // non-blocking read cache, 0 when the VO has not rendered yet). hwctx
+    // size = max(RT, video) — see the file header comment: it serves the vsr
+    // output frame + the VO's hwdownload path in the SW-decode case
+    int hw_w = mpi->w, hw_h = mpi->h;
+    struct mp_stream_info *info = mp_filter_find_stream_info(f);
+    if (info && info->get_render_target_size) {
+        int res[2] = {0};
+        info->get_render_target_size(info, res);
+        if (res[0] > hw_w) hw_w = res[0];
+        if (res[1] > hw_h) hw_h = res[1];
+    }
+
+    if (!ensure_av_hw_frames(f, p, fmt, hw_w, hw_h)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    // sws: any YUV → NV12/P010 (CPU). Range is not converted (sws keeps the
+    // source levels by default) — the output frame explicitly carries the
+    // source repr out, downstream yuv_to_rgba converts correctly by levels
+    // (losing the levels tag once caused the VO to flicker on alternating
+    // frames)
+    struct mp_image *nv12 = mp_image_alloc(fmt, mpi->w, mpi->h);
+    if (!nv12) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    mp_image_copy_attributes(nv12, mpi);
+    struct mp_sws_context *sws = mp_sws_alloc(f);
+    if (!sws) {
+        talloc_free(nv12);
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    sws->force_scaler = MP_SWS_AUTO;
+    if (mp_sws_scale(sws, nv12, mpi) < 0) {
+        MP_ERR(f, "hwup: sws_scale failed\n");
+        talloc_free(sws);
+        talloc_free(nv12);
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    talloc_free(sws);
+
+    // Output buffer: Y + UV two segments (single buf, same layout as an hwdec
+    // NV12 frame)
+    size_t y_bytes  = (size_t)mpi->w * mpi->h * bpp;
+    // NV12 chroma is ceil(h/2) rows; the floor left the last row of an
+    // odd-height source uninitialized in a buffer the VO then maps.
+    size_t uv_bytes = (size_t)mpi->w * ((mpi->h + 1) / 2) * bpp;
+    int pitch_y  = mpi->w * bpp;
+    int pitch_uv = mpi->w * bpp;
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    CUresult cr = cuMemAlloc(&p->out_buf, y_bytes + uv_bytes);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "hwup: cuMemAlloc failed (%d)\n", cr);
+        cuCtxPopCurrent(NULL);
+        talloc_free(nv12);
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    p->out_buf_size = y_bytes + uv_bytes;
+
+    {
+        CUDA_MEMCPY2D copy = {0};
+        copy.srcMemoryType = CU_MEMORYTYPE_HOST;
+        copy.srcHost       = nv12->planes[0];
+        copy.srcPitch      = (size_t)nv12->stride[0];
+        copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.dstDevice     = p->out_buf;
+        copy.dstPitch      = (size_t)pitch_y;
+        copy.WidthInBytes  = (size_t)mpi->w * bpp;
+        copy.Height        = (size_t)mpi->h;
+        cr = cuMemcpy2DAsync(&copy, p->cuda_stream);
+        if (cr != CUDA_SUCCESS) {
+            MP_ERR(f, "hwup: Y upload failed (%d)\n", cr);
+            cuMemFree(p->out_buf); p->out_buf = 0; p->out_buf_size = 0;
+            cuCtxPopCurrent(NULL);
+            talloc_free(nv12);
+            mp_frame_unref(&frame);
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+        copy.srcHost  = nv12->planes[1];
+        copy.srcPitch = (size_t)nv12->stride[1];
+        copy.dstDevice = p->out_buf + y_bytes;
+        copy.dstPitch = (size_t)pitch_uv;
+        copy.WidthInBytes = (size_t)mpi->w * bpp;
+        copy.Height       = (size_t)(mpi->h + 1) / 2;
+        cr = cuMemcpy2DAsync(&copy, p->cuda_stream);
+        if (cr != CUDA_SUCCESS) {
+            MP_ERR(f, "hwup: UV upload failed (%d)\n", cr);
+            cuMemFree(p->out_buf); p->out_buf = 0; p->out_buf_size = 0;
+            cuCtxPopCurrent(NULL);
+            talloc_free(nv12);
+            mp_frame_unref(&frame);
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+        // Hand the frame over only after the upload completes: downstream
+        // (rife/vsr) reads this frame on its own stream, and there is no
+        // implicit synchronisation between streams (same as the vsr SW path)
+        cuStreamSynchronize(p->cuda_stream);
+    }
+    talloc_free(nv12);
+
+    // ── output frame ──────────────────────────────────────────────────────
+    // One cuMemAlloc per frame, freed with the frame (free_cuda_buf) — the
+    // same pattern as vf_vsr. The frame holds a reference to the shared
+    // cuda_ref (bufs[0] opaque) and may outlive the filter — the ctx lives
+    // until the last frame (downstream borrowers reference the same struct).
+    mp_cuda_ctx_ref_acquire(p->cuda_ref);
+    struct mp_image *out = talloc_zero(NULL, struct mp_image);
+    talloc_set_destructor(out, mp_image_dtor);
+    out->bufs[0] = av_buffer_create((uint8_t *)p->out_buf, (int)p->out_buf_size,
+                                    free_cuda_buf, p->cuda_ref, 0);
+    if (!out->bufs[0]) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        talloc_free(out);
+        cuMemFree(p->out_buf); p->out_buf = 0; p->out_buf_size = 0;
+        cuCtxPopCurrent(NULL);
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    mp_image_setfmt(out, IMGFMT_CUDA);
+    mp_image_sethwfmt(out, IMGFMT_CUDA, fmt);
+    mp_image_params_guess_csp(&out->params);
+    out->params.color = mpi->params.color;   // HDR metadata preserved
+    out->params.repr  = mpi->params.repr;    // source levels preserved — NV12
+                                             // range was not converted,
+                                             // downstream converts by levels
+    // repr.dovi points *into* mpi->dovi (it is set from the AVFrame side data
+    // in mp_image.c), so the struct copy above leaves the output borrowing
+    // another frame's RPU. Ref it and repoint at our own buffer: libplacebo
+    // dereferences repr.dovi unconditionally for PL_COLOR_SYSTEM_DOLBYVISION
+    // (libplacebo colorspace.c, pl_color_repr_decode).
+    out->dovi = av_buffer_ref(mpi->dovi);
+    if (mpi->dovi && !out->dovi) {
+        // talloc_free runs mp_image_dtor, which unrefs bufs[0] and frees
+        // p->out_buf through free_cuda_buf.
+        talloc_free(out);
+        p->out_buf = 0; p->out_buf_size = 0;
+        cuCtxPopCurrent(NULL);
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    out->params.repr.dovi = out->dovi ? (void *)out->dovi->data : NULL;
+    out->params.p_w = mpi->params.p_w;
+    out->params.p_h = mpi->params.p_h;
+    // Orientation and timing metadata survive a rebuild unchanged; dropping
+    // them made rotated sources render unrotated (vo_gpu_next reads
+    // params.rotate per frame) and zeroed the frame duration.
+    out->params.rotate   = mpi->params.rotate;
+    out->params.vflip    = mpi->params.vflip;
+    out->params.stereo3d = mpi->params.stereo3d;
+    out->fields          = mpi->fields;
+    out->pkt_duration    = mpi->pkt_duration;
+    out->w = mpi->w; out->h = mpi->h;
+    out->params.w = mpi->w; out->params.h = mpi->h;
+    out->planes[0] = (uint8_t *)p->out_buf;
+    out->planes[1] = (uint8_t *)p->out_buf + y_bytes;
+    out->stride[0] = pitch_y;
+    out->stride[1] = pitch_uv;
+    out->num_planes = 2;
+    out->hwctx = av_buffer_ref(p->av_hw_frames);
+    out->pts = mpi->pts;
+    out->dts = mpi->dts;
+    out->nominal_fps = mpi->nominal_fps;
+    p->out_buf = 0; p->out_buf_size = 0;
+    cuCtxPopCurrent(NULL);
+
+    MP_DBG(f, "hwup: %s %dx%d -> CUDA/%s\n",
+           mp_imgfmt_to_name(mpi->imgfmt), mpi->w, mpi->h,
+           mp_imgfmt_to_name(fmt));
+
+    talloc_free(mpi);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+}
+
+// ── f_destroy ──────────────────────────────────────────────────────────────
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    bool ctx_pushed = false;
+    if (p->cuda_ref && p->cuda_ref->ctx) {
+        CUresult cr = cuCtxPushCurrent(p->cuda_ref->ctx);
+        ctx_pushed = (cr == CUDA_SUCCESS);
+    }
+
+    if (p->out_buf) {
+        if (ctx_pushed) cuMemFree(p->out_buf);
+        p->out_buf      = 0;
+        p->out_buf_size = 0;
+    }
+    if (p->cuda_init_done) {
+        if (ctx_pushed) cuStreamDestroy(p->cuda_stream);
+        p->cuda_stream = NULL;
+    }
+    if (ctx_pushed)
+        cuCtxPopCurrent(NULL);
+
+    // The frames/device carrier release must happen with nothing pushed: its
+    // uninit may cuCtxDestroy (FFmpeg's self-created ctx / hwdec carrier).
+    // In current_ctx mode the borrowed ctx is not destroyed here — that is
+    // managed by the shared struct's refs.
+    if (p->av_hw_frames) {
+        av_buffer_unref(&p->av_hw_frames);
+        p->av_hw_frames = NULL;
+    }
+    if (p->av_hw_device) {
+        av_buffer_unref(&p->av_hw_device);
+        p->av_hw_device = NULL;
+    }
+
+    // Release the filter's context reference. Frames still in flight
+    // (pin teardown happens after destroy()) hold their own references;
+    // the context is destroyed only when the last one is released.
+    if (p->cuda_ref) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+    }
+    p->cuda_init_done = false;
+}
+
+// ── Registration ───────────────────────────────────────────────────────────
+
+static const struct mp_filter_info vf_hwup_filter = {
+    .name      = "hwup",
+    .priv_size = sizeof(struct priv),
+    .process   = f_process,
+    .destroy   = f_destroy,
+};
+
+static struct mp_filter *vf_hwup_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_hwup_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    return f;
+}
+
+#undef OPT_BASE_STRUCT
+#define OPT_BASE_STRUCT struct vf_hwup_opts
+
+static const struct m_option vf_hwup_fields[] = {
+    {"cuda-uuid", OPT_STRING(cuda_uuid)},
+    {0}
+};
+
+const struct mp_user_filter_entry vf_hwup = {
+    .desc = {
+        .name        = "hwup",
+        .description = "SW→HW unification (upload SW YUV as CUDA frames, pre rife/vsr)",
+        .priv_size     = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &(const struct vf_hwup_opts){0},
+        .options     = vf_hwup_fields,
+    },
+    .create = vf_hwup_create,
+};
diff --git a/video/filter/vf_truehdr.c b/video/filter/vf_truehdr.c
new file mode 100644
index 000000000..85d691f3c
--- /dev/null
+++ b/video/filter/vf_truehdr.c
@@ -0,0 +1,1046 @@
+// src/mpv/video/filter/vf_truehdr.c
+// VFX TrueHDR (SDR → HDR10 up-conversion) — the VFX SDK's AI up-conversion
+// effect, attached **after** `vf_vsr` (approach in
+// docs/vfx-truehdr-investigation.md §8).
+//
+// Contract (everything is backed by measurement; volume numbers refer to that
+// document):
+//  Input: CUDA frame, chunky RGB — RGBA8 (8-bit path) or X2BGR10 (the
+//    **SDR** source of a 10-bit container, first landed as RGBA8 via
+//    NvCVImage_Transfer); YUV (NV12/P010, upstream is the raw decoded frame
+//    when VSR passes through) is converted to RGBA8 by the shared yuv_to_rgba
+//    kernel. TrueHDR requires an SDR encoding (Rec.709/D65/≈gamma2.2, full
+//    range).
+//  Output: CUDA frame + hw_subfmt=X2BGR10 (VFX RGB10A2 = mpv
+//    IMGFMT_X2BGR10), colour parameters set to **BT.2020 / PQ** — downstream
+//    is all the existing 10-bit path (vfx_bits_from_imgfmt =10, VFG does D2D,
+//    the VO handles it as HDR).
+//  HDR content passthrough: self-guarded by the **frame's transfer** (PQ/HLG),
+//   not relying on a client switch (single source of truth; the client switch
+//   only decides "whether to up-convert").
+//  DebangingOff is always 0 (debanding permanently on, constant cost, benefit
+//   is conditional — AGENTS working rule 6).
+//
+// Engine lifecycle follows vf_vsr.c: lazy init, and on a CUDA context change
+// destroy the engine/converter/stream/buffers **inside the old context** (see
+// the chain of traps under AGENTS "switching hwdec while running").
+// **A parameter change does not rebuild the engine**: SetU32 takes effect
+// after Load and is bit-identical to a rebuild (measurement in the
+// engine_params_apply comment) — so dragging a UI slider can just send a
+// vf-command.
+
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+#include "video/csputils.h"
+#include "options/m_option.h"
+#include "common/msg.h"
+#include "common/common.h"
+
+#include <cuda.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <math.h>
+#include <time.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "vfx_loader.h"
+#include "cuda_shared.h"
+#include "yuv_to_rgba.h"
+
+static double truehdr_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+// ── Options ────────────────────────────────────────────────────────────────
+// The filter chain always has `enable=0` (off by default): the actual state is
+// sent down by the client per its HDR policy via vf-command (opt-in env
+// `VSR_UPHDR=on`), see docs/vfx-truehdr-investigation.md §8.2/8.4.
+
+struct vf_truehdr_opts {
+    bool enable;        // false = passthrough (default); true = up-convert (HDR content still self-guards to passthrough)
+    int luminance;      // target display peak nit (SDK parameter, 400–2000; client sets the panel's physical peak)
+    int saturation;     // 100 = SDK default
+    int contrast;       // 100 = SDK default
+    int middle_gray;    // 50  = SDK default (range 10–100, see the parameter doc string in the library)
+    bool debanding_off; // false = debanding **on** (default/recommended; true for diagnostics only)
+};
+
+#define OPT_BASE_STRUCT struct vf_truehdr_opts
+
+static const struct m_option vf_opts_fields[] = {
+    {"enable",        OPT_BOOL(enable)},
+    {"luminance",     OPT_INT(luminance), M_RANGE(400, 2000)},
+    {"saturation",    OPT_INT(saturation), M_RANGE(0, 200)},
+    {"contrast",      OPT_INT(contrast), M_RANGE(0, 200)},
+    {"middle-gray",   OPT_INT(middle_gray), M_RANGE(10, 100)},
+    {"debanding-off", OPT_BOOL(debanding_off)},
+    {0}
+};
+
+static const struct vf_truehdr_opts vf_truehdr_opts_def = {
+    .enable        = false,
+    .luminance     = 650,
+    .saturation    = 100,
+    .contrast      = 100,
+    .middle_gray   = 50,
+    .debanding_off = false,
+};
+
+// ── Filter private state ───────────────────────────────────────────────────
+
+struct priv {
+    struct vf_truehdr_opts *opts;
+
+    struct mp_cuda_ctx_ref *cuda_ref;
+    CUstream  cuda_stream;
+    bool      cuda_init_done;
+
+    // ── TrueHDR engine (NvVFX effect + two GPU images) ─────────────────
+    void      *effect;
+    NvCVImage  in_img;        // RGBA8 (engine input, we own it)
+    NvCVImage  in10_img;      // RGB10A2 (staging for the 10-bit SDR source, lazy)
+    NvCVImage  out_img;       // RGB10A2 (engine output, we own it)
+    bool       imgs_alloc;    // in_img/out_img allocated
+    bool       in10_alloc;
+    int        eng_w, eng_h;
+    bool       loaded;
+    // engine parameter snapshot (any change rebuilds; do not assume SetU32
+    // takes effect after Load)
+    int        e_luminance, e_saturation, e_contrast, e_middle_gray, e_debanding_off;
+    bool       failed;        // create/Load failed → permanent passthrough (no per-frame retry)
+    bool       failed_warned;
+
+    // ── YUV → RGBA8 (shared kernel; upstream is the raw decoded frame when
+    // VSR passes through or is off) ──────────────────────────────────────
+    struct yuv_to_rgba yuv_conv;
+    bool                yuv_conv_ready;
+    int                 yuv_conv_bd;
+    enum yuv_matrix     yuv_conv_matrix;
+    enum yuv_range      yuv_conv_range;
+
+    // ── output buffer (ownership handed over frame by frame) ───────────
+    AVBufferRef *av_hw_device;
+    AVBufferRef *av_hw_frames;
+    CUcontext    av_hw_frames_ctx;
+    CUdeviceptr  out_buf;
+    size_t       out_buf_size;
+    int          out_pitch;
+
+    int  video_w, video_h;
+
+    bool sw_warned;      // software frame (no hwup in the chain) passthrough warns only once
+    bool hdr_warned;     // HDR content passthrough log printed only once
+    bool fmt_warned;     // unsupported input format warning only once
+    bool fmt_logged;     // format log of the first up-conversion
+    int  frame_count;
+
+    // truehdr-status (every 30 frames)
+    double status_t0;
+    int    status_frames;
+    double status_cost_ms;
+    int    status_emit;
+    double last_peak_nit, last_med_nit;
+};
+
+// ── CUDA context binding (trimmed isomorphic copy of vf_vsr.c ensure_cuda) ─
+
+static bool ensure_cuda(struct mp_filter *f, struct priv *p,
+                        struct mp_image *mpi)
+{
+    CUcontext borrow = mp_cuda_ctx_from_mpi(mpi);   // NULL = SW frame
+
+    if (p->cuda_ref) {
+        if (p->cuda_ref->ctx == borrow)
+            return true;
+    }
+
+    if (cuInit(0) != CUDA_SUCCESS) {
+        MP_ERR(f, "truehdr: cuInit failed\n");
+        return false;
+    }
+
+    // ⚠ All CUDA resources are bound to the context that created them: reusing
+    // old handles after a context change (switching software/hardware decode,
+    // or the upstream swapping contexts) makes cuLaunchKernel/CUDA API return
+    // 400 → the filter gets disabled by mpv (measured, same in vf_vsr.c).
+    // Everything must be invalidated **inside the old context**.
+    if (p->cuda_ref) {
+        CUcontext old = p->cuda_ref->ctx;
+        if (old) cuCtxPushCurrent(old);
+        if (p->loaded || p->effect) {
+            if (p->effect) pfn_NvVFX_DestroyEffect(p->effect);
+            p->effect = NULL;
+            p->loaded = false;
+        }
+        if (p->imgs_alloc) {
+            pfn_NvCVImage_Dealloc(&p->in_img);
+            pfn_NvCVImage_Dealloc(&p->out_img);
+            p->imgs_alloc = false;
+        }
+        if (p->in10_alloc) {
+            pfn_NvCVImage_Dealloc(&p->in10_img);
+            p->in10_alloc = false;
+        }
+        if (p->yuv_conv_ready) {
+            yuv_to_rgba_destroy(&p->yuv_conv);
+            p->yuv_conv_ready = false;
+        }
+        if (p->out_buf) {
+            cuMemFree(p->out_buf);
+            p->out_buf = 0;
+            p->out_buf_size = 0;
+        }
+        if (p->cuda_init_done && p->cuda_stream) {
+            cuStreamDestroy(p->cuda_stream);
+            p->cuda_stream = NULL;
+            p->cuda_init_done = false;
+        }
+        if (old) cuCtxPopCurrent(NULL);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        p->failed = false;       // a context change is a fresh rebuild chance (the failure may be related)
+        p->fmt_logged = false;
+        MP_VERBOSE(f, "truehdr: CUDA context changed — engine reset\n");
+    }
+
+    struct mp_cuda_ctx_ref *shared = mp_cuda_ctx_ref_from_mpi(mpi);
+    if (shared) {
+        mp_cuda_ctx_ref_acquire(shared);
+        p->cuda_ref = shared;
+    } else if (borrow) {
+        p->cuda_ref = calloc(1, sizeof(*p->cuda_ref));
+        p->cuda_ref->magic = MP_CUDA_CTX_REF_MAGIC;
+        p->cuda_ref->ctx = borrow;
+        p->cuda_ref->owned = false;
+        p->cuda_ref->ctx_holder = av_buffer_ref(mpi->hwctx);
+        if (!p->cuda_ref->ctx_holder) {
+            MP_ERR(f, "truehdr: failed to hold hwdec frame ref\n");
+            free(p->cuda_ref);
+            p->cuda_ref = NULL;
+            return false;
+        }
+        atomic_init(&p->cuda_ref->refs, 1);
+    } else {
+        MP_ERR(f, "truehdr: no CUDA context from input (software frame past passthrough)\n");
+        return false;
+    }
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    // It must be a **blocking stream** (VFX 1.3 internally has a stage
+    // permanently attached to the legacy default stream; a non-blocking stream
+    // has no implicit ordering with the legacy stream → it reads input that
+    // has not landed; same in vf_vsr.c).
+    CUresult cr = cuStreamCreate(&p->cuda_stream, CU_STREAM_DEFAULT);
+    cuCtxPopCurrent(NULL);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "truehdr: cuStreamCreate failed (%d)\n", cr);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        return false;
+    }
+
+    p->cuda_init_done = true;
+    return true;
+}
+
+// ── YUV→RGBA8 converter lifecycle (shared yuv_to_rgba kernel) ──────────────
+
+static bool ensure_yuv_converter(struct mp_filter *f, struct priv *p,
+                                 int bit_depth, enum yuv_matrix matrix,
+                                 enum yuv_range range)
+{
+    if (p->yuv_conv_ready && p->yuv_conv_bd == bit_depth &&
+        p->yuv_conv_matrix == matrix && p->yuv_conv_range == range)
+        return true;
+
+    if (p->yuv_conv_ready)
+        yuv_to_rgba_destroy(&p->yuv_conv);
+
+    // TrueHDR input must be 8-bit SDR (RGBA8) → out_bits is always VFX_BITS_8.
+    if (!yuv_to_rgba_init(&p->yuv_conv, bit_depth, matrix, range, VFX_BITS_8)) {
+        MP_ERR(f, "truehdr: yuv_to_rgba_init failed (bd=%d)\n", bit_depth);
+        p->yuv_conv_ready = false;
+        return false;
+    }
+    p->yuv_conv_bd = bit_depth;
+    p->yuv_conv_matrix = matrix;
+    p->yuv_conv_range = range;
+    p->yuv_conv_ready = true;
+    return true;
+}
+
+// ── engine (NvVFX effect "TrueHDR") lifecycle ─────────────────────────────
+// A parameter change **goes through a SetU32 hot update** (measured to take
+// effect after Load, bit-identical to a rebuild; see engine_params_apply
+// below); only a size change / DebandingOff / a SetU32 failure rebuilds.
+
+static void engine_destroy(struct priv *p)
+{
+    if (p->effect)
+        pfn_NvVFX_DestroyEffect(p->effect);
+    p->effect = NULL;
+    p->loaded = false;
+    if (p->imgs_alloc) {
+        pfn_NvCVImage_Dealloc(&p->in_img);
+        pfn_NvCVImage_Dealloc(&p->out_img);
+        p->imgs_alloc = false;
+    }
+    // The 10-bit staging image must be invalidated too: it was allocated for
+    // the frame size **at that time**, and reusing it after a size change
+    // (switching files) makes the D2D copy go out of range (the engine is
+    // rebuilt at the new size, the staging image is still the old one).
+    if (p->in10_alloc) {
+        pfn_NvCVImage_Dealloc(&p->in10_img);
+        p->in10_alloc = false;
+    }
+}
+
+static bool engine_create(struct mp_filter *f, struct priv *p, int w, int h)
+{
+    struct vf_truehdr_opts *o = p->opts;
+
+    engine_destroy(p);
+
+    int ra = pfn_NvCVImage_Alloc(&p->in_img, w, h, NVCV_RGBA, NVCV_U8,
+                                 NVCV_CHUNKY, NVCV_GPU, 32);
+    int rb = pfn_NvCVImage_Alloc(&p->out_img, w, h, NVCV_RGB10A2, NVCV_P32,
+                                 NVCV_CHUNKY, NVCV_GPU, 32);
+    if (ra != 0 || rb != 0) {
+        MP_ERR(f, "truehdr: NvCVImage_Alloc failed (%d/%d) %dx%d\n", ra, rb, w, h);
+        if (ra == 0) pfn_NvCVImage_Dealloc(&p->in_img);
+        if (rb == 0) pfn_NvCVImage_Dealloc(&p->out_img);
+        return false;
+    }
+    p->imgs_alloc = true;
+
+    int cr = pfn_NvVFX_CreateEffect("TrueHDR", &p->effect);
+    if (cr != 0 || !p->effect) {
+        MP_ERR(f, "truehdr: NvVFX_CreateEffect(TrueHDR) failed (%d)\n", cr);
+        engine_destroy(p);
+        return false;
+    }
+
+    pfn_NvVFX_SetU32(p->effect, "Contrast",     (unsigned)o->contrast);
+    pfn_NvVFX_SetU32(p->effect, "Saturation",   (unsigned)o->saturation);
+    pfn_NvVFX_SetU32(p->effect, "MiddleGray",   (unsigned)o->middle_gray);
+    pfn_NvVFX_SetU32(p->effect, "Luminance",    (unsigned)o->luminance);
+    // Debanding is **permanently on** (0 = on): constant cost (measured
+    // 1.6–4.3×, independent of content), conditional benefit (only shots with
+    // banding gain) — do not assume a picture "has no banding" (rule 6).
+    pfn_NvVFX_SetU32(p->effect, "DebandingOff", (unsigned)o->debanding_off);
+    pfn_NvVFX_SetImage(p->effect, "SrcImage0", &p->in_img);
+    pfn_NvVFX_SetImage(p->effect, "DstImage0", &p->out_img);
+    pfn_NvVFX_SetCudaStream(p->effect, "CudaStream", p->cuda_stream);
+
+    double t0 = truehdr_now_ms();
+    int lr = pfn_NvVFX_Load(p->effect);
+    if (lr != 0) {
+        MP_ERR(f, "truehdr: NvVFX_Load failed (%d) -- upconversion unavailable, passthrough\n", lr);
+        engine_destroy(p);
+        return false;
+    }
+    MP_INFO(f, "truehdr: engine ready %dx%d (Load %.0f ms) luminance=%d "
+            "contrast=%d saturation=%d middle-gray=%d debanding=%s\n",
+            w, h, truehdr_now_ms() - t0, o->luminance, o->contrast, o->saturation,
+            o->middle_gray, o->debanding_off ? "OFF(diagnostic)" : "on");
+
+    p->loaded = true;
+    p->eng_w = w;
+    p->eng_h = h;
+    p->e_luminance = o->luminance;
+    p->e_saturation = o->saturation;
+    p->e_contrast = o->contrast;
+    p->e_middle_gray = o->middle_gray;
+    p->e_debanding_off = o->debanding_off;
+    return true;
+}
+
+/// **Lightweight parameter update**: after Load, `NvVFX_SetU32` takes effect
+/// for TrueHDR and is **bit-identical** to the output of "Load again with the
+/// same parameters". Measured (`build/scratch/truehdr_setu32.c`, 1920x1080
+/// synthetic image, same engine only SetU32 then re-run):
+///   Saturation 100→200 : sampled chroma 0.1627 → 0.2377
+///   MiddleGray 50→80   : sampled mean 24.1 → 38.7 nit
+///   Luminance 400→1000 : greyscale ramp mean 74.6 → 88.0 nit
+///   control (destroy+create+Load with same parameters) = 0.2537 / 38.7 nit
+///   — **identical to the SetU32 path**
+/// So UI parameter dragging (a few times a second after throttling) needs no
+/// engine rebuild: SetU32 suffices, zero stutter.
+/// ⚠ `DebandingOff` was **not tested** (it changes the pass graph, "skip
+/// DL-Debander" is most likely decided at Load time) → a change to that
+/// parameter always returns false and takes the rebuild path (no
+/// assumptions).
+static bool engine_params_apply(struct mp_filter *f, struct priv *p)
+{
+    const struct vf_truehdr_opts *o = p->opts;
+    if (p->e_debanding_off != o->debanding_off) {
+        MP_INFO(f, "truehdr: debanding %d -> %d (rebuilding engine; this parameter is Load-time)\n",
+                p->e_debanding_off, o->debanding_off);
+        return false;
+    }
+    if (p->e_luminance == o->luminance && p->e_saturation == o->saturation &&
+        p->e_contrast == o->contrast && p->e_middle_gray == o->middle_gray)
+        return true;   // no change
+
+    bool ok = true;
+    if (p->e_contrast != o->contrast)
+        ok &= pfn_NvVFX_SetU32(p->effect, "Contrast", (unsigned)o->contrast) == 0;
+    if (p->e_saturation != o->saturation)
+        ok &= pfn_NvVFX_SetU32(p->effect, "Saturation", (unsigned)o->saturation) == 0;
+    if (p->e_middle_gray != o->middle_gray)
+        ok &= pfn_NvVFX_SetU32(p->effect, "MiddleGray", (unsigned)o->middle_gray) == 0;
+    if (p->e_luminance != o->luminance)
+        ok &= pfn_NvVFX_SetU32(p->effect, "Luminance", (unsigned)o->luminance) == 0;
+    if (!ok) {
+        MP_WARN(f, "truehdr: SetU32 failed -> falling back to engine rebuild\n");
+        return false;
+    }
+    MP_VERBOSE(f, "truehdr: params %d/%d/%d/%d -> %d/%d/%d/%d (SetU32, no rebuild)\n",
+               p->e_contrast, p->e_saturation, p->e_middle_gray, p->e_luminance,
+               o->contrast, o->saturation, o->middle_gray, o->luminance);
+    p->e_contrast = o->contrast;
+    p->e_saturation = o->saturation;
+    p->e_middle_gray = o->middle_gray;
+    p->e_luminance = o->luminance;
+    return true;
+}
+
+// ── output buffer / frame construction (isomorphic to vf_vsr.c output
+// section) ─────────────────────────────────────────────────────────────
+
+static bool ensure_out_buf(struct mp_filter *f, struct priv *p, int pitch, int h)
+{
+    size_t needed = (size_t)pitch * h;
+    if (p->out_buf && p->out_buf_size >= needed) {
+        p->out_pitch = pitch;
+        return true;
+    }
+    if (p->out_buf) {
+        cuMemFree(p->out_buf);
+        p->out_buf = 0;
+        p->out_buf_size = 0;
+    }
+    if (cuMemAlloc(&p->out_buf, needed) != CUDA_SUCCESS) {
+        MP_ERR(f, "truehdr: cuMemAlloc(out) failed (%zu bytes)\n", needed);
+        return false;
+    }
+    p->out_buf_size = needed;
+    p->out_pitch = pitch;
+    return true;
+}
+
+static void mp_image_dtor(void *ptr)
+{
+    struct mp_image *mpi = ptr;
+    for (int p = 0; p < MP_MAX_PLANES; p++)
+        av_buffer_unref(&mpi->bufs[p]);
+    av_buffer_unref(&mpi->hwctx);
+    av_buffer_unref(&mpi->icc_profile);
+    av_buffer_unref(&mpi->a53_cc);
+    av_buffer_unref(&mpi->dovi);
+    av_buffer_unref(&mpi->film_grain);
+    for (int n = 0; n < mpi->num_ff_side_data; n++)
+        av_buffer_unref(&mpi->ff_side_data[n].buf);
+}
+
+static void free_cuda_buf(void *opaque, uint8_t *data)
+{
+    struct mp_cuda_ctx_ref *r = opaque;
+    if (r && r->ctx) cuCtxPushCurrent(r->ctx);
+    // No stream sync: the frame is only released after the consumer replaces
+    // it, and this filter's per-frame stream sync has already drained the
+    // copies; a stream 0 sync on the shared context would wait on the render
+    // thread (same reasoning as vf_vsr.c).
+    cuMemFree((CUdeviceptr)data);
+    if (r && r->ctx) cuCtxPopCurrent(NULL);
+    if (r)
+        mp_cuda_ctx_ref_release(r);
+}
+
+// The caller must have called cuCtxPushCurrent; ownership of p->out_buf is
+// transferred to the returned frame.
+static struct mp_image *make_output(struct mp_filter *f, struct priv *p,
+                                    const struct mp_image *src, int w, int h)
+{
+    if (!mp_cuda_ensure_frames(f->log, p->cuda_ref->ctx, AV_PIX_FMT_RGBA,
+                               w, h, &p->av_hw_device, &p->av_hw_frames,
+                               &p->av_hw_frames_ctx))
+        return NULL;
+
+    mp_cuda_ctx_ref_acquire(p->cuda_ref);
+    struct mp_image *out = talloc_zero(NULL, struct mp_image);
+    talloc_set_destructor(out, mp_image_dtor);
+    out->bufs[0] = av_buffer_create((uint8_t *)p->out_buf, (int)p->out_buf_size,
+                                    free_cuda_buf, p->cuda_ref, 0);
+    if (!out->bufs[0]) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        talloc_free(out);
+        return NULL;
+    }
+    mp_image_setfmt(out, IMGFMT_CUDA);
+    // Output = VFX RGB10A2 = IMGFMT_X2BGR10; sw_format is always RGBA (FFmpeg
+    // CUDA hwframes does not support x2bgr10, the 10-bit is carried by
+    // hw_subfmt — same in vf_vsr.c).
+    mp_image_sethwfmt(out, IMGFMT_CUDA, IMGFMT_X2BGR10);
+    mp_image_params_guess_csp(&out->params);
+    // Colour metadata **aligned with mpv's own NVIDIA True HDR reference
+    // implementation** (third_party/mpv/video/filter/vf_d3d11vpp.c:410): the
+    // output is tagged HDR10 (pl_color_space_hdr10 = BT.2020/PQ/light=HDR10) +
+    // an explicit content peak.
+    // On the D3D path mpv can only "guess" max_luma=1000 and warn; here we
+    // **know** the target peak (the SDK's Luminance parameter) → label it
+    // truthfully (the measure is absolute nit, same as video-params/max-luma,
+    // for downstream tone mapping to judge the content peak).
+    out->params.color = pl_color_space_hdr10;
+    out->params.color.hdr.max_luma = p->e_luminance;
+    out->params.p_w = src->params.p_w;
+    out->params.p_h = src->params.p_h;
+    // Orientation/timing metadata is invariant under the rebuild.
+    out->params.rotate   = src->params.rotate;
+    out->params.vflip    = src->params.vflip;
+    out->params.stereo3d = src->params.stereo3d;
+    out->fields          = src->fields;
+    out->pkt_duration    = src->pkt_duration;
+    out->w = w;
+    out->h = h;
+    out->params.w = w;
+    out->params.h = h;
+    out->planes[0] = (uint8_t *)p->out_buf;
+    out->stride[0] = p->out_pitch;
+    out->num_planes = 1;
+    out->hwctx = av_buffer_ref(p->av_hw_frames);
+    out->pts         = src->pts;
+    out->dts         = src->dts;
+    out->nominal_fps = src->nominal_fps;
+    p->out_buf = 0;          // ownership transferred
+    p->out_buf_size = 0;
+    return out;
+}
+
+// ── output sampling (numeric evidence for the status line: PQ code → nit) ──
+
+static double pq_code_to_nits(double c)
+{
+    const double m1 = 2610.0 / 16384.0, m2 = 2523.0 / 4096.0 * 128.0;
+    const double c1 = 3424.0 / 4096.0, c2 = 2413.0 / 4096.0 * 32.0,
+                 c3 = 2392.0 / 4096.0 * 32.0;
+    double p = pow(c, 1.0 / m2);
+    double num = p - c1;
+    if (num < 0) num = 0;
+    double den = c2 - c3 * p;
+    if (den <= 0) return 0;
+    return 10000.0 * pow(num / den, 1.0 / m1);
+}
+
+/// Sample one row from the engine output image (read back 32 points) → median
+/// / peak nit. The caller must have synced the stream.
+static void sample_output_nits(struct priv *p, double *med, double *peak)
+{
+    const int n = 32;
+    unsigned int words[32];
+    double nits[32];
+    int y = p->eng_h / 2, w = p->eng_w;
+    for (int i = 0; i < n; i++) {
+        int x = (int)((double)i / (n - 1) * (w - 1));
+        words[i] = 0;
+        if (cuMemcpyDtoH(&words[i], (CUdeviceptr)p->out_img.pixels +
+                         (size_t)y * p->out_img.pitch + (size_t)x * 4, 4)
+            != CUDA_SUCCESS)
+            words[i] = 0;
+        unsigned int wd = words[i];
+        double r = (wd & 0x3FF) / 1023.0, g = ((wd >> 10) & 0x3FF) / 1023.0,
+               b = ((wd >> 20) & 0x3FF) / 1023.0;
+        nits[i] = (pq_code_to_nits(r) + pq_code_to_nits(g) + pq_code_to_nits(b)) / 3.0;
+    }
+    for (int i = 0; i < n; i++)
+        for (int j = i + 1; j < n; j++)
+            if (nits[j] < nits[i]) { double t = nits[i]; nits[i] = nits[j]; nits[j] = t; }
+    *med = nits[n / 2];
+    *peak = nits[n - 1];
+}
+
+// ── status line (every 30 frames; single source for OSD/log, same channel as
+// vsr-status) ──────────────────────────────────────────────────────────
+
+static void emit_status(struct mp_filter *f, struct priv *p, const char *mode)
+{
+    if (++p->status_emit < 30)
+        return;
+    p->status_emit = 0;
+    double el = p->status_t0 > 0 ? (truehdr_now_ms() - p->status_t0) / 1000.0 : 0;
+    if (strcmp(mode, "active") == 0 && el > 0) {
+        mp_msg(f->log, MSGL_STATUS,
+               "truehdr-status: mode=active cost=%.1fms fps=%.0f luminance=%d "
+               "peak=%.0fnit med=%.0fnit\n",
+               p->status_cost_ms / (p->status_frames ? p->status_frames : 1),
+               p->status_frames / el, p->e_luminance, p->last_peak_nit,
+               p->last_med_nit);
+    } else {
+        mp_msg(f->log, MSGL_STATUS, "truehdr-status: mode=passthrough\n");
+    }
+    p->status_t0 = truehdr_now_ms();
+    p->status_frames = 0;
+    p->status_cost_ms = 0;
+}
+
+// ── f_process ──────────────────────────────────────────────────────────────
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+
+    if (mp_frame_is_signaling(frame)) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (frame.type != MP_FRAME_VIDEO) {
+        MP_ERR(f, "truehdr: non-video frame received\n");
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    struct mp_image *mpi = frame.data;
+    p->frame_count++;
+
+    // ── passthrough decision (per frame, not cached) ─────────────────────
+    //  ① off (default) ② engine unavailable ③ HDR content (transfer PQ/HLG —
+    //  self-guarded, not relying on a client switch) ④ non-CUDA frame
+    //  (software decode with no hwup in the chain).
+    const bool is_hw = (mpi->imgfmt == IMGFMT_CUDA);
+    // The HDR content criterion is aligned with the mpv reference
+    // implementation (want_nvidia_true_hdr in vf_d3d11vpp.c:151): up-convert
+    // only when `!pl_color_space_is_hdr(...)` (libplacebo measure: an effective
+    // signal peak above SDR reference white means HDR — covers PQ/HLG and
+    // cases carrying hdr metadata).
+    const bool content_hdr = pl_color_space_is_hdr(&mpi->params.color);
+
+    if (!is_hw) {
+        if (!p->sw_warned) {
+            MP_WARN(f, "truehdr: software frames — passthrough (prepend @hwup)\n");
+            p->sw_warned = true;
+        }
+        emit_status(f, p, "passthrough");
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (content_hdr) {
+        if (!p->hdr_warned) {
+            MP_INFO(f, "truehdr: HDR content (transfer=%d primaries=%d) -- passthrough, no upconversion\n",
+                    (int)mpi->params.color.transfer, (int)mpi->params.color.primaries);
+            p->hdr_warned = true;
+        }
+        emit_status(f, p, "passthrough");
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (!p->opts->enable || p->failed) {
+        emit_status(f, p, "passthrough");
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // Input form decision (TrueHDR only takes chunky RGBA8; see header comment).
+    const int subfmt = mpi->params.hw_subfmt;
+    const bool in_rgba8  = (subfmt == IMGFMT_RGBA);
+    const bool in_rgb10  = (subfmt == IMGFMT_X2BGR10 || subfmt == IMGFMT_X2RGB10);
+    const bool in_yuv    = !vfx_imgfmt_is_rgb(subfmt);
+    if (!in_rgba8 && !in_rgb10 && !in_yuv) {
+        if (!p->fmt_warned) {
+            MP_WARN(f, "truehdr: unsupported input subfmt=%d — passthrough\n", subfmt);
+            p->fmt_warned = true;
+        }
+        emit_status(f, p, "passthrough");
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    const int w = mpi->w, h = mpi->h;
+    p->video_w = w;
+    p->video_h = h;
+
+    if (!ensure_cuda(f, p, mpi)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+
+    double t0 = truehdr_now_ms();
+
+    // ── engine (rebuild when size/parameters mismatch; failure → permanent
+    // passthrough) ──────────────────────────────────────────────────────
+    // Size change (switching file/resolution) → must rebuild: the image
+    // buffers and tile split are bound to Load.
+    if (p->loaded && (p->eng_w != w || p->eng_h != h))
+        engine_destroy(p);
+    // Parameter change → SetU32 lightweight update (zero rebuild, see
+    // engine_params_apply); failure/size change → rebuild. Throttled UI slider
+    // dragging takes this path.
+    const bool need_rebuild = !p->loaded || !engine_params_apply(f, p);
+    if (need_rebuild) {
+        if (!engine_create(f, p, w, h)) {
+            p->failed = true;
+            if (!p->failed_warned) {
+                MP_WARN(f, "truehdr: upconversion unavailable -- passthrough (no retry)\n");
+                p->failed_warned = true;
+            }
+            cuCtxPopCurrent(NULL);
+            emit_status(f, p, "passthrough");
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+    }
+
+    if (!p->fmt_logged) {
+        p->fmt_logged = true;
+        MP_INFO(f, "truehdr: %dx%d subfmt=%d (bits=%d) → X2BGR10 HDR10 "
+                "(primaries=%d transfer=%d max_luma=%d) luminance=%d debanding=%s\n",
+                w, h, subfmt, vfx_bits_from_imgfmt(subfmt),
+                (int)pl_color_space_hdr10.primaries, (int)pl_color_space_hdr10.transfer,
+                p->e_luminance, p->e_luminance,
+                p->e_debanding_off ? "OFF(diagnostic)" : "on");
+    }
+
+    // ── input → in_img (RGBA8) ────────────────────────────────────────────
+    bool in_ok = true;
+    if (in_yuv) {
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(subfmt);
+        int bd = desc.bpp[0];
+        enum yuv_matrix mx = matrix_from_repr(&mpi->params);
+        enum yuv_range  rn = range_from_levels(mpi->params.repr.levels);
+        if (!ensure_yuv_converter(f, p, bd, mx, rn)) {
+            in_ok = false;
+        } else if (!yuv_to_rgba_convert(&p->yuv_conv,
+                                        mpi->planes[0], mpi->stride[0],
+                                        mpi->planes[1], mpi->stride[1],
+                                        w, h, p->in_img.pixels, p->in_img.pitch,
+                                        p->cuda_stream)) {
+            MP_ERR(f, "truehdr: yuv_to_rgba_convert failed\n");
+            in_ok = false;
+        }
+    } else if (in_rgba8) {
+        CUDA_MEMCPY2D copy = {0};
+        copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.srcDevice     = (CUdeviceptr)mpi->planes[0];
+        copy.srcPitch      = (size_t)mpi->stride[0];
+        copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.dstDevice     = (CUdeviceptr)p->in_img.pixels;
+        copy.dstPitch      = (size_t)p->in_img.pitch;
+        copy.WidthInBytes  = (size_t)w * 4;
+        copy.Height        = (size_t)h;
+        in_ok = (cuMemcpy2DAsync(&copy, p->cuda_stream) == CUDA_SUCCESS);
+        if (!in_ok) MP_ERR(f, "truehdr: input D2D copy failed\n");
+    } else {
+        // The **SDR** source of a 10-bit container (X2BGR10): land as RGBA8
+        // first.
+        if (!p->in10_alloc) {
+            int r = pfn_NvCVImage_Alloc(&p->in10_img, w, h, NVCV_RGB10A2,
+                                        NVCV_P32, NVCV_CHUNKY, NVCV_GPU, 32);
+            if (r != 0) {
+                MP_ERR(f, "truehdr: in10 alloc failed (%d)\n", r);
+                in_ok = false;
+            } else {
+                p->in10_alloc = true;
+            }
+        }
+        if (in_ok) {
+            CUDA_MEMCPY2D copy = {0};
+            copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+            copy.srcDevice     = (CUdeviceptr)mpi->planes[0];
+            copy.srcPitch      = (size_t)mpi->stride[0];
+            copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+            copy.dstDevice     = (CUdeviceptr)p->in10_img.pixels;
+            copy.dstPitch      = (size_t)p->in10_img.pitch;
+            copy.WidthInBytes  = (size_t)w * 4;
+            copy.Height        = (size_t)h;
+            if (cuMemcpy2DAsync(&copy, p->cuda_stream) != CUDA_SUCCESS) {
+                MP_ERR(f, "truehdr: input10 D2D copy failed\n");
+                in_ok = false;
+            } else if (pfn_NvCVImage_Transfer(&p->in10_img, &p->in_img, 1.0f,
+                                              p->cuda_stream, NULL) != 0) {
+                MP_ERR(f, "truehdr: 10-bit→8-bit transfer failed\n");
+                in_ok = false;
+            }
+        }
+    }
+
+    if (!in_ok) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        cuCtxPopCurrent(NULL);
+        return;
+    }
+
+    // ── up-conversion ───────────────────────────────────────────────────
+    if (pfn_NvVFX_Run(p->effect, 0) != 0) {
+        MP_ERR(f, "truehdr: NvVFX_Run failed -- passthrough and disabled\n");
+        p->failed = true;
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (!ensure_out_buf(f, p, p->out_img.pitch, h)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        cuCtxPopCurrent(NULL);
+        return;
+    }
+
+    {
+        CUDA_MEMCPY2D copy = {0};
+        copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.srcDevice     = (CUdeviceptr)p->out_img.pixels;
+        copy.srcPitch      = (size_t)p->out_img.pitch;
+        copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.dstDevice     = p->out_buf;
+        copy.dstPitch      = (size_t)p->out_pitch;
+        copy.WidthInBytes  = (size_t)w * 4;
+        copy.Height        = (size_t)h;
+        if (cuMemcpy2DAsync(&copy, p->cuda_stream) != CUDA_SUCCESS) {
+            MP_ERR(f, "truehdr: output D2D copy failed\n");
+            mp_frame_unref(&frame);
+            mp_filter_internal_mark_failed(f);
+            cuCtxPopCurrent(NULL);
+            return;
+        }
+        cuStreamSynchronize(p->cuda_stream);
+    }
+
+    // numeric evidence for status (read back 32 points, PQ → nit)
+    sample_output_nits(p, &p->last_med_nit, &p->last_peak_nit);
+
+    struct mp_image *out = make_output(f, p, mpi, w, h);
+    if (!out) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        cuCtxPopCurrent(NULL);
+        return;
+    }
+
+    MP_DBG(f, "truehdr: frame %d %dx%d → X2BGR10 PQ\n", p->frame_count, w, h);
+    talloc_free(mpi);
+
+    p->status_cost_ms += truehdr_now_ms() - t0;
+    p->status_frames++;
+    emit_status(f, p, "active");
+
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    cuCtxPopCurrent(NULL);
+}
+
+// ── truehdr_command ────────────────────────────────────────────────────────
+// The client sends these via `vf-command truehdr <param> <value>` (dispatch
+// name = filter name):
+//   enable 0|1|off|on     up-conversion switch (the actual value is decided by
+//                         the client's HDR policy; HDR content still
+//                         self-guards)
+//   luminance <400..2000> target display peak nit (client sets the panel's
+//                         physical peak)
+//   saturation 0..200 / contrast 0..200 / middle-gray 10..100
+//   — ranges/defaults all follow the parameter doc strings inside
+//     libnvVFXTrueHDR.so (this effect has only these 5 adjustable parameters
+//     + BatchSize(=1); there are no quality-tier/gamut/transfer knobs)
+// Parameters only change the private opts; on the next frame f_process
+// compares and takes the SetU32 hot-update path (zero rebuild).
+
+static bool parse_bool_arg(const char *arg, int *out)
+{
+    if (!arg) return false;
+    if (!strcmp(arg, "1") || !strcmp(arg, "on") || !strcmp(arg, "yes")) { *out = 1; return true; }
+    if (!strcmp(arg, "0") || !strcmp(arg, "off") || !strcmp(arg, "no")) { *out = 0; return true; }
+    return false;
+}
+
+static bool parse_int_arg(const char *arg, int lo, int hi, int *out)
+{
+    if (!arg || !*arg) return false;
+    char *end = NULL;
+    long v = strtol(arg, &end, 10);
+    if (!end || *end != '\0' || v < lo || v > hi) return false;
+    *out = (int)v;
+    return true;
+}
+
+static bool truehdr_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT || !cmd->arg)
+        return false;
+
+    struct vf_truehdr_opts *o = p->opts;
+    if (!strcmp(cmd->cmd, "enable")) {
+        int v;
+        if (!parse_bool_arg(cmd->arg, &v)) return false;
+        if (o->enable != v) {
+            MP_INFO(f, "truehdr: enable %d -> %d (vf-command)\n", o->enable, v);
+            o->enable = v;
+        }
+        return true;
+    }
+    if (!strcmp(cmd->cmd, "luminance")) {
+        int v;
+        if (!parse_int_arg(cmd->arg, 400, 2000, &v)) return false;
+        if (o->luminance != v) {
+            MP_INFO(f, "truehdr: luminance %d -> %d nit (vf-command)\n", o->luminance, v);
+            o->luminance = v;
+        }
+        return true;
+    }
+    if (!strcmp(cmd->cmd, "saturation")) {
+        int v;
+        if (!parse_int_arg(cmd->arg, 0, 200, &v)) return false;
+        if (o->saturation != v) {
+            MP_INFO(f, "truehdr: saturation %d -> %d (vf-command)\n", o->saturation, v);
+            o->saturation = v;
+        }
+        return true;
+    }
+    if (!strcmp(cmd->cmd, "contrast")) {
+        int v;
+        if (!parse_int_arg(cmd->arg, 0, 200, &v)) return false;
+        if (o->contrast != v) {
+            MP_INFO(f, "truehdr: contrast %d -> %d (vf-command)\n", o->contrast, v);
+            o->contrast = v;
+        }
+        return true;
+    }
+    if (!strcmp(cmd->cmd, "middle-gray")) {
+        int v;
+        if (!parse_int_arg(cmd->arg, 10, 100, &v)) return false;
+        if (o->middle_gray != v) {
+            MP_INFO(f, "truehdr: middle-gray %d -> %d (vf-command)\n", o->middle_gray, v);
+            o->middle_gray = v;
+        }
+        return true;
+    }
+    // debanding-off is only for diagnostic A/B (default is always 0 =
+    // debanding on, rule 6)
+    if (!strcmp(cmd->cmd, "debanding-off")) {
+        int v;
+        if (!parse_bool_arg(cmd->arg, &v)) return false;
+        if (o->debanding_off != v) {
+            MP_WARN(f, "truehdr: debanding-off %d -> %d (diagnostic only; always 0 by default)\n",
+                    o->debanding_off, v);
+            o->debanding_off = v;
+        }
+        return true;
+    }
+    return false;
+}
+
+// ── f_reset / f_destroy ────────────────────────────────────────────────────
+
+static void f_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    if (p->cuda_ref && p->cuda_ref->ctx) {
+        cuCtxPushCurrent(p->cuda_ref->ctx);
+        engine_destroy(p);
+        cuCtxPopCurrent(NULL);
+    }
+    p->frame_count = 0;
+    // A seek/reopen after a failed Load is the natural retry point (the
+    // failure is usually transient driver pressure), so do not keep the
+    // permanent-passthrough latch across it.
+    p->failed = false;
+    p->failed_warned = false;
+}
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    bool ctx_pushed = false;
+    if (p->cuda_ref && p->cuda_ref->ctx)
+        ctx_pushed = (cuCtxPushCurrent(p->cuda_ref->ctx) == CUDA_SUCCESS);
+
+    engine_destroy(p);   // includes in10_img (the 10-bit staging image)
+    if (p->yuv_conv_ready) {
+        yuv_to_rgba_destroy(&p->yuv_conv);
+        p->yuv_conv_ready = false;
+    }
+    if (p->out_buf) {
+        if (ctx_pushed) cuMemFree(p->out_buf);
+        p->out_buf = 0;
+        p->out_buf_size = 0;
+    }
+    if (p->cuda_init_done && ctx_pushed)
+        cuStreamDestroy(p->cuda_stream);
+    p->cuda_stream = NULL;
+
+    if (ctx_pushed)
+        cuCtxPopCurrent(NULL);
+
+    // The frames/device carrier release must happen with nothing pushed
+    // (uninit may cuCtxDestroy)
+    if (p->av_hw_frames) { av_buffer_unref(&p->av_hw_frames); p->av_hw_frames = NULL; }
+    if (p->av_hw_device) { av_buffer_unref(&p->av_hw_device); p->av_hw_device = NULL; }
+
+    if (p->cuda_ref) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+    }
+    p->cuda_init_done = false;
+}
+
+// ── Filter info / create / registration ────────────────────────────────────
+
+static const struct mp_filter_info vf_truehdr_filter = {
+    .name      = "truehdr",
+    .priv_size = sizeof(struct priv),
+    .process   = f_process,
+    .reset     = f_reset,
+    .destroy   = f_destroy,
+    .command   = truehdr_command,
+};
+
+static struct mp_filter *vf_truehdr_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_truehdr_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+
+    if (!vfx_load_libraries()) {
+        MP_ERR(f, "truehdr: failed to load the VFX libraries -- passthrough\n");
+        p->failed = true;
+        p->failed_warned = true;
+    }
+    return f;
+}
+
+const struct mp_user_filter_entry vf_truehdr = {
+    .desc = {
+        .name          = "truehdr",
+        .description   = "SDR→HDR10 AI up-conversion via NVIDIA VFX SDK TrueHDR",
+        .priv_size     = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &vf_truehdr_opts_def,
+        .options       = vf_opts_fields,
+    },
+    .create = vf_truehdr_create,
+};
diff --git a/video/filter/vf_vfg.c b/video/filter/vf_vfg.c
new file mode 100644
index 000000000..54246d1a0
--- /dev/null
+++ b/video/filter/vf_vfg.c
@@ -0,0 +1,1278 @@
+/*
+ * vf_vfg.c -- AI frame interpolation via NVIDIA VFX SDK VideoFrameGeneration
+ *
+ * Input contract: same as vf_vsr.c — only CUDA frames are processed (SW→HW
+ * unification is vf_hwup's job in the chain); non-CUDA frames always pass
+ * through (no engine init, no CUDA touched).
+ * CUDA/RGBA: D2D copy into the engine input buffer; CUDA/YUV: yuv_to_rgba D2D.
+ * This filter does not assume VSR or a decoder sits in front of it (the chain
+ * order hwup → vsr → vfg is the client's arrangement, the source does not rely
+ * on it).
+ *
+ * Scheduling (aligned item by item with vf_rife.c's integer_factor branch):
+ * multiplier K (option fps=2|3|4) — for every pair (prev, cur) output K frames
+ * = interpolated frames i=1..K-1 + **keeping the source frame cur itself**
+ * (vs-mlrt Interleave([src, interp]) semantics).
+ * PTS is stamped on **content time**: interpolated frames
+ * t_prev + (i/K)·(t_cur − t_prev), the cur frame t_cur — strictly monotonic,
+ * no holes (the fix for the historical "16s desync + continuous frame drops").
+ * Never fall back to an absolute grid (t0 + n/out_fps + llround anchoring):
+ * when the source frame rate is not an integer multiple of the output grid
+ * (e.g. 29.97→60, ratio 2.002) it periodically repeats/holes grid points → mpv
+ * "Invalid video timestamp" + desync + continuous frame drops.
+ *
+ * Why interpolation does not need the source frame rate (2026-10-16): the PTS
+ * above is **content-relative time** t_prev + (i/K)·(t_cur − t_prev), depending
+ * only on each pair's own PTS and the multiplier K — the source frame rate does
+ * not enter output frame timing at all. src_fps is only used for the output
+ * frame's nominal_fps/pkt_duration metadata and the status line's out=. So
+ * src_fps<=0 (live streams always have cur->nominal_fps = 0) **is not a reason
+ * to pass through**: the old "src-fps" passthrough branch has been removed (it
+ * passed the whole live stream through, showing up as
+ * vfg-status: mode=passthrough reason=src-fps). When src_fps is unknown the
+ * metadata stays unknown (0), and 1.0/0 = inf is never written.
+ *
+ * Scene change: **relies only on the engine's own detection**
+ * (AutomaticShotChangeDetectionEnabled=1, an SDK 1.3 capability) — this filter
+ * does not implement a second MAE detector (single source of truth; vf_rife's
+ * RIFE_SC_MAE is a historical artefact of the RIFE engine lacking this
+ * capability). On a cut the engine's passthrough behaviour = copying the
+ * current frame (cur). ⚠️ This is **semantically different** from vf_rife.c's
+ * "copy the nearer endpoint in time" (alpha>0.5 copies cur, otherwise prev):
+ * rife picks the nearest endpoint on each side by tval, whereas VFG's
+ * intermediate frame content is decided by the engine's internal detection,
+ * and this node only maps "the FrameIndex-mode intermediate frame" uniformly to
+ * the cur side, with no second decision point.
+ *
+ * Not done (deliberate, not introduced just for parity):
+ *   - adaptive/automatic performance degradation (removed in PR #19; cost= is
+ *     only an observation)
+ *   - the absolute-grid path for non-integer multipliers (VFG only does integer
+ *     multipliers; Timestep mode is unverified)
+ *   - a passthrough guard for target frame rates close to the source frame rate
+ *     (multiplier semantics are ≥2×, there is no 1.00x case)
+ *
+ * Output frame rate cap (max-fps, 2026-10-20): a **user-set explicit cap**, not
+ * automatic performance degradation — when `k * src_fps > max_fps` this node
+ * passes through (reason=max-fps), and once the source frame rate falls back
+ * (switching files / per-frame re-evaluation) interpolation resumes
+ * automatically. When src_fps is unknown (<=0, live streams) it cannot be
+ * judged, and it does not pass through because of the cap (the same reasoning
+ * as "do not pass through because src_fps<=0": interpolation itself does not
+ * depend on it).
+ * The criterion uses cur->nominal_fps (for VFR sources = the average frame rate
+ * from the container, good enough; no per-segment estimation).
+ * The cap is judged **before engine initialisation**, so when limited neither an
+ * engine is created nor CUDA consumed.
+ *
+ * fps=auto (2026-10-24): pick the largest integer multiplier in 2..4 whose
+ * output fits under max-fps; passthrough (reason=max-fps) only if none fits.
+ * This complements the "cap means passthrough" rule above rather than
+ * replacing it: an explicit fps=2|3|4 still gates or passes exactly as
+ * before. The motivation is measured on a 165 Hz panel: a 48 fps source at
+ * x4 is 192 fps, and the panel simply discards the excess (drop climbed to
+ * 3490 in --term-status-msg), while the same file at x3 is 144 fps and
+ * frame-perfect. The multiplier is a function of source fps AND panel
+ * refresh, so hardcoding it in a config is necessarily wrong for some
+ * inputs; it belongs in the filter. With no cap set, or with src_fps
+ * unknown (live streams), auto behaves like the old default and uses x4.
+ *
+ * Filter options:
+ *   fps:  off | auto | 2 | 3 | 4         (default: off)  integer multiplier K
+ *   mode: low | medium | high            (default: medium)
+ *   max-fps: 0..240                      (default: 0 = no cap) output fps cap
+ *
+ * mode **has only three tiers and no auto** (decided 2026-10-16: no automatic
+ * tier) — the tier is the user's explicit choice, the client always sends an
+ * explicit value, and the filter side no longer has any "pick a tier
+ * automatically" semantics.
+ *
+ * Why "guess the tier from resolution" was abandoned (measured; it replaced the
+ * old "input height ≥2160 → high"): that rule backfires in the downstream chain
+ * order (hwup → vsr → vfg) — **a non-4K source upscaled to 4K by VSR** (1080p +
+ * vsr:scale=2, i.e. fullscreen on a 4K panel) makes VFG's input height land
+ * exactly on 2160 → automatically picking HIGH, while VSR is running on that
+ * tier and the whole-chain budget is at its tightest. Measured in the player
+ * (1080p × scale=2, K=2, 4K output, 0 dropped frames both times):
+ *   HIGH   : init 3840×2160, VFG cost 13.2ms, frame time 13.99/24.06/27.18 ms (median/p90/max)
+ *   MEDIUM : init 3840×2160, VFG cost  3.8ms, frame time 16.20/16.48/18.62 ms
+ * i.e. HIGH is **3.5×** more expensive at 4K, and the frame-time p90 tail
+ * degrades from 16.5ms to 24.1ms; another run with the same configuration also
+ * accumulated 9 dropped frames (varies between runs). And MEDIUM on **native
+ * 4K** material (3840×1600, VSR passthrough) measured cost=2.7ms / 48fps / 0
+ * dropped frames — entirely sufficient.
+ * HIGH's image-quality gain over MEDIUM is also small: the mid/blend
+ * high-frequency ratio of 4K interpolated frames is 0.918 for MEDIUM vs 0.956
+ * for HIGH, and **visual inspection (1:1 crop) showed no visible softening**.
+ * A more fundamental reason: **guessing the tier from resolution is "making a
+ * global decision from local information inside a node"**, the same origin as
+ * the RIFE automatic performance degradation removed in PR #19.
+ * ⚠️ **HIGH has not been removed** — it can still be enabled explicitly with
+ * mode=high (--vf option / `vf-command vfg mode high` / RPC).
+ */
+
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+#include "options/m_option.h"
+#include "common/msg.h"
+#include "common/common.h"
+#include "mpv/client.h"   // struct mpv_node (set/get for custom option types)
+
+#include <cuda.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "vfg_proc.h"
+#include "cuda_shared.h"
+#include "yuv_to_rgba.h"
+
+// vfg-status cadence (output frames)
+#define VFG_STATUS_EVERY 30
+// Multiplier range exposed by the option layer (frozen interface:
+// fps=off|2|3|4). Deliberately separate from the SDK's
+// VFG_MULT_MIN..MAX (2..8): the SDK can run 5..8, but the interface does not
+// expose them — out of range is reported clearly at parse time instead of
+// silently running at 5× (measured: written as 2..8 first, fps=5 was accepted
+// and really output 150fps at k=5).
+#define VFG_FPS_OPT_MIN 2
+#define VFG_FPS_OPT_MAX 4
+// Internal sentinel for fps=auto (the option parser accepts the string
+// "auto" and stores 0). Resolve to the largest feasible multiplier from
+// src_fps and max-fps. 0 can never be an explicit multiplier (2..4).
+#define VFG_FPS_AUTO 0
+// Output frame rate cap (max-fps): 0 = unlimited (the default, so the old
+// plain --vf usage is unaffected); the client (UI) only ever sends 48/60/120,
+// and the cap is relaxed to 240 just to leave headroom for manual tuning.
+#define VFG_MAX_FPS_LIMIT_MAX 240
+
+static double vfg_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void f_reset(struct mp_filter *f);   // defined after the scheduling section (vf-command needs it)
+
+// ── Options ────────────────────────────────────────────────────────────────
+
+struct vf_vfg_opts {
+    int fps;      // -1 = off, 0 = auto, 2/3/4 = integer multiplier K
+    int mode;     // 0=low, 1=medium, 2=high (default 1=medium, no auto)
+    int max_fps;  // output frame rate cap (0=unlimited); k*src_fps above it means passthrough
+};
+
+#define OPT_BASE_STRUCT struct vf_vfg_opts
+
+// fps option type (mirrors vf_rife.c's rife_fps_type): "off"→-1, integers only
+// accept 2..4 (the SDK's FrameMultiplier supports 2..8, the frozen interface
+// only exposes 2/3/4), anything out of range gives M_OPT_INVALID with a clear
+// message.
+static int vfg_fps_parse(struct mp_log *log, const m_option_t *opt,
+                         struct bstr name, struct bstr param, void *dst)
+{
+    int v;
+    if (bstr_equals0(param, "off")) {
+        v = -1;
+    } else if (bstr_equals0(param, "auto")) {
+        v = VFG_FPS_AUTO;
+    } else {
+        if (param.len == 0)
+            return M_OPT_MISSING_PARAM;
+        struct bstr rest;
+        long long n = bstrtoll(param, &rest, 10);
+        if (rest.len || n < VFG_FPS_OPT_MIN || n > VFG_FPS_OPT_MAX) {
+            mp_err(log, "The %.*s option must be off, auto or an integer %d..%d: %.*s\n",
+                   BSTR_P(name), VFG_FPS_OPT_MIN, VFG_FPS_OPT_MAX, BSTR_P(param));
+            return M_OPT_INVALID;
+        }
+        v = (int)n;
+    }
+    if (dst)
+        *(int *)dst = v;
+    return 1;
+}
+
+static char *vfg_fps_print(const m_option_t *opt, const void *val)
+{
+    int v = *(const int *)val;
+    if (v == VFG_FPS_AUTO)
+        return talloc_strdup(NULL, "auto");
+    return talloc_asprintf(NULL, "%d", v);
+}
+
+static void vfg_fps_copy(const m_option_t *opt, void *dst, const void *src)
+{
+    if (dst && src)
+        memcpy(dst, src, sizeof(int));
+}
+
+static int vfg_fps_set(const m_option_t *opt, void *dst, struct mpv_node *src)
+{
+    int v;
+    if (src->format == MPV_FORMAT_INT64)
+        v = (int)src->u.int64;
+    else if (src->format == MPV_FORMAT_DOUBLE)
+        v = (int)src->u.double_;
+    else
+        return M_OPT_INVALID;
+    if (v != -1 && v != VFG_FPS_AUTO &&
+        (v < VFG_FPS_OPT_MIN || v > VFG_FPS_OPT_MAX))
+        return M_OPT_OUT_OF_RANGE;
+    *(int *)dst = v;
+    return 1;
+}
+
+static int vfg_fps_get(const m_option_t *opt, void *ta_parent,
+                       struct mpv_node *dst, void *src)
+{
+    dst->format = MPV_FORMAT_INT64;
+    dst->u.int64 = *(const int *)src;
+    return 1;
+}
+
+static bool vfg_fps_equal(const m_option_t *opt, void *a, void *b)
+{
+    return memcmp(a, b, sizeof(int)) == 0;
+}
+
+static const m_option_type_t vfg_fps_type = {
+    .name  = "vfg-fps",
+    .size  = sizeof(int),
+    .parse = vfg_fps_parse,
+    .print = vfg_fps_print,
+    .copy  = vfg_fps_copy,
+    .set   = vfg_fps_set,
+    .get   = vfg_fps_get,
+    .equal = vfg_fps_equal,
+};
+
+#define OPT_VFG_FPS(field) \
+    OPT_TYPED_FIELD(vfg_fps_type, int, field)
+
+static const struct m_option vf_opts_fields[] = {
+    {"fps",  OPT_VFG_FPS(fps)},
+    {"mode", OPT_CHOICE(mode,
+        {"low", 0}, {"medium", 1}, {"high", 2}),
+        M_RANGE(0, 2)},
+    // Output frame rate cap: 0 = unlimited; the client (UI/RPC) sends 48/60/120.
+    {"max-fps", OPT_INT(max_fps), M_RANGE(0, VFG_MAX_FPS_LIMIT_MAX)},
+    {0}
+};
+
+static const struct vf_vfg_opts vf_vfg_opts_def = {
+    .fps     = -1,
+    .mode    = VFG_MODE_MEDIUM,
+    .max_fps = 0,
+};
+
+// ── Filter private state ───────────────────────────────────────────────────
+
+/// CUDA context ownership — fully isomorphic to vf_vsr.c (shared struct
+/// cuda_shared.h):
+///   - borrow the upstream shared struct (bufs[0] opaque of hwup/vsr output
+///     frames)
+///   - hwdec frame (opaque is not this chain's shared struct): build our own
+///     borrower struct + ctx_holder
+///   - software frame: passthrough (contract: SW→HW is vf_hwup's job)
+struct priv {
+    struct vf_vfg_opts *opts;
+
+    struct mp_cuda_ctx_ref *cuda_ref;
+    CUstream  cuda_stream;
+    bool      cuda_init_done;
+
+    AVBufferRef *av_hw_device;      // CUDA device ctx (for the output RGBA frames)
+    AVBufferRef *av_hw_frames;      // CUDA/RGBA frames ctx
+    CUcontext    av_hw_frames_ctx;  // ctx av_hw_frames was created on
+
+    struct vfg_context vfg;
+    bool vfg_configured;
+    int  vfg_mode;                  // Mode the engine is currently resolved to (enum vfg_mode)
+
+    struct yuv_to_rgba yuv_conv;    // CUDA/YUV → RGB D2D
+    bool  yuv_conv_ready;
+    int   yuv_conv_bd;
+    int   yuv_conv_bits;            // output bit depth (8 RGBA U8 / 10 RGB10A2)
+    enum yuv_matrix yuv_conv_matrix;
+    enum yuv_range  yuv_conv_range;
+
+    CUdeviceptr out_buf;            // one block per output frame, reset to 0 once handed over
+    size_t      out_buf_size;
+    int         out_w, out_h, out_pitch;
+
+    int    video_w, video_h;        // engine/input size (VFG output is the same size)
+    double src_fps;                 // input frame rate (nominal_fps)
+    int    k;                       // current multiplier (= opts->fps, 2..4)
+
+    // scheduling state: one pair is expanded across several process() calls
+    bool   have_prev;               // in_img[0] already holds prev (content time prev_pts)
+    double prev_pts;
+    struct mp_image *pending_cur;   // the cur being expanded (owned by this filter)
+    double cur_pts;
+    int    emit_i;                  // next output: 1..K-1 interpolation, K = cur copy
+
+    bool passthrough;
+    char pt_reason[32];
+    bool degrade_warned;            // engine-failure passthrough warns only once
+    bool engine_failed;             // one-shot engine degradation (no per-frame retry)
+    bool sw_warned;
+
+    int    frame_count;
+    int    status_frames;           // active branch output counter (status line every 30 frames)
+    double status_cost_ms;
+    int    status_emit;             // passthrough branch counter
+};
+
+// ── Status line (MSGL_STATUS, every 30 output frames) ──────────────────────
+// The client extracts it by the "vfg-status:" prefix and splices it into the
+// OSD. The format is frozen:
+//   active     : vfg-status: mode=active src=%.2f k=%d out=%.2f cost=%.1fms
+//   passthrough: vfg-status: mode=passthrough reason=<reason>
+// cost = this node's processing time **per output frame** (including stream
+// sync; an observation, not part of any decision).
+
+static void vfg_status(struct mp_filter *f, struct priv *p)
+{
+    if (p->passthrough) {
+        mp_msg(f->log, MSGL_STATUS, "vfg-status: mode=passthrough reason=%s\n",
+               p->pt_reason);
+        return;
+    }
+    // src_fps unknown (<=0, live stream nominal_fps=0) → out prints 0.00: the
+    // format is frozen to %.2f (the client OSD displays it as-is, and any
+    // numeric consumer can still parse it), and src=0.00 already expresses
+    // "source frame rate unknown" without lying the way inf/nan would; it is
+    // not changed to "?" so as not to break the field syntax (field names,
+    // order and numeric formats all stay as they are).
+    double out_fps = p->src_fps > 0 ? p->k * p->src_fps : 0.0;
+    mp_msg(f->log, MSGL_STATUS,
+           "vfg-status: mode=active src=%.2f k=%d out=%.2f cost=%.1fms\n",
+           p->src_fps, p->k, out_fps,
+           p->status_frames > 0 ? p->status_cost_ms / p->status_frames : 0.0);
+    p->status_frames = 0;
+    p->status_cost_ms = 0;
+}
+
+static const char *vfg_mode_name(int mode)
+{
+    switch (mode) {
+    case VFG_MODE_LOW:    return "low";
+    case VFG_MODE_MEDIUM: return "medium";
+    case VFG_MODE_HIGH:   return "high";
+    default:              return "?";
+    }
+}
+
+// ── CUDA context setup (isomorphic to vf_vsr.c ensure_cuda) ────────────────
+// Single-context design: the whole chain shares one driver context (multiple
+// contexts time-slice on the GPU and hang the device when run concurrently with
+// other engines). Sources and ownership in cuda_shared.h.
+
+static bool ensure_cuda(struct mp_filter *f, struct priv *p,
+                        struct mp_image *mpi)
+{
+    CUcontext borrow = mp_cuda_ctx_from_mpi(mpi);  // NULL = SW frame
+
+    if (p->cuda_ref) {
+        if (p->cuda_ref->ctx == borrow)
+            return true;
+    }
+
+    CUresult cr = cuInit(0);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "vfg: cuInit failed (%d)\n", cr);
+        return false;
+    }
+
+    // Switching hwdec (software↔hardware decode) swaps the upstream CUDA
+    // context: the engine, yuv_to_rgba's NVRTC module, the stream and out_buf
+    // are all context-bound and must be invalidated **inside the old context**,
+    // otherwise reusing the old kernel handles → cuLaunchKernel 400 → this
+    // filter gets disabled by mpv (measured 2026-10-17: the root cause of
+    // "no more frame generation after switching to software decode or back to
+    // hardware decode").
+    if (p->cuda_ref) {
+        CUcontext old = p->cuda_ref->ctx;
+        if (old) cuCtxPushCurrent(old);
+        if (p->vfg_configured) {
+            vfg_destroy(&p->vfg);
+            p->vfg_configured = false;
+        }
+        if (p->yuv_conv_ready) {
+            yuv_to_rgba_destroy(&p->yuv_conv);
+            p->yuv_conv_ready = false;
+        }
+        if (p->out_buf) {
+            cuMemFree(p->out_buf);
+            p->out_buf = 0;
+            p->out_buf_size = 0;
+        }
+        if (p->cuda_init_done && p->cuda_stream) {
+            cuStreamDestroy(p->cuda_stream);
+            p->cuda_stream = NULL;
+            p->cuda_init_done = false;
+        }
+        if (old) cuCtxPopCurrent(NULL);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        MP_VERBOSE(f, "vfg: CUDA context changed — engine/converter reset\n");
+    }
+
+    struct mp_cuda_ctx_ref *shared = mp_cuda_ctx_ref_from_mpi(mpi);
+    if (shared) {
+        mp_cuda_ctx_ref_acquire(shared);
+        p->cuda_ref = shared;
+        MP_VERBOSE(f, "vfg: sharing upstream CUDA context\n");
+    } else if (borrow) {
+        p->cuda_ref = calloc(1, sizeof(*p->cuda_ref));
+        p->cuda_ref->magic = MP_CUDA_CTX_REF_MAGIC;
+        p->cuda_ref->ctx = borrow;
+        p->cuda_ref->owned = false;
+        p->cuda_ref->ctx_holder = av_buffer_ref(mpi->hwctx);
+        if (!p->cuda_ref->ctx_holder) {
+            MP_ERR(f, "vfg: failed to hold hwdec frame ref\n");
+            free(p->cuda_ref);
+            p->cuda_ref = NULL;
+            return false;
+        }
+        atomic_init(&p->cuda_ref->refs, 1);
+        MP_VERBOSE(f, "vfg: sharing hwdec CUDA context\n");
+    } else {
+        // Software frames already returned in the passthrough branch; reaching
+        // here means the upstream state is abnormal — do not create a context
+        // (vf_vsr's historical lesson: rebuilding the context every frame
+        // invalidates the engine buffers).
+        MP_ERR(f, "vfg: no CUDA context from input (software frame past passthrough)\n");
+        return false;
+    }
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    cr = cuStreamCreate(&p->cuda_stream, CU_STREAM_NON_BLOCKING);
+    cuCtxPopCurrent(NULL);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "vfg: cuStreamCreate failed (%d)\n", cr);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        return false;
+    }
+
+    p->cuda_init_done = true;
+    return true;
+}
+
+// ── yuv→rgba converter lifecycle (isomorphic to vf_vsr.c
+//    ensure_yuv_converter) ──────────────────────────────────────────────
+
+static bool ensure_yuv_converter(struct mp_filter *f, struct priv *p,
+                                 int bit_depth, enum yuv_matrix matrix,
+                                 enum yuv_range range, int out_bits,
+                                 const struct mp_image_params *src)
+{
+    if (p->yuv_conv_ready &&
+        p->yuv_conv_bd == bit_depth &&
+        p->yuv_conv_bits == out_bits &&
+        p->yuv_conv_matrix == matrix &&
+        p->yuv_conv_range == range)
+        return true;
+
+    if (p->yuv_conv_ready)
+        yuv_to_rgba_destroy(&p->yuv_conv);
+
+    // HDR display debugging: matrix/range + source frame colour metadata
+    // (wrong matrix = reddish, a measured suspect).
+    MP_INFO(f, "yuv->rgb: bd=%d out=%d matrix=%d range=%d | src sys=%d levels=%d "
+            "primaries=%d transfer=%d\n", bit_depth, out_bits, (int)matrix, (int)range,
+            (int)src->repr.sys, (int)src->repr.levels,
+            (int)src->color.primaries, (int)src->color.transfer);
+    if (!yuv_to_rgba_init(&p->yuv_conv, bit_depth, matrix, range, out_bits)) {
+        MP_ERR(f, "vfg: yuv_to_rgba_init failed (bd=%d out=%d)\n",
+               bit_depth, out_bits);
+        p->yuv_conv_ready = false;
+        return false;
+    }
+    p->yuv_conv_bd = bit_depth;
+    p->yuv_conv_bits = out_bits;
+    p->yuv_conv_matrix = matrix;
+    p->yuv_conv_range = range;
+    p->yuv_conv_ready = true;
+    return true;
+}
+
+// ── VFG init / reconfigure ─────────────────────────────────────────────────
+
+static bool ensure_vfg(struct mp_filter *f, struct priv *p, int in_w, int in_h,
+                       int bits)
+{
+    // Tier = the user's explicit choice (no auto; the reasoning for dropping it
+    // and the measurements are in the file header), default medium.
+    int mode = p->opts->mode;
+
+    if (p->vfg_configured) {
+        // Any change of size/Mode/stream requires a rebuild: the SDK requires a
+        // re-Load for both Mode and InputWidth/InputHeight (the official nvvfx
+        // wrapper marks them requires_reload; the probe only ever set Mode
+        // before Load, whether a later change takes effect is unverified). The
+        // same applies when the stream changes because ensure_cuda rebinds it
+        // (CudaStream is bound at Load).
+        bool same = (p->vfg.in_w == in_w && p->vfg.in_h == in_h &&
+                     p->vfg.bits == bits &&
+                     p->vfg_mode == mode && p->vfg.stream == p->cuda_stream);
+        if (same) {
+            // FrameMultiplier needs no rebuild (SetU32 before every Run)
+            if (p->vfg.multiplier != p->k)
+                vfg_set_multiplier(&p->vfg, p->k);
+            return true;
+        }
+        MP_INFO(f, "vfg: reconfig %dx%d mode=%s bits=%d -> %dx%d mode=%s bits=%d\n",
+                p->vfg.in_w, p->vfg.in_h, vfg_mode_name(p->vfg_mode), p->vfg.bits,
+                in_w, in_h, vfg_mode_name(mode), bits);
+        vfg_destroy(&p->vfg);
+        p->vfg_configured = false;
+    }
+
+    MP_INFO(f, "vfg: init %dx%d mode=%s k=%d bits=%d\n", in_w, in_h,
+            vfg_mode_name(mode), p->k, bits);
+    if (!vfg_init(&p->vfg, in_w, in_h, mode, p->k, bits, p->cuda_stream)) {
+        MP_ERR(f, "vfg: init failed (%dx%d mode=%s k=%d)\n",
+               in_w, in_h, vfg_mode_name(mode), p->k);
+        return false;
+    }
+    p->vfg_mode = mode;
+    p->vfg_configured = true;
+    MP_VERBOSE(f, "vfg: engine ready mode=%s\n", vfg_mode_name(mode));
+    return true;
+}
+
+// ── Output buffer (isomorphic to vf_vsr.c ensure_out_buf: reset to 0 once
+//    handed over, reallocated on the next frame) ─────────────────────────
+
+static bool ensure_out_buf(struct mp_filter *f, struct priv *p,
+                           int out_w, int out_h, int out_pitch)
+{
+    size_t needed = (size_t)out_pitch * out_h;
+    if (p->out_buf && p->out_buf_size >= needed) {
+        p->out_w     = out_w;
+        p->out_h     = out_h;
+        p->out_pitch = out_pitch;
+        return true;
+    }
+    if (p->out_buf) {
+        cuMemFree(p->out_buf);
+        p->out_buf = 0;
+        p->out_buf_size = 0;
+    }
+    CUresult cr = cuMemAlloc(&p->out_buf, needed);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "vfg: cuMemAlloc(out %zu) failed (%d)\n", needed, cr);
+        return false;
+    }
+    p->out_buf_size = needed;
+    p->out_w     = out_w;
+    p->out_h     = out_h;
+    p->out_pitch = out_pitch;
+    return true;
+}
+
+// ── AVBufferRef free callback / mp_image dtor (same as vf_vsr.c) ───────────
+
+static void mp_image_dtor(void *ptr)
+{
+    struct mp_image *mpi = ptr;
+    for (int p = 0; p < MP_MAX_PLANES; p++)
+        av_buffer_unref(&mpi->bufs[p]);
+    av_buffer_unref(&mpi->hwctx);
+    av_buffer_unref(&mpi->icc_profile);
+    av_buffer_unref(&mpi->a53_cc);
+    av_buffer_unref(&mpi->dovi);
+    av_buffer_unref(&mpi->film_grain);
+    for (int n = 0; n < mpi->num_ff_side_data; n++)
+        av_buffer_unref(&mpi->ff_side_data[n].buf);
+}
+
+static void free_cuda_buf(void *opaque, uint8_t *data)
+{
+    struct mp_cuda_ctx_ref *r = opaque;
+    if (r && r->ctx) cuCtxPushCurrent(r->ctx);
+    // No stream sync: the buffer is only released after the consumer (the VO's
+    // map copy / a downstream filter) has replaced it, and this filter's
+    // per-frame stream sync has already drained the copies; syncing stream 0 of
+    // a shared context would wait for the render thread (same reasoning as
+    // vf_vsr.c free_cuda_buf).
+    cuMemFree((CUdeviceptr)data);
+    if (r && r->ctx) cuCtxPopCurrent(NULL);
+    if (r)
+        mp_cuda_ctx_ref_release(r);
+}
+
+// ── Output frame construction (isomorphic to vf_vsr.c's output section /
+//    vf_rife.c rife_make_output) ─────────────────────────────────────────
+// The caller must already have done cuCtxPushCurrent; ownership of p->out_buf
+// is transferred to the returned frame.
+
+static struct mp_image *vfg_make_output(struct mp_filter *f, struct priv *p,
+                                        const struct mp_image *src, double pts,
+                                        double out_fps)
+{
+    const int out_bits = p->vfg.bits;
+    // sw_format is always RGBA (FFmpeg CUDA hwframes does not support x2rgb10,
+    // see the note in vf_vsr.c ensure_av_hw_frames); 10-bit is carried by
+    // hw_subfmt.
+    if (!mp_cuda_ensure_frames(f->log, p->cuda_ref->ctx, AV_PIX_FMT_RGBA,
+                               p->out_w, p->out_h,
+                               &p->av_hw_device, &p->av_hw_frames,
+                               &p->av_hw_frames_ctx)) {
+        MP_ERR(f, "vfg: CUDA/4Bpp hw_frames_ctx failed\n");
+        return NULL;
+    }
+    mp_cuda_ctx_ref_acquire(p->cuda_ref);
+    struct mp_image *out = talloc_zero(NULL, struct mp_image);
+    talloc_set_destructor(out, mp_image_dtor);
+    out->bufs[0] = av_buffer_create((uint8_t *)p->out_buf, (int)p->out_buf_size,
+                                    free_cuda_buf, p->cuda_ref, 0);
+    if (!out->bufs[0]) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        talloc_free(out);
+        return NULL;
+    }
+    mp_image_setfmt(out, IMGFMT_CUDA);
+    mp_image_sethwfmt(out, IMGFMT_CUDA, vfx_imgfmt_from_bits(out_bits));
+    mp_image_params_guess_csp(&out->params);
+    out->params.color = src->params.color;   // HDR metadata (same as vf_vsr)
+    // Same reason as vf_vsr: generated frames are RGB, and el_pair would
+    // re-attach the source RPU to them (f_enhancement_pair.c:102) unless
+    // no_dovi is set.
+    if (src->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION || src->dovi) {
+        out->params.no_dovi = true;
+        out->params.no_enhancement_layer = true;
+    }
+    out->params.p_w = src->params.p_w;       // pixel aspect ratio (aspect override)
+    out->params.p_h = src->params.p_h;
+    // Orientation is invariant under frame generation. pkt_duration is *not*
+    // copied: generated frames run at out_fps, so the synthetic value below
+    // is the correct one.
+    out->params.rotate   = src->params.rotate;
+    out->params.vflip    = src->params.vflip;
+    out->params.stereo3d = src->params.stereo3d;
+    out->fields          = src->fields;
+    out->w = p->out_w;
+    out->h = p->out_h;
+    out->params.w = p->out_w;
+    out->params.h = p->out_h;
+    out->planes[0] = (uint8_t *)p->out_buf;
+    out->stride[0] = p->out_pitch;
+    out->num_planes = 1;
+    out->hwctx = av_buffer_ref(p->av_hw_frames);
+    out->pts         = pts;
+    out->dts         = src->dts;
+    // src_fps unknown (live stream nominal_fps=0) → metadata stays unknown:
+    // 1.0/0 = inf is never written. Output frame timing does not depend on
+    // nominal_fps (PTS is content-relative time).
+    out->nominal_fps  = out_fps > 0 ? out_fps : src->nominal_fps;
+    out->pkt_duration = out->nominal_fps > 0 ? 1.0 / out->nominal_fps : 0;
+    p->out_buf = 0;              // ownership transferred
+    p->out_buf_size = 0;
+    return out;
+}
+
+// ── D2D copy (this filter's stream) ────────────────────────────────────────
+
+static bool copy_d2d(struct mp_filter *f, struct priv *p,
+                     void *dst, size_t dst_pitch,
+                     const void *src, size_t src_pitch, int w, int h)
+{
+    CUDA_MEMCPY2D copy = {0};
+    copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.srcDevice     = (CUdeviceptr)src;
+    copy.srcPitch      = src_pitch;
+    copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+    copy.dstDevice     = (CUdeviceptr)dst;
+    copy.dstPitch      = dst_pitch;
+    copy.WidthInBytes  = (size_t)w * 4;
+    copy.Height        = (size_t)h;
+    if (cuMemcpy2DAsync(&copy, p->cuda_stream) != CUDA_SUCCESS) {
+        MP_ERR(f, "vfg: cuMemcpy2DAsync failed\n");
+        return false;
+    }
+    return true;
+}
+
+// ── Input frame → engine input buffer (CUDA/YUV conversion or CUDA/RGBA
+//    D2D) ────────────────────────────────────────────────────────────────
+// Isomorphic to the shim in vf_vsr.c:677-710 (idx=1 means SrcImage1).
+
+static bool stage_input(struct mp_filter *f, struct priv *p,
+                        struct mp_image *cur, int idx)
+{
+    if (!vfx_imgfmt_is_rgb(cur->params.hw_subfmt)) {
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(cur->params.hw_subfmt);
+        int bd = desc.bpp[0];
+        enum yuv_matrix mx = matrix_from_repr(&cur->params);
+        enum yuv_range  rn = range_from_levels(cur->params.repr.levels);
+        if (!ensure_yuv_converter(f, p, bd, mx, rn, p->vfg.bits, &cur->params))
+            return false;
+        if (!yuv_to_rgba_convert(&p->yuv_conv,
+                                 cur->planes[0], cur->stride[0],
+                                 cur->planes[1], cur->stride[1],
+                                 p->video_w, p->video_h,
+                                 p->vfg.in_pixels[idx],
+                                 p->vfg.in_pitch[idx],
+                                 p->cuda_stream)) {
+            MP_ERR(f, "vfg: yuv_to_rgba_convert failed\n");
+            return false;
+        }
+        return true;
+    }
+    return copy_d2d(f, p, p->vfg.in_pixels[idx], (size_t)p->vfg.in_pitch[idx],
+                    cur->planes[0], (size_t)cur->stride[0],
+                    p->video_w, p->video_h);
+}
+
+// ── Status accounting (active branch: once per output frame) ───────────────
+
+static void vfg_account(struct mp_filter *f, struct priv *p, double t0)
+{
+    p->status_cost_ms += vfg_now_ms() - t0;
+    p->status_frames++;
+    if (p->status_frames >= VFG_STATUS_EVERY)
+        vfg_status(f, p);
+}
+
+// ── One frame of an output pair ───────────────────────────────────────────
+// i=1..K-1 goes through VFG Run (content time t_prev + (i/K)·Δ); i=K outputs
+// cur itself (content taken from in_img[1]'s RGBA staging). The caller must
+// already have done cuCtxPushCurrent and have pending_cur / emit_i ready.
+// Every call outputs **exactly one frame**.
+
+static bool emit_pair_output(struct mp_filter *f, struct priv *p)
+{
+    struct mp_image *cur = p->pending_cur;
+    double t_prev = p->prev_pts;
+    double t_cur  = p->cur_pts;
+    int k = p->k;
+    double out_fps = k * p->src_fps;
+    int i = p->emit_i;
+    double t0 = vfg_now_ms();
+    const void *src;
+    size_t src_pitch;
+    double pts;
+
+    if (i < k) {
+        void *vfg_out = NULL;
+        int vfg_pitch = 0;
+        if (!vfg_process(&p->vfg, i, &vfg_out, &vfg_pitch))
+            return false;
+        src = vfg_out;
+        src_pitch = (size_t)vfg_pitch;
+        // Content time: always t = i/K (vs-mlrt Interleave semantics — even on
+        // VFR sources it is never pushed to an extreme tval)
+        double tval = (double)i / k;
+        pts = t_prev + (t_cur - t_prev) * tval;
+    } else {
+        // cur itself (content in in_img[1]'s RGBA staging, already the
+        // full-range conversion result — the source YUV planes are not used, to
+        // avoid flicker from alternating between the two colour taggings, same
+        // reasoning as vf_rife.c rife_make_copy)
+        src = p->vfg.in_pixels[1];
+        src_pitch = (size_t)p->vfg.in_pitch[1];
+        pts = t_cur;
+    }
+
+    if (!ensure_out_buf(f, p, p->video_w, p->video_h, (int)src_pitch))
+        return false;
+    if (!copy_d2d(f, p, (void *)p->out_buf, (size_t)p->out_pitch,
+                  src, src_pitch, p->video_w, p->video_h))
+        return false;
+    // GPU work completion boundary for this frame (same as vf_vsr: the copy must
+    // be finished before the downstream/VO reads it)
+    cuStreamSynchronize(p->cuda_stream);
+
+    struct mp_image *out = vfg_make_output(f, p, cur, pts, out_fps);
+    if (!out)
+        return false;
+
+    MP_DBG(f, "vfg: OUT pts=%.4f i=%d/%d %s\n", pts, i, k,
+           i < k ? "[mid]" : "[copy]");
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    vfg_account(f, p, t0);
+
+    if (i >= k) {
+        // pair complete: cur becomes the next pair's prev (content is already in
+        // in_img[1], so the next pair's start moves to in_img[0]); release the
+        // input frame (do not hold the decode surface long-term)
+        p->prev_pts = t_cur;
+        p->have_prev = true;
+        talloc_free(p->pending_cur);
+        p->pending_cur = NULL;
+    } else {
+        p->emit_i = i + 1;
+    }
+    return true;
+}
+
+// ── f_process ──────────────────────────────────────────────────────────────
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    // Only work when the output pin needs data (same as vf_rife's process
+    // entry): this filter expands one pair across several calls and cannot read
+    // input while an expansion is in progress.
+    if (!mp_pin_in_needs_data(f->ppins[1]))
+        return;
+
+    // ── 1. pair being expanded: output one frame per call ───────────────
+    if (p->pending_cur) {
+        cuCtxPushCurrent(p->cuda_ref->ctx);
+        bool ok = emit_pair_output(f, p);
+        cuCtxPopCurrent(NULL);
+        if (!ok) {
+            talloc_free(p->pending_cur);
+            p->pending_cur = NULL;
+            p->have_prev = false;
+            mp_filter_internal_mark_failed(f);
+        }
+        return;
+    }
+
+    // ── 2. read in the next frame ───────────────────────────────────────
+    if (!mp_pin_out_request_data(f->ppins[0]))
+        return;
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_NONE)
+        return;
+    if (mp_frame_is_signaling(frame)) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (frame.type != MP_FRAME_VIDEO) {
+        MP_ERR(f, "vfg: non-video frame received\n");
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    struct mp_image *cur = frame.data;
+    p->frame_count++;
+
+    int in_w = cur->w, in_h = cur->h;
+    if (cur->nominal_fps > 0)
+        p->src_fps = cur->nominal_fps;
+
+    // ── 3. passthrough decision (re-evaluated every frame: a vf-command hot
+    //    update takes effect on the next frame) ──────────────────────────
+    bool sw_input = (cur->imgfmt != IMGFMT_CUDA);
+    if (sw_input && !p->sw_warned) {
+        MP_WARN(f, "vfg: software frames — passthrough (prepend @hwup for VFG)\n");
+        p->sw_warned = true;
+    }
+
+    // Passthrough decision (re-evaluated every frame). **Never passes through
+    // because of src_fps<=0** (the old "src-fps" branch was removed):
+    // interpolated PTS only uses content-relative time and depends only on the
+    // multiplier K — see "why interpolation does not need the source frame
+    // rate" in the file header. A live stream's nominal_fps=0 is no longer
+    // downgraded to passthrough.
+    // Resolve the multiplier before gating. fps=auto (VFG_FPS_AUTO) is not a
+    // real K: it asks for the largest K in 2..4 whose output fits under
+    // max-fps. An explicit 2..4 passes through unchanged and still gates
+    // exactly as it did before this option existed.
+    int k = p->opts->fps;
+    if (k == VFG_FPS_AUTO) {
+        if (p->opts->max_fps > 0 && p->src_fps > 0) {
+            k = -1;
+            for (int t = VFG_FPS_OPT_MAX; t >= VFG_FPS_OPT_MIN; t--) {
+                if (t * p->src_fps <= p->opts->max_fps) {
+                    k = t;
+                    break;
+                }
+            }
+        } else {
+            // No cap, or the source fps is unknown: use the old default.
+            k = VFG_FPS_OPT_MAX;
+        }
+    }
+
+    const char *reason = NULL;
+    if (p->opts->fps == -1)                          reason = "off";
+    else if (k < VFG_FPS_OPT_MIN)                    reason = "max-fps";
+    else if (p->opts->fps > VFG_FPS_OPT_MAX)         reason = "k-range";
+    // Output cap (user-set, not an automatic downgrade; see the file header).
+    // Landing exactly on the cap (30x2=60, cap=60) still interpolates, and an
+    // unknown src_fps skips the test. For auto this is already satisfied.
+    else if (p->opts->max_fps > 0 && p->src_fps > 0 &&
+             k * p->src_fps > p->opts->max_fps)
+                                                     reason = "max-fps";
+    else if (sw_input)                               reason = "sw";
+    else if (p->engine_failed)                       reason = "engine";
+    else if (cur->pts == MP_NOPTS_VALUE && !p->have_prev)
+                                                     reason = "no-pts";
+
+    if (reason) {
+        p->passthrough = true;
+        snprintf(p->pt_reason, sizeof(p->pt_reason), "%s", reason);
+        if (p->vfg_configured) {
+            cuCtxPushCurrent(p->cuda_ref->ctx);
+            vfg_destroy(&p->vfg);
+            cuCtxPopCurrent(NULL);
+            p->vfg_configured = false;
+            MP_INFO(f, "vfg: switching to passthrough (%s)\n", reason);
+        }
+        p->have_prev = false;   // scheduling continuity invalidated
+        if (++p->status_emit >= VFG_STATUS_EVERY) {
+            p->status_emit = 0;
+            vfg_status(f, p);
+        }
+        mp_pin_in_write(f->ppins[1], frame);   // passthrough: the original frame untouched
+        return;
+    }
+
+    p->passthrough = false;
+    p->k = k;
+
+    // Duplicate/reordered/missing PTS: drop cur, keep prev (same semantics as
+    // vf_rife)
+    // ⚠ Here the input **was consumed but no output was written**, so
+    // mark_progress is mandatory to make the framework call process() again:
+    // otherwise the pin has no further events and this filter is never called
+    // again → the downstream never gets a frame and the whole chain stalls
+    // (symptom = the picture freezes on one frame, seeking stays true after a
+    // seek, core-idle=yes).
+    // The trigger is old material with broken timestamps (large numbers of
+    // duplicate pts / pts=N/A in Ogg/VBR containers, where mpv prints
+    // `Invalid video timestamp`) — measured: the file 2.avi in /home/zmq's
+    // video folder (XVID in Ogg, 640x480) stalls outright on the second
+    // duplicate pts frame.
+    // Contrast: vf_rife's version of this branch `continue`s inside a for(;;)
+    // prefetch loop, so it does not need this.
+    double t_cur = cur->pts;
+    if (p->have_prev && (t_cur == MP_NOPTS_VALUE || t_cur <= p->prev_pts)) {
+        MP_DBG(f, "vfg: drop frame pts=%.3f (prev=%.3f)\n", t_cur, p->prev_pts);
+        talloc_free(cur);
+        mp_filter_internal_mark_progress(f);
+        return;
+    }
+
+    // ── 4. CUDA context + engine (lazy init) ───────────────────────────
+    if (!ensure_cuda(f, p, cur)) {
+        talloc_free(cur);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+
+    // Path bit depth: the source subfmt is already 10-bit packed RGB (upstream
+    // vsr) or the source bit depth is >8 (P010/P016) → 10-bit path; otherwise
+    // keep the historical 8-bit behaviour.
+    int bits = vfx_bits_from_imgfmt(cur->params.hw_subfmt);
+    if (!ensure_vfg(f, p, in_w, in_h, bits)) {
+        cuCtxPopCurrent(NULL);
+        // engine unavailable → one-shot passthrough downgrade (no per-frame
+        // retry; retried after f_reset)
+        if (!p->degrade_warned) {
+            MP_WARN(f, "vfg: engine init failed — passthrough\n");
+            p->degrade_warned = true;
+        }
+        p->engine_failed = true;
+        p->passthrough = true;
+        snprintf(p->pt_reason, sizeof(p->pt_reason), "engine");
+        p->have_prev = false;
+        if (++p->status_emit >= VFG_STATUS_EVERY) {
+            p->status_emit = 0;
+            vfg_status(f, p);
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    p->video_w = in_w;
+    p->video_h = in_h;
+    double out_fps = p->k * p->src_fps;
+
+    // ── 5. first frame: output directly (the starting point of the
+    //    keep-source-frame semantics; its content becomes the next pair's
+    //    prev) ────────────────────────────────────────────────────────────
+    if (!p->have_prev) {
+        double t0 = vfg_now_ms();
+        if (!stage_input(f, p, cur, 1)) {
+            cuCtxPopCurrent(NULL);
+            talloc_free(cur);
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+        p->prev_pts = t_cur;
+        p->have_prev = true;
+        // Output frame rate = K×source frame rate (isomorphic to the later
+        // output frames; same as vf_rife's first frame).
+        // When src_fps is unknown keep the source frame's value, and never
+        // write 1.0/0 = inf.
+        if (out_fps > 0) {
+            cur->nominal_fps = out_fps;
+            cur->pkt_duration = 1.0 / out_fps;
+        }
+        MP_DBG(f, "vfg: first frame pts=%.4f kept (%dx%d k=%d mode=%s)\n",
+               t_cur, in_w, in_h, p->k, vfg_mode_name(p->vfg_mode));
+        vfg_account(f, p, t0);
+        cuCtxPopCurrent(NULL);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // ── 6. pair start: prev moves into in_img[0], cur into in_img[1] ────
+    // SetImage is only called once, before Load (the probe sequence), and the
+    // binding of SrcImage0/SrcImage1 to the buffers is fixed; so two D2D copies
+    // keep the "SrcImage0=prev / SrcImage1=cur" roles unchanged (in_img[1]
+    // holds the previous frame's cur, i.e. this pair's prev).
+    if (!copy_d2d(f, p, p->vfg.in_pixels[0], (size_t)p->vfg.in_pitch[0],
+                  p->vfg.in_pixels[1], (size_t)p->vfg.in_pitch[1],
+                  p->video_w, p->video_h) ||
+        !stage_input(f, p, cur, 1)) {
+        cuCtxPopCurrent(NULL);
+        talloc_free(cur);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+
+    p->pending_cur = cur;   // ownership handed over from the pin frame
+    p->cur_pts = t_cur;
+    p->emit_i = 1;
+
+    bool ok = emit_pair_output(f, p);
+    cuCtxPopCurrent(NULL);
+    if (!ok) {
+        talloc_free(p->pending_cur);
+        p->pending_cur = NULL;
+        p->have_prev = false;
+        mp_filter_internal_mark_failed(f);
+    }
+}
+
+// ── vfg_command (vf-command vfg fps X / mode Y; modelled on vf_rife.c
+//    rife_command) ───────────────────────────────────────────────────────
+
+static bool parse_fps_arg(const char *arg, int *out)
+{
+    if (!strcmp(arg, "off")) { *out = -1; return true; }
+    if (!strcmp(arg, "auto")) { *out = VFG_FPS_AUTO; return true; }
+    char *end = NULL;
+    long v = strtol(arg, &end, 10);
+    if (!end || *end || v < VFG_FPS_OPT_MIN || v > VFG_FPS_OPT_MAX)
+        return false;
+    *out = (int)v;
+    return true;
+}
+
+static bool parse_mode_arg(const char *arg, int *out)
+{
+    if (!strcmp(arg, "low"))         *out = 0;
+    else if (!strcmp(arg, "medium")) *out = 1;
+    else if (!strcmp(arg, "high"))   *out = 2;
+    else *out = atoi(arg);
+    return *out >= 0 && *out <= 2;   // no auto: illegal values (including "auto") are always rejected
+}
+
+static bool parse_max_fps_arg(const char *arg, int *out)
+{
+    char *end = NULL;
+    long v = strtol(arg, &end, 10);
+    if (!end || *end || v < 0 || v > VFG_MAX_FPS_LIMIT_MAX)
+        return false;
+    *out = (int)v;
+    return true;
+}
+
+static bool vfg_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT || !cmd->arg)
+        return false;
+    if (strcmp(cmd->cmd, "fps") == 0) {
+        int v;
+        if (!parse_fps_arg(cmd->arg, &v))
+            return false;
+        if (p->opts->fps != v) {
+            MP_INFO(f, "vfg: fps %d -> %d (vf-command)\n", p->opts->fps, v);
+            p->opts->fps = v;
+            // continuity broken: reset the scheduling state (engine kept), the
+            // next frame restarts on the new multiplier
+            f_reset(f);
+        }
+        return true;
+    }
+    if (strcmp(cmd->cmd, "mode") == 0) {
+        int v;
+        if (!parse_mode_arg(cmd->arg, &v))
+            return false;
+        if (p->opts->mode != v) {
+            MP_INFO(f, "vfg: mode %d -> %d (vf-command)\n", p->opts->mode, v);
+            p->opts->mode = v;
+            // Mode needs a re-Load: on the next frame ensure_vfg sees vfg_mode
+            // differ → rebuild
+        }
+        return true;
+    }
+    if (strcmp(cmd->cmd, "max-fps") == 0) {
+        int v;
+        if (!parse_max_fps_arg(cmd->arg, &v))
+            return false;
+        if (p->opts->max_fps != v) {
+            MP_INFO(f, "vfg: max-fps %d -> %d (vf-command)\n",
+                    p->opts->max_fps, v);
+            p->opts->max_fps = v;
+            // No reset needed: the passthrough decision is re-evaluated on the
+            // next frame; if recovering from passthrough, have_prev was already
+            // cleared in the passthrough branch, so it restarts as a "new pair"
+            // (seamless).
+        }
+        return true;
+    }
+    return false;
+}
+
+// ── f_reset ────────────────────────────────────────────────────────────────
+
+static void f_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    // Only clears the scheduling state. **The engine is kept**: VFG is handed
+    // both frames explicitly on every Run (no cross-pair engine state
+    // requirement), and a re-Load is expensive (model initialisation of a 218MB
+    // library) — same as vf_rife's f_reset (engine kept across
+    // seeks/switches).
+    if (p->pending_cur) {
+        talloc_free(p->pending_cur);
+        p->pending_cur = NULL;
+    }
+    p->have_prev = false;
+    p->prev_pts = 0;
+    p->cur_pts = 0;
+    p->emit_i = 0;
+    p->frame_count = 0;
+    p->status_frames = 0;
+    p->status_cost_ms = 0;
+    p->status_emit = 0;
+    p->passthrough = (p->opts->fps == -1);
+    if (p->passthrough)
+        snprintf(p->pt_reason, sizeof(p->pt_reason), "off");
+    // Engine downgrade reset (init may be retried after a file change / a
+    // parameter change)
+    p->degrade_warned = false;
+    p->engine_failed = false;
+    MP_INFO(f, "vfg: reset\n");
+}
+
+// ── f_destroy ──────────────────────────────────────────────────────────────
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (p->pending_cur) {
+        talloc_free(p->pending_cur);
+        p->pending_cur = NULL;
+    }
+
+    bool ctx_pushed = false;
+    if (p->cuda_ref && p->cuda_ref->ctx) {
+        CUresult cr = cuCtxPushCurrent(p->cuda_ref->ctx);
+        ctx_pushed = (cr == CUDA_SUCCESS);
+    }
+
+    vfg_destroy(&p->vfg);      // internally waits for in-flight Runs to finish
+    p->vfg_configured = false;
+
+    if (p->yuv_conv_ready) {
+        yuv_to_rgba_destroy(&p->yuv_conv);
+        p->yuv_conv_ready = false;
+    }
+
+    if (p->out_buf) {
+        if (ctx_pushed) cuMemFree(p->out_buf);
+        p->out_buf      = 0;
+        p->out_buf_size = 0;
+    }
+
+    if (p->cuda_init_done) {
+        if (ctx_pushed) cuStreamDestroy(p->cuda_stream);
+        p->cuda_stream = NULL;
+    }
+
+    if (ctx_pushed)
+        cuCtxPopCurrent(NULL);
+
+    // frames/device carrier release must happen with nothing pushed: its uninit
+    // may cuCtxDestroy (FFmpeg's self-created ctx / hwdec carrier).
+    if (p->av_hw_frames) {
+        av_buffer_unref(&p->av_hw_frames);
+        p->av_hw_frames = NULL;
+    }
+    if (p->av_hw_device) {
+        av_buffer_unref(&p->av_hw_device);
+        p->av_hw_device = NULL;
+    }
+    if (p->cuda_ref) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+    }
+    p->cuda_init_done = false;
+}
+
+// ── vf_vfg_filter_info ─────────────────────────────────────────────────────
+
+static const struct mp_filter_info vf_vfg_filter = {
+    // ★ .name is also mpv's log module name (filters/filter.c builds the
+    //   prefix from info->name); the client's --benchmark setting
+    //   msg-level=all=no,vfg=status depends on it.
+    .name      = "vfg",
+    .priv_size = sizeof(struct priv),
+    .process   = f_process,
+    .reset     = f_reset,
+    .destroy   = f_destroy,
+    .command   = vfg_command,
+};
+
+// ── vf_vfg_create ──────────────────────────────────────────────────────────
+
+static struct mp_filter *vf_vfg_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_vfg_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    // Initial value fixed at startup; re-evaluated every frame (vf-command hot
+    // updates)
+    p->passthrough = (p->opts->fps == -1);
+    snprintf(p->pt_reason, sizeof(p->pt_reason), "off");
+    return f;
+}
+
+// ── Registration ───────────────────────────────────────────────────────────
+
+const struct mp_user_filter_entry vf_vfg = {
+    .desc = {
+        .name          = "vfg",
+        .description   = "AI frame interpolation via NVIDIA VFX SDK VideoFrameGeneration",
+        .priv_size     = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &vf_vfg_opts_def,
+        .options       = vf_opts_fields,
+    },
+    .create = vf_vfg_create,
+};
diff --git a/video/filter/vf_vsr.c b/video/filter/vf_vsr.c
new file mode 100644
index 000000000..f377ee250
--- /dev/null
+++ b/video/filter/vf_vsr.c
@@ -0,0 +1,1338 @@
+/*
+ * vf_vsr.c -- Video Super Resolution filter via NVIDIA VFX SDK
+ *
+ * Input contract: only CUDA frames are processed (SW→HW unification is the job
+ * of vf_hwup in the chain, see its header comment "rife/vsr no longer need
+ * their own SW support"). Non-CUDA frames always pass through — the
+ * early self-contained software-decode upload branch was removed (issue #12
+ * defect 6: it rebuilt the CUDA context every frame, invalidating the VSR
+ * engine's in_pixels → segfault on the second frame).
+ * HW CUDA/RGBA: D2D copy into the engine input buffer
+ * HW CUDA/YUV:  yuv_to_rgba D2D
+ *
+ * Filter options:
+ *   scale:   off | auto | 2 | 3 | 4            (default: auto)
+ *   denoise: off | low | medium | high | ultra  (default: off)
+ *   quality: low | medium | high | ultra        (default: high)
+ */
+
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+#include "video/sws_utils.h"
+#include "video/image_writer.h"
+#include "options/m_option.h"
+#include "common/msg.h"
+#include "common/common.h"
+#include "mpv/client.h"   // struct mpv_node (set/get for custom option types)
+
+#include <libavcodec/avcodec.h>
+
+#include <cuda.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "vsr_internal.h"
+#include "cuda_shared.h"
+
+#include <time.h>
+
+static double vsr_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+// ── Options ────────────────────────────────────────────────────────────────
+
+struct vf_vsr_opts {
+    float scale;   // -1=off, 0=auto, multiplier (SDK supported set: 4/3, 1.5, 2, 3, 4)
+    int quality;   // 1-4
+    int denoise;   // -1=off, 8-11
+};
+
+// ── scale option type (off/auto strings + numeric/ratio floats) ─────────
+// mpv 0.41 has no OPT_CHOICE_OR_FLOAT: a custom m_option_type makes the
+// strings "off"/"auto" (the standalone mpv-vsr CLI passes
+// `--vf=vsr:scale=auto` directly) equivalent to numbers/ratios. The numeric
+// path follows upstream parse_numeric semantics (including "4:3"/"4/3"
+// ratios; the SDK supports non-integer 4/3x and 1.5x, measured in
+// vfx_test6).
+// print always outputs a number (off/auto are input aliases only).
+
+static int vsr_scale_clamp(const m_option_t *opt, double *val)
+{
+    double v = *val;
+    int r = 0;
+    if (opt->min < opt->max) {
+        if (v > opt->max) { v = opt->max; r = M_OPT_OUT_OF_RANGE; }
+        if (v < opt->min) { v = opt->min; r = M_OPT_OUT_OF_RANGE; }
+    }
+    if (!isfinite(v) && v != opt->max && v != opt->min) {
+        v = opt->min;
+        r = M_OPT_OUT_OF_RANGE;
+    }
+    *val = v;
+    return r;
+}
+
+static int vsr_scale_parse(struct mp_log *log, const m_option_t *opt,
+                           struct bstr name, struct bstr param, void *dst)
+{
+    double v;
+    if (bstr_equals0(param, "off")) {
+        v = -1.0;
+    } else if (bstr_equals0(param, "auto")) {
+        v = 0.0;
+    } else {
+        if (param.len == 0)
+            return M_OPT_MISSING_PARAM;
+        struct bstr rest;
+        v = bstrtod(param, &rest);
+        if (bstr_eatstart0(&rest, ":") || bstr_eatstart0(&rest, "/"))
+            v /= bstrtod(rest, &rest);
+        if (rest.len) {
+            mp_err(log, "The %.*s option must be a floating point number or a "
+                   "ratio (numerator[:/]denominator): %.*s\n",
+                   BSTR_P(name), BSTR_P(param));
+            return M_OPT_INVALID;
+        }
+    }
+    if (vsr_scale_clamp(opt, &v) < 0) {
+        mp_err(log, "The %.*s option is out of range: %.*s\n",
+               BSTR_P(name), BSTR_P(param));
+        return M_OPT_OUT_OF_RANGE;
+    }
+    if (dst)
+        *(float *)dst = (float)v;
+    return 1;
+}
+
+static char *vsr_scale_print(const m_option_t *opt, const void *val)
+{
+    return talloc_asprintf(NULL, "%f", *(const float *)val);
+}
+
+static void vsr_scale_copy(const m_option_t *opt, void *dst, const void *src)
+{
+    if (dst && src)
+        memcpy(dst, src, sizeof(float));
+}
+
+static int vsr_scale_set(const m_option_t *opt, void *dst, struct mpv_node *src)
+{
+    double v;
+    if (src->format == MPV_FORMAT_INT64)
+        v = (double)src->u.int64;
+    else if (src->format == MPV_FORMAT_DOUBLE)
+        v = src->u.double_;
+    else if (src->format == MPV_FORMAT_FLAG)
+        v = src->u.flag ? 1.0 : 0.0;
+    else
+        return M_OPT_INVALID;
+    if (vsr_scale_clamp(opt, &v) < 0)
+        return M_OPT_OUT_OF_RANGE;
+    *(float *)dst = (float)v;
+    return 1;
+}
+
+static int vsr_scale_get(const m_option_t *opt, void *ta_parent,
+                         struct mpv_node *dst, void *src)
+{
+    dst->format = MPV_FORMAT_DOUBLE;
+    dst->u.double_ = *(const float *)src;
+    return 1;
+}
+
+static bool vsr_scale_equal(const m_option_t *opt, void *a, void *b)
+{
+    return memcmp(a, b, sizeof(float)) == 0;
+}
+
+static const m_option_type_t m_option_type_vsr_scale = {
+    .name  = "Scale",
+    .flags = M_OPT_TYPE_USES_RANGE,
+    .size  = sizeof(float),
+    .parse = vsr_scale_parse,
+    .print = vsr_scale_print,
+    .copy  = vsr_scale_copy,
+    .set   = vsr_scale_set,
+    .get   = vsr_scale_get,
+    .equal = vsr_scale_equal,
+};
+
+#define OPT_BASE_STRUCT struct vf_vsr_opts
+
+static const struct m_option vf_opts_fields[] = {
+    {"scale",   OPT_TYPED_FIELD(m_option_type_vsr_scale, float, scale),
+                M_RANGE(-1, 4)},
+    {"denoise", OPT_CHOICE(denoise,
+        {"off", -1}, {"low", 8}, {"medium", 9}, {"high", 10}, {"ultra", 11}),
+        M_RANGE(-1, 11)},
+    {"quality", OPT_CHOICE(quality,
+        {"low", 1}, {"medium", 2}, {"high", 3}, {"ultra", 4}),
+        M_RANGE(1, 4)},
+    {0}
+};
+
+static const struct vf_vsr_opts vf_vsr_opts_def = {
+    .scale   = 0,
+    .quality = 3,
+    .denoise = -1,
+};
+
+// ── Filter private state ───────────────────────────────────────────────────
+
+/// CUDA context ownership — shared struct (cuda_shared.h), carried as the
+/// opaque of each output frame's bufs[0]. Three modes:
+///   - borrow upstream shared struct (hwup/rife output frames): acquire the
+///     same struct — the context stays alive while ANY frame in the chain
+///     references it (frames can outlive the filter: pin teardown frees
+///     frames AFTER f_destroy ran — use-after-free otherwise)
+///   - borrow hwdec context (decoder frames, opaque not ours): own struct +
+///     ctx_holder (av_buffer_ref of the frame hwctx), released on last ref
+///   - SW input fallback: self-created context (owned=true), destroyed on
+///     last release
+struct priv {
+    struct vf_vsr_opts *opts;
+
+    struct mp_cuda_ctx_ref *cuda_ref;
+    CUstream  cuda_stream;
+    bool      cuda_init_done;
+
+    AVBufferRef *av_hw_device;   // SW path: CUDA device ctx (self-created)
+    AVBufferRef *av_hw_frames;   // SW path: CUDA/RGBA frames ctx for output
+    CUcontext    av_hw_frames_ctx;  // ctx av_hw_frames was created on
+
+    struct vsr_context vsr;
+    bool      vsr_configured;
+
+    // yuv→rgba D2D
+    struct yuv_to_rgba    yuv_conv;
+    bool                  yuv_conv_ready;
+    int                   yuv_conv_bd;
+    int                   yuv_conv_bits;   // output bit depth (8/10)
+    enum yuv_matrix       yuv_conv_matrix;
+    enum yuv_range        yuv_conv_range;
+
+    CUdeviceptr out_buf;
+    size_t      out_buf_size;
+    int         out_w, out_h, out_pitch;
+
+    int video_w, video_h;
+    float effective_scale;
+
+    bool passthrough;
+    bool warmup_done;
+    int  frame_count;
+    // vsr-status (every 30 frames): processing cost + rate
+    double status_t0;
+    int    status_frames;
+    double status_cost_ms;
+    int    status_emit;        // passthrough branch output counter (every 30 frames)
+    bool   sw_warned;          // software-decode input passthrough warns only once (like vf_rife.sw_warned)
+    // Frames before the seek target are dropped outright (0 = disabled): mpv's
+    // hr-seek framedrop only drops per packet at the decoder layer, and for
+    // some streams (packet pts judged broken, etc.) the frames between the key
+    // frame and the target still enter the filter chain; they are ultimately
+    // dropped at the VO, so running VSR on them is wasted work (measured: one
+    // seek wasted ~28 frames × 6 ms). Before starting an absolute seek the
+    // client announces the target with `vf-command vsr seek-target <seconds>`;
+    // every frame whose pts is below the target is dropped, and the marker
+    // expires automatically after 3 s (or is overwritten by the next seek).
+    double skip_before_pts;
+    double skip_expire_ms;     // marker expiry time (avoids dropping frames forever when a seek fails)
+    int    skip_count;         // how many frames this marker dropped (for diagnostic logs)
+    bool   skip_passed;        // target already passed (lets the "reached" log print only once)
+};
+
+// ── compute_adaptive_scale ─────────────────────────────────────────────────
+
+static float compute_adaptive_scale(int phys_w, int phys_h,
+                                   int video_w, int video_h)
+{
+    if (video_w <= 0 || video_h <= 0) return 1.0f;
+
+    // Minimum required multiplier: the VSR output target is to cover the
+    // **display area** (the area after the video's aspect fit into the
+    // viewport; letterbox/pillarbox bars do not count as demand) — display
+    // area/video = min(phys_w/video_w, phys_h/video_h) (the scale that just
+    // fits in both dimensions).
+    // Taking max is wrong: for widescreen video (e.g. 3840×1600 in a 2160p
+    // viewport) the 1.35 in the height direction is letterbox bar, not a real
+    // upscale demand (measured: auto wrongly produced 1.5×).
+    double need_w = (double)phys_w / video_w;
+    double need_h = (double)phys_h / video_h;
+    double need = (need_w < need_h) ? need_w : need_h;
+
+    // Display area ≤ video (no upscale needed) → 1:1 (passthrough / denoise)
+    if (need <= 1.0) return 1.0f;
+
+    // Pick the smallest satisfying entry from the SDK's supported set —
+    // non-integer multipliers (4/3, 1.5) avoid integer-ceil oversampling
+    // (e.g. 1366×768 window + 720p: 1.07 → 4/3x instead of 2x).
+    // The chosen multiplier is still subject to f_process's support matrix
+    // (4x ≤ 540p etc.).
+    static const float supported[] = {4.0f / 3.0f, 1.5f, 2.0f, 3.0f, 4.0f};
+    for (size_t i = 0; i < sizeof(supported) / sizeof(supported[0]); i++)
+        if (need <= supported[i]) return supported[i];
+    return 4.0f;   // very large window: highest multiplier (falls back in f_process when above the matrix limit)
+}
+
+// ── resolve_scale ──────────────────────────────────────────────────────────
+
+static float resolve_scale(struct mp_filter *f, struct priv *p,
+                          int video_w, int video_h)
+{
+    if (p->opts->scale == -1) return 1.0f;  // denoise only: 1:1
+    if (p->opts->scale > 0)  return p->opts->scale;
+
+    // scale == 0: auto — requires render target size from VO
+    // (window for wayland/x11 VOs, render target for vo_libmpv)
+    struct mp_stream_info *info = mp_filter_find_stream_info(f);
+    int res[2] = {0};
+    if (info && info->get_render_target_size)
+        info->get_render_target_size(info, res);
+    if (res[0] <= 0 || res[1] <= 0)
+        return p->effective_scale;  // not yet available — keep current
+
+    return compute_adaptive_scale(res[0], res[1], video_w, video_h);
+}
+
+// ── CUDA context setup ─────────────────────────────────────────────────────
+// Single-context design (CUDA best practice): all filter work shares ONE
+// driver context (multiple contexts in one process time-slice on the GPU and
+// hung the device when vf_rife's TensorRT context ran concurrently with
+// VSR). The context comes from three sources, all backed by the shared
+// refcounted struct (cuda_shared.h):
+//   1. upstream frames carry OUR shared struct (hwup output / rife output) →
+//      acquire it — the ctx stays alive while any frame references it
+//   2. hwdec decoder frames (opaque not ours) → borrower struct with
+//      ctx_holder (frame hwctx ref)
+//   3. software frames (no hwctx) → self-created context (owned)
+//
+// GPU serialization with vf_rife: each filter synchronizes its own stream at
+// the end of processing. The mpv filter chain is host-serial (pull model),
+// so rife's pair work and VSR's frame work alternate strictly on the GPU —
+// no concurrent saturation, no device-level sync (which would also wait for
+// the VO's stream-0 copies and can deadlock — Xid 109 lesson).
+
+static bool ensure_cuda(struct mp_filter *f, struct priv *p,
+                        struct mp_image *mpi)
+{
+    CUcontext borrow = mp_cuda_ctx_from_mpi(mpi);  // NULL = SW frame
+
+    // fast path: binding unchanged. `owned` marks the struct's CREATOR
+    // (destruction semantics), not the binding kind — a borrowed upstream
+    // struct may be owned by hwup. Compare the driver context only.
+    if (p->cuda_ref) {
+        if (p->cuda_ref->ctx == borrow)
+            return true;
+    }
+
+    CUresult cr = cuInit(0);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "cuInit failed (%d)\n", cr);
+        return false;
+    }
+
+    // (re)bind: release the old context (frames in flight keep it alive via
+    // their refs), then adopt the new one.
+    // ⚠ All CUDA resources are bound to the context **that created them**: the
+    // engine (CUmodule/engine handles), yuv_to_rgba's NVRTC module, this
+    // filter's stream, out_buf. The old code destroyed only the stream and
+    // after switching hwdec (software↔hardware decode, upstream context swap)
+    // still reused the old engine/kernel → cuLaunchKernel returns 400
+    // (CUDA_ERROR_INVALID_VALUE) → this filter gets disabled by mpv (measured
+    // 2026-10-17: switching to software decode made VSR fail immediately, and
+    // switching back to hardware decode made VFG fail too → "frame generation
+    // broken").
+    // They must therefore all be invalidated inside the old context, and
+    // rebuilt on demand in the new context on the next frame.
+    if (p->cuda_ref) {
+        CUcontext old = p->cuda_ref->ctx;
+        if (old) cuCtxPushCurrent(old);
+        if (p->vsr_configured) {
+            vsr_destroy(&p->vsr);
+            p->vsr_configured = false;
+        }
+        if (p->yuv_conv_ready) {
+            yuv_to_rgba_destroy(&p->yuv_conv);
+            p->yuv_conv_ready = false;
+        }
+        if (p->out_buf) {
+            cuMemFree(p->out_buf);
+            p->out_buf = 0;
+            p->out_buf_size = 0;
+        }
+        if (p->cuda_init_done && p->cuda_stream) {
+            cuStreamDestroy(p->cuda_stream);
+            p->cuda_stream = NULL;
+            p->cuda_init_done = false;
+        }
+        if (old) cuCtxPopCurrent(NULL);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        MP_VERBOSE(f, "vsr: CUDA context changed — engine/converter reset\n");
+    }
+
+    struct mp_cuda_ctx_ref *shared = mp_cuda_ctx_ref_from_mpi(mpi);
+    if (shared) {
+        // shared struct of the upstream chain (hwup/rife output): acquire the
+        // same struct
+        mp_cuda_ctx_ref_acquire(shared);
+        p->cuda_ref = shared;
+        MP_VERBOSE(f, "vsr: sharing upstream CUDA context\n");
+    } else if (borrow) {
+        // hwdec frame (opaque is not this chain's shared struct): build our own
+        // borrower struct + ctx_holder
+        p->cuda_ref = calloc(1, sizeof(*p->cuda_ref));
+        p->cuda_ref->magic = MP_CUDA_CTX_REF_MAGIC;
+        p->cuda_ref->ctx = borrow;
+        p->cuda_ref->owned = false;
+        p->cuda_ref->ctx_holder = av_buffer_ref(mpi->hwctx);
+        if (!p->cuda_ref->ctx_holder) {
+            MP_ERR(f, "vsr: failed to hold hwdec frame ref\n");
+            free(p->cuda_ref);
+            p->cuda_ref = NULL;
+            return false;
+        }
+        atomic_init(&p->cuda_ref->refs, 1);
+        MP_VERBOSE(f, "vsr: sharing hwdec CUDA context\n");
+    } else {
+        // Software frames already pass through in f_process (contract: SW→HW is
+        // vf_hwup's job), so reaching this point means the upstream state is
+        // abnormal — do not create a context here (the old implementation
+        // rebuilt it every frame → engine in_pixels invalidated, issue #12
+        // defect 6).
+        MP_ERR(f, "vsr: no CUDA context from input (software frame past passthrough)\n");
+        return false;
+    }
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    // It must be a **blocking stream** (the default cudaStreamCreate semantics
+    // laid down by the official "Setting Up the CUDA Stream";
+    // NvVFX_CudaStreamCreate is visibly just one cudaStreamCreate in
+    // disassembly):
+    // VFX 1.3 internally has a stage permanently attached to the legacy default
+    // stream (1.1 has no such mechanism), and a non-blocking stream has **no
+    // implicit ordering** with the legacy stream → the engine reads input that
+    // has not landed yet, showing up as every output frame carrying the
+    // previous frame, compounded by non-deterministic duplicate/skipped source
+    // frames (build/scratch/probe/BLOCKING_REPORT.md,
+    // build/scratch/player-lag/BEFORE.md). A blocking stream has implicit
+    // synchronisation with the legacy stream, and the whole chain (colour
+    // conversion → input transfer → super-resolution → output transfer)
+    // completes in order on this stream.
+    // ⚠️ The output must be read back on this stream; reading on another stream
+    // requires your own synchronisation.
+    cr = cuStreamCreate(&p->cuda_stream, CU_STREAM_DEFAULT);
+    cuCtxPopCurrent(NULL);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "cuStreamCreate failed (%d)\n", cr);
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+        return false;
+    }
+
+    p->cuda_init_done = true;
+    return true;
+}
+
+// ── AVHWFramesContext for CUDA/RGBA output ─────────────────────────────────
+// Output frames carry a self-created RGBA frames ctx (NOT a borrow of the
+// input's NV12/P010 hwctx): hwdownload parses frame data per hwctx sw_format
+// — an NV12 hwctx under an RGBA frame crashes on the SW-input download path
+// (no hwdec → VO lacks CUDA interop → chain-tail hwdownload). Shared helper
+// in cuda_shared.h (mp_cuda_ensure_frames).
+
+static bool ensure_av_hw_frames(struct mp_filter *f, struct priv *p,
+                                 int w, int h, int bits)
+{
+    if (!p->cuda_init_done) return false;
+    bool had = p->av_hw_frames != NULL;
+    // ⚠ hw_frames_ctx's sw_format is always AV_PIX_FMT_RGBA: FFmpeg's CUDA
+    // hwframes does not support x2rgb10 (measured with
+    // build/scratch/hwf_test.c: rgba/bgra/rgb0 ok, x2rgb10le "Pixel format not
+    // supported").
+    // Both are 4 bytes/px with the same stride, so the buffer semantics agree;
+    // the 10-bit **real format** is carried by the frame parameter
+    // hw_subfmt=IMGFMT_X2RGB10 (the VO's CUDA interop picks the VkFormat by
+    // hw_subfmt and uses pixel_size=4 for the copy width — hwdec_cuda.c:255
+    // "plane_w * format->pixel_size", independent of sw_format).
+    // The only affected case is the hwdownload software path (this application
+    // never takes it): there it would be parsed as RGBA bytes per sw_format and
+    // 10-bit data would be shown as 8-bit.
+    if (!mp_cuda_ensure_frames(f->log, p->cuda_ref->ctx, AV_PIX_FMT_RGBA,
+                               w, h, &p->av_hw_device, &p->av_hw_frames,
+                               &p->av_hw_frames_ctx))
+        return false;
+    if (!had)
+        MP_VERBOSE(f, "vsr: CUDA/4Bpp hw_frames_ctx %dx%d (%d-bit data)\n",
+                   w, h, bits);
+    return true;
+}
+
+// ── VSR init / reconfigure ─────────────────────────────────────────────────
+
+static bool ensure_vsr(struct mp_filter *f, struct priv *p,
+                        int in_w, int in_h, int out_w, int out_h,
+                        int quality, int bits)
+{
+    if (p->vsr_configured && p->vsr.bits != bits) {
+        // A bit depth change (8↔10) must rebuild: ImageEncodingMode + image
+        // formats are all bound to Load, they cannot be hot-updated.
+        MP_INFO(f, "vsr: bit depth %d -> %d (engine rebuild)\n",
+                p->vsr.bits, bits);
+        vsr_destroy(&p->vsr);
+        p->vsr_configured = false;
+    }
+    if (p->vsr_configured) {
+        // ── engine exists: prefer a lightweight hot update, rebuild only on
+        //    an input change ───────────────────────────────────────────
+        // All sizes equal → lightweight quality (vfx_test5: SetU32 takes
+        // effect).
+        // Input unchanged, output only → vsr_set_output swaps the output
+        // buffer (vfx_outchange_test + player frame number dump: PSNR 999dB
+        // byte-identical) — a fullscreen switch (input unchanged) avoids an
+        // engine rebuild.
+        // Input change → rebuild (a real player changing files makes mpv
+        // rebuild the whole filter chain, so the engine is inevitably rebuilt
+        // + warmup; this is the defensive path for an input change inside the
+        // same filter).
+        bool in_same = (p->vsr.in_w == in_w && p->vsr.in_h == in_h);
+        bool out_same = (p->vsr.out_w == out_w && p->vsr.out_h == out_h);
+        if (in_same && out_same) {
+            if (p->vsr.quality != quality) {
+                if (!vsr_set_quality(&p->vsr, quality))
+                    return false;
+            }
+            return true;
+        }
+        if (in_same) {
+            // Output size only: SetImage swaps the output buffer as a hot
+            // update (no rebuild, vsr_set_output quality verification
+            // conclusion — PSNR 999dB byte-identical).
+            if (!vsr_set_output(&p->vsr, out_w, out_h))
+                return false;
+            if (p->vsr.quality != quality) {
+                if (!vsr_set_quality(&p->vsr, quality))
+                    return false;
+            }
+            return true;
+        } else {
+            vsr_destroy(&p->vsr);
+            p->vsr_configured = false;
+        }
+    }
+
+    // engine absent (filter newly created / rebuild after size change /
+    // switching back from passthrough): init
+    MP_INFO(f, "vsr: init %dx%d -> %dx%d quality=%d bits=%d\n",
+               in_w, in_h, out_w, out_h, quality, bits);
+    if (!vsr_init(&p->vsr, in_w, in_h, out_w, out_h, quality, bits,
+                  p->cuda_stream)) {
+        MP_ERR(f, "vsr_init failed\n");
+        return false;
+    }
+    p->vsr_configured = true;
+
+    if (!p->warmup_done) {
+        if (!vsr_warmup(&p->vsr, p->cuda_stream)) {
+            MP_ERR(f, "vsr_warmup failed\n");
+            return false;
+        }
+        p->warmup_done = true;
+        MP_VERBOSE(f, "vsr: warmup complete\n");
+    }
+    return true;
+}
+
+// ── Allocate/realloc owned output buffer ───────────────────────────────────
+
+static bool ensure_out_buf(struct mp_filter *f, struct priv *p,
+                            int out_w, int out_h, int out_pitch)
+{
+    size_t needed = (size_t)out_pitch * out_h;
+    if (p->out_buf && p->out_buf_size >= needed) {
+        p->out_w     = out_w;
+        p->out_h     = out_h;
+        p->out_pitch = out_pitch;
+        return true;
+    }
+
+    if (p->out_buf) {
+        cuMemFree(p->out_buf);
+        p->out_buf = 0;
+        p->out_buf_size = 0;
+    }
+
+    CUresult cr = cuMemAlloc(&p->out_buf, needed);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "cuMemAlloc(out) failed (%d)\n", cr);
+        return false;
+    }
+    p->out_buf_size = needed;
+    p->out_w     = out_w;
+    p->out_h     = out_h;
+    p->out_pitch = out_pitch;
+    return true;
+}
+
+// ── AVBufferRef free callback for CUDA memory ──────────────────────────────
+
+static void mp_image_dtor(void *ptr)
+{
+    struct mp_image *mpi = ptr;
+    for (int p = 0; p < MP_MAX_PLANES; p++)
+        av_buffer_unref(&mpi->bufs[p]);
+    av_buffer_unref(&mpi->hwctx);
+    av_buffer_unref(&mpi->icc_profile);
+    av_buffer_unref(&mpi->a53_cc);
+    av_buffer_unref(&mpi->dovi);
+    av_buffer_unref(&mpi->film_grain);
+    for (int n = 0; n < mpi->num_ff_side_data; n++)
+        av_buffer_unref(&mpi->ff_side_data[n].buf);
+}
+
+static void free_cuda_buf(void *opaque, uint8_t *data)
+{
+    struct mp_cuda_ctx_ref *r = opaque;
+    if (r && r->ctx) cuCtxPushCurrent(r->ctx);
+    // No stream sync here. The frame is only released after the VO replaced
+    // it with a newer render (retained-frame semantics), so the VO's map
+    // copies of this buffer completed before we get here; vf_vsr's own copy
+    // is drained by the per-frame stream sync. A cuStreamSynchronize(0)
+    // would now wait on the SHARED context's stream 0 — which carries the
+    // render thread's map copies — throttling the video thread to the
+    // render loop's pace (GPU drops to ~idle, measured in benchmark).
+    cuMemFree((CUdeviceptr)data);
+    if (r && r->ctx) cuCtxPopCurrent(NULL);
+    if (r)
+        mp_cuda_ctx_ref_release(r);
+}
+
+// ── yuv→rgba converter lifecycle ───────────────────────────────────────────
+
+static bool ensure_yuv_converter(struct mp_filter *f, struct priv *p,
+                                  int bit_depth, enum yuv_matrix matrix,
+                                  enum yuv_range range, int out_bits,
+                                  const struct mp_image_params *src)
+{
+    if (p->yuv_conv_ready &&
+        p->yuv_conv_bd == bit_depth &&
+        p->yuv_conv_bits == out_bits &&
+        p->yuv_conv_matrix == matrix &&
+        p->yuv_conv_range == range)
+        return true;
+
+    if (p->yuv_conv_ready)
+        yuv_to_rgba_destroy(&p->yuv_conv);
+
+    // HDR display debugging: print the matrix/range used for YUV→RGB together
+    // with the source frame's colour metadata (wrong matrix = BT.709
+    // coefficients solving BT.2020 → reddish, a measured suspect).
+    MP_INFO(f, "yuv->rgb: bd=%d out=%d matrix=%d range=%d | src sys=%d levels=%d "
+            "primaries=%d transfer=%d\n", bit_depth, out_bits, (int)matrix, (int)range,
+            (int)src->repr.sys, (int)src->repr.levels,
+            (int)src->color.primaries, (int)src->color.transfer);
+    if (!yuv_to_rgba_init(&p->yuv_conv, bit_depth, matrix, range, out_bits)) {
+        MP_ERR(f, "yuv_to_rgba_init failed (bd=%d out=%d)\n", bit_depth, out_bits);
+        p->yuv_conv_ready = false;
+        return false;
+    }
+
+    p->yuv_conv_bd = bit_depth;
+    p->yuv_conv_bits = out_bits;
+    p->yuv_conv_matrix = matrix;
+    p->yuv_conv_range = range;
+    p->yuv_conv_ready = true;
+    return true;
+}
+
+// ── Color matrix helpers (shared implementation of matrix_from_repr /
+//    range_from_levels in yuv_to_rgba.h — single source of truth) ────────
+
+// ── f_process ──────────────────────────────────────────────────────────────
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame;
+    struct mp_image *mpi;
+
+    // Frames before the seek target (key frame→target) are dropped outright:
+    // no engine run, no output written.
+    // ⚠ Must keep pulling **within the same process() call** (drop loop):
+    // earlier every dropped frame did mark_progress + return and let the filter
+    // graph call this function again, measuring ~0.3 ms of framework overhead
+    // per frame; long-GOP material can take 1500 frames per seek (25 s @60fps)
+    // → 450 ms. Dropping inside the loop leaves only the decode cost per frame
+    // (~0.1 ms).
+    // ⚠ The marker is **not cleared on the first frame >= target**: within one
+    // seek mpv first feeds the frames before the target and then, after the
+    // chain reset, feeds **the same batch again** (measured: 1–2 s worth,
+    // i.e. 60–130 frames, arriving 0–100 ms after the first qualifying frame).
+    // Clearing the marker early → that batch re-enters the engine (2.8 ms per
+    // frame) → 200–400 ms extra per seek, which is the other half of the
+    // "occasionally very slow" behaviour when holding an arrow key. So the
+    // marker stays until it expires: it only drops frames with pts < target,
+    // so normal playback is unaffected (one extra comparison per frame).
+    for (;;) {
+        if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+            return;
+        frame = mp_pin_out_read(f->ppins[0]);
+
+        if (mp_frame_is_signaling(frame)) {
+            mp_pin_in_write(f->ppins[1], frame);
+            return;
+        }
+
+        if (frame.type != MP_FRAME_VIDEO) {
+            MP_ERR(f, "vsr: non-video frame received\n");
+            mp_frame_unref(&frame);
+            mp_filter_internal_mark_failed(f);
+            return;
+        }
+
+        mpi = frame.data;
+        if (p->skip_before_pts <= 0.0)
+            break;
+
+        // Fallback: the marker is set but no frame >= target ever arrives
+        // (failed seek / live stream) → expire after 3 s so subsequent normal
+        // playback frames are not dropped forever.
+        if (vsr_now_ms() > p->skip_expire_ms) {
+            if (p->skip_count > 0)
+                MP_VERBOSE(f, "vsr: seek-target expired after %d skipped frames\n",
+                           p->skip_count);
+            p->skip_before_pts = 0.0;
+            p->skip_count = 0;
+            p->skip_passed = false;
+            break;
+        }
+
+        if (mpi->pts != MP_NOPTS_VALUE && mpi->pts < p->skip_before_pts - 0.005) {
+            p->skip_count++;
+            mp_frame_unref(&frame);
+            continue;
+        }
+
+        // First frame >= target (or a late frame after the target): process it
+        // as usual, the marker stays set.
+        if (!p->skip_passed) {
+            p->skip_passed = true;
+            MP_VERBOSE(f, "vsr: seek-target reached, skipped %d frames\n",
+                       p->skip_count);
+        }
+        break;
+    }
+
+    p->frame_count++;
+    double t0 = vsr_now_ms();   // processing timing start
+
+    // Path bit depth: the source subfmt is 10-bit packed RGB (upstream VFG) or
+    // the source bit depth is >8 (P010/P016) → 10-bit path (VFX
+    // ImageEncodingMode=1 + RGB10A2); otherwise keep the historical 8-bit
+    // behaviour (byte-for-byte unchanged, zero regression for SDR 8-bit
+    // content).
+    int bits = (mpi->imgfmt == IMGFMT_CUDA)
+                   ? vfx_bits_from_imgfmt(mpi->params.hw_subfmt)
+                   : VFX_BITS_8;
+
+    // Scale/resolution detection
+    int video_w = mpi->w;
+    int video_h = mpi->h;
+    if (video_w != p->video_w || video_h != p->video_h) {
+        p->video_w = video_w;
+        p->video_h = video_h;
+        p->warmup_done = false;
+    }
+    float new_scale = resolve_scale(f, p, video_w, video_h);
+    float eff = new_scale;
+    // No multiplier guard on input: the requested multiplier takes effect
+    // directly. The engine's actual hard limit is output ≤8K (measured 1080p
+    // 4×→7680×4320 succeeds); requests beyond the engine's capability are
+    // handled engine-side (NvVFX error path). auto (resolve_scale) results
+    // likewise take effect directly.
+    int out_w = lrintf(video_w * eff);
+    int out_h = lrintf(video_h * eff);
+
+    if (fabsf(eff - p->effective_scale) > 0.001f) {
+        MP_INFO(f, "vsr: scale changed %.2f -> %.2f (video %dx%d)\n",
+                p->effective_scale, eff, video_w, video_h);
+        p->effective_scale = eff;
+        // A size change is handled by ensure_vsr rebuilding the engine (SDK
+        // experiment: SetImage swapping size produces corrupted output, the
+        // tile split is bound to the size at Load).
+    }
+
+    // ── Passthrough — re-evaluated per-frame (dynamic effective_scale) ──
+    // scale=-1 makes resolve_scale return 1 (denoise-only 1:1) — covered by
+    // effective_scale==1 already; with denoise enabled passthrough is not
+    // allowed (the 1:1 denoise mode still has to run VSR).
+    // Non-CUDA frames (software-decode input with no hwup) likewise pass
+    // through — contract in the vf_hwup.c header comment: "so downstream
+    // rife/vsr only handle the HW path (rife/vsr no longer need their own SW
+    // support)".
+    // The software-decode upload branch vf_vsr used to carry was a leftover of
+    // that refactor: it rebuilt the context every frame in ensure_cuda, while
+    // the VSR engine's in_pixels still pointed at VRAM of the old context →
+    // segfault on the second frame (issue #12 defect 6: measured exit 139, the
+    // SEGV landing in cuMemcpy2DAsync). Handled per contract and the same way
+    // as vf_rife: one-off WARN + passthrough, no engine init, no CUDA touched.
+    const bool sw_input = (mpi->imgfmt != IMGFMT_CUDA);
+    if (sw_input && !p->sw_warned) {
+        MP_WARN(f, "vsr: software frames — passthrough (prepend @hwup for VSR)\n");
+        p->sw_warned = true;
+    }
+    p->passthrough = sw_input
+                  || (fabsf(p->effective_scale - 1.0f) < 0.001f && p->opts->denoise == -1);
+    if (p->passthrough) {
+        if (p->vsr_configured) {
+            cuCtxPushCurrent(p->cuda_ref->ctx);
+            vsr_destroy(&p->vsr);
+            cuCtxPopCurrent(NULL);
+            p->vsr_configured = false;
+            MP_INFO(f, "vsr: switching to passthrough (scale=%.2f, denoise=off)\n",
+                    p->effective_scale);
+        }
+        // Passthrough also emits a status line (mode=passthrough) — the OSD's
+        // VSR-ST line is driven by vsr-status, and not emitting it leaves the
+        // active-mode cost on screen (stale display).
+        // Low frequency (every 30 frames), the same cadence as the active path.
+        if (++p->status_emit >= 30) {
+            p->status_emit = 0;
+            mp_msg(f->log, MSGL_STATUS,
+                   "vsr-status: mode=passthrough scale=%.2f\n",
+                   p->effective_scale);
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (!ensure_cuda(f, p, mpi)) {
+        mp_frame_unref(&frame);
+        mp_filter_internal_mark_failed(f);
+        return;
+    }
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+
+    if (!ensure_vsr(f, p, video_w, video_h, out_w, out_h, p->opts->quality, bits)) {
+        // First failure: destroy the engine state and retry once (transient
+        // failures self-heal, e.g. GPU busy).
+        if (p->vsr_configured) {
+            cuCtxPushCurrent(p->cuda_ref->ctx);
+            vsr_destroy(&p->vsr);
+            cuCtxPopCurrent(NULL);
+            p->vsr_configured = false;
+        }
+        if (!ensure_vsr(f, p, video_w, video_h, out_w, out_h,
+                        p->opts->quality, bits)) {
+            MP_ERR(f, "vsr: init failed after retry\n");
+            mp_frame_unref(&frame);
+            mp_filter_internal_mark_failed(f);
+            cuCtxPopCurrent(NULL);
+            return;
+        }
+    }
+
+    // Timing
+
+    // ── Thin shim: write RGBA directly to vsr.in_pixels ──────────────────
+    bool is_hw = (mpi->imgfmt == IMGFMT_CUDA);
+    int vsr_in_pitch = p->vsr.in_pitch;
+
+    if (is_hw && !vfx_imgfmt_is_rgb(mpi->params.hw_subfmt)) {
+        // HW YUV → D2D to vsr.in_pixels
+        int subfmt = mpi->params.hw_subfmt;
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(subfmt);
+        int bd = desc.bpp[0];
+        enum yuv_matrix mx = matrix_from_repr(&mpi->params);
+        enum yuv_range  rn = range_from_levels(mpi->params.repr.levels);
+        if (!ensure_yuv_converter(f, p, bd, mx, rn, bits, &mpi->params)) {
+            mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+        }
+        if (!yuv_to_rgba_convert(&p->yuv_conv,
+                                  mpi->planes[0], mpi->stride[0],
+                                  mpi->planes[1], mpi->stride[1],
+                                  video_w, video_h,
+                                  p->vsr.in_pixels, vsr_in_pitch,
+                                  p->cuda_stream)) {
+            MP_ERR(f, "vsr: yuv_to_rgba_convert failed\n");
+            mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+        }
+    } else {
+        // HW CUDA/RGBA: copy D2D to vsr.in_pixels (different stride possible)
+        CUDA_MEMCPY2D copy = {0};
+        copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.srcDevice     = (CUdeviceptr)mpi->planes[0];
+        copy.srcPitch      = (size_t)mpi->stride[0];
+        copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.dstDevice     = (CUdeviceptr)p->vsr.in_pixels;
+        copy.dstPitch      = (size_t)vsr_in_pitch;
+        copy.WidthInBytes  = (size_t)video_w * 4;
+        copy.Height        = (size_t)video_h;
+        if (cuMemcpy2DAsync(&copy, p->cuda_stream) != CUDA_SUCCESS) {
+            mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+        }
+    }
+
+    // ── VSR process ──────────────────────────────────────────────────────
+    void *vsr_out_ptr = NULL;
+    int vsr_out_w = 0, vsr_out_h = 0, vsr_out_pitch = 0;
+    if (!vsr_process(&p->vsr, p->cuda_stream,
+                      &vsr_out_ptr, &vsr_out_w, &vsr_out_h, &vsr_out_pitch)) {
+        MP_ERR(f, "vsr: vsr_process failed\n");
+        mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+    }
+
+    if (!ensure_out_buf(f, p, vsr_out_w, vsr_out_h, vsr_out_pitch)) {
+        mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+    }
+
+    {
+        CUDA_MEMCPY2D copy = {0};
+        copy.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.srcDevice     = (CUdeviceptr)vsr_out_ptr;
+        copy.srcPitch      = (size_t)vsr_out_pitch;
+        copy.dstMemoryType = CU_MEMORYTYPE_DEVICE;
+        copy.dstDevice     = p->out_buf;
+        copy.dstPitch      = (size_t)vsr_out_pitch;
+        copy.WidthInBytes  = (size_t)vsr_out_w * 4;
+        copy.Height        = (size_t)vsr_out_h;
+        if (cuMemcpy2DAsync(&copy, p->cuda_stream) != CUDA_SUCCESS) {
+            mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+        }
+        cuStreamSynchronize(p->cuda_stream);
+    }
+
+    // ── Output ───────────────────────────────────────────────────────────
+    // Each output frame takes a reference on the CUDA context: the frame
+    // can outlive the filter (pin teardown frees frames after f_destroy),
+    // so free_cuda_buf must never touch a destroyed context.
+    //
+    // hwctx = a self-created CUDA/RGBA frames ctx (output size, on the current
+    // ctx) — hwctx's sw_format must match the output frame's subfmt (RGBA):
+    // in the software-decode case the VO has no CUDA interop → hwdownload →
+    // av_hwframe_transfer_data parses frame data per hwctx sw_format, and
+    // borrowing an NV12 hwctx (hwup/hwdec's) to parse an RGBA frame crashes
+    // with corrupted data (mp_image_hw_download assert, measured). The HW/SW
+    // input and output sections are isomorphic.
+    mp_cuda_ctx_ref_acquire(p->cuda_ref);
+    struct mp_image *out;
+    if (!ensure_av_hw_frames(f, p, vsr_out_w, vsr_out_h, bits)) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+    }
+    out = talloc_zero(NULL, struct mp_image);
+    talloc_set_destructor(out, mp_image_dtor);
+    out->bufs[0] = av_buffer_create((uint8_t*)p->out_buf, (int)p->out_buf_size,
+                                     free_cuda_buf, p->cuda_ref, 0);
+    if (!out->bufs[0]) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        talloc_free(out); mp_frame_unref(&frame); mp_filter_internal_mark_failed(f); cuCtxPopCurrent(NULL); return;
+    }
+    mp_image_setfmt(out, IMGFMT_CUDA);
+    mp_image_sethwfmt(out, IMGFMT_CUDA, vfx_imgfmt_from_bits(bits));
+    mp_image_params_guess_csp(&out->params);
+    out->params.color = mpi->params.color; // preserve HDR metadata
+    // A rebuilt frame is RGB, so it is no longer Dolby Vision: the RPU
+    // describes a reshape of the coded YCbCr signal and resampling in RGB
+    // destroys that mapping. Clearing the flags is not enough — el_pair
+    // re-attaches the RPU from the EL track onto whatever frame leaves the
+    // user chain (filters/f_enhancement_pair.c:102) unless no_dovi is set,
+    // which would then make libplacebo reshape RGB pixels.
+    if (mpi->params.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION || mpi->dovi) {
+        out->params.no_dovi = true;
+        out->params.no_enhancement_layer = true;
+    }
+    out->w = vsr_out_w; out->h = vsr_out_h;
+    out->params.w = vsr_out_w; out->params.h = vsr_out_h;
+    out->planes[0] = (uint8_t*)p->out_buf;
+    out->stride[0] = vsr_out_pitch;
+    out->num_planes = 1;
+    out->hwctx = av_buffer_ref(p->av_hw_frames);
+    p->out_buf = 0; p->out_buf_size = 0;
+
+    // Preserve the pixel aspect ratio (aspect override: the decoder layer's
+    // video-aspect-override is folded into p_w/p_h via
+    // mp_image_params_set_dsize — VSR must carry it out when rebuilding params,
+    // otherwise the VO renders square pixels → the picture-ratio setting stops
+    // working. Measured: when it was missing, clicking the aspect option had no
+    // effect. PAR is independent of size, so it is copied straight after
+    // upscaling)
+    out->params.p_w = mpi->params.p_w;
+    out->params.p_h = mpi->params.p_h;
+    // Orientation/timing metadata is invariant under scaling. Without this a
+    // rotated source rendered unrotated through VSR (vo_gpu_next reads
+    // params.rotate per frame) and the frame duration was zeroed.
+    out->params.rotate   = mpi->params.rotate;
+    out->params.vflip    = mpi->params.vflip;
+    out->params.stereo3d = mpi->params.stereo3d;
+    out->fields          = mpi->fields;
+    out->pkt_duration    = mpi->pkt_duration;
+
+    out->pts         = mpi->pts;
+    out->dts         = mpi->dts;
+    out->nominal_fps = mpi->nominal_fps;
+
+    MP_DBG(f, "vsr: frame %d  %dx%d -> %dx%d  scale=%.2f\n",
+           p->frame_count, video_w, video_h, vsr_out_w, vsr_out_h, p->effective_scale);
+
+    talloc_free(mpi);
+    p->status_cost_ms += vsr_now_ms() - t0;
+    p->status_frames++;
+    if (p->status_frames >= 30) {
+        double el = (vsr_now_ms() - p->status_t0) / 1000.0;
+        if (p->status_t0 == 0)
+            el = 0;
+        if (el > 0)
+            // Actual effective multiplier (effective_scale, dynamic under
+            // auto) — the OSD's "setting|actual" pair: the setting segment
+            // shows the UI setting, the status segment shows the current
+            // actual value
+            mp_msg(f->log, MSGL_STATUS,
+                   "vsr-status: mode=active scale=%.2f cost=%.1fms fps=%.0f\n",
+                   p->effective_scale,
+                   p->status_cost_ms / p->status_frames,
+                   p->status_frames / el);
+        p->status_t0 = vsr_now_ms();
+        p->status_frames = 0;
+        p->status_cost_ms = 0;
+    }
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    cuCtxPopCurrent(NULL);
+}
+
+// ── vsr_command — VSR-specific screenshot capability ───────────────────────
+// Independent of mpv's own screenshot (which only captures post-filter
+// frames). Command (via `vf-command vsr ...`):
+//   dump-both <input_path>|<output_path> — one frame, both sides:
+//     input  = frame before VSR processing (original)
+//     output = frame after VSR processing (Nx)
+// Both buffers belong to the same processed frame, so a single command
+// guarantees input/output pair from the identical frame.
+
+static bool vsr_dump_frame(struct mp_filter *f, struct priv *p,
+                           const char *path, bool output)
+{
+    if (!p->cuda_ref || !p->cuda_ref->ctx || !path || !path[0])
+        return false;
+    struct vsr_context *c = &p->vsr;
+    int w  = output ? c->out_w  : c->in_w;
+    int h  = output ? c->out_h  : c->in_h;
+    int pitch = output ? c->out_pitch : c->in_pitch;
+    CUdeviceptr src = output ? (CUdeviceptr)c->out_pixels
+                             : (CUdeviceptr)c->in_pixels;
+    if (!src || w <= 0 || h <= 0 || pitch <= 0)
+        return false;
+
+    // The output format follows the engine bit depth: a 10-bit engine's buffer
+    // is packed RGB10A2, and interpreting it as RGBA8 yields a garbage image
+    // (debug command, the format must match the engine).
+    struct mp_image *img = mp_image_alloc(vfx_imgfmt_from_bits(c->bits), w, h);
+    if (!img)
+        return false;
+
+    cuCtxPushCurrent(p->cuda_ref->ctx);
+    CUDA_MEMCPY2D cp = {0};
+    cp.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+    cp.srcDevice     = src;
+    cp.srcPitch      = (size_t)pitch;
+    cp.dstMemoryType = CU_MEMORYTYPE_HOST;
+    cp.dstHost       = img->planes[0];
+    cp.dstPitch      = (size_t)img->stride[0];
+    cp.WidthInBytes  = (size_t)w * 4;
+    cp.Height        = (size_t)h;
+    CUresult cr = cuMemcpy2D(&cp);
+    cuCtxPopCurrent(NULL);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "vsr: dump %s cuMemcpy2D failed (%d)\n",
+               output ? "output" : "input", cr);
+        talloc_free(img);
+        return false;
+    }
+
+    dump_png(img, path, f->log);
+    talloc_free(img);
+    MP_VERBOSE(f, "vsr: dumped %s %dx%d -> %s\n",
+               output ? "output" : "input", w, h, path);
+    return true;
+}
+
+// ── parameter parsing (same semantics as the filter options' OPT_CHOICE
+//    strings) ────────────────────────────────────────────────────────────
+// vf-command parameters accept option strings (off/auto/2/3/4) or numbers.
+// atoi cannot be used directly: "off" → atoi=0 (auto!) — the UI turning scale
+// off sends "off" and it would be misread as auto, so the output resolution
+// would not fall back.
+
+static bool parse_scale_arg(const char *arg, float *out)
+{
+    if (!strcmp(arg, "off")) { *out = -1; return true; }
+    if (!strcmp(arg, "auto")) { *out = 0; return true; }
+    // Non-integer multipliers (the SDK supports 4/3 and 1.5, measured in
+    // vfx_test6): fractional notation is converted here (mpv OPT_FLOAT only
+    // does strtod, "4/3" would be misread as 4).
+    if (!strcmp(arg, "4/3")) { *out = 4.0f / 3.0f; return true; }
+    if (!strcmp(arg, "1.5") || !strcmp(arg, "3/2")) { *out = 1.5f; return true; }
+    char *end = NULL;
+    float v = strtof(arg, &end);
+    if (end == arg || *end != '\0') return false;
+    // SDK multiplier set validation: 4/3, 1.5, 2, 3, 4 (tolerance 0.01) — an
+    // illegal multiplier makes Load fail ("Suitable ratio not found"), so
+    // reject up front.
+    const float supported[] = {4.0f / 3.0f, 1.5f, 2.0f, 3.0f, 4.0f};
+    for (size_t i = 0; i < sizeof(supported) / sizeof(supported[0]); i++)
+        if (fabsf(v - supported[i]) < 0.01f) { *out = v; return true; }
+    return false;
+}
+
+static bool parse_denoise_arg(const char *arg, int *out)
+{
+    if (!strcmp(arg, "off"))           *out = -1;
+    else if (!strcmp(arg, "low"))      *out = 8;
+    else if (!strcmp(arg, "medium"))   *out = 9;
+    else if (!strcmp(arg, "high"))     *out = 10;
+    else if (!strcmp(arg, "ultra"))    *out = 11;
+    else *out = atoi(arg);
+    return *out == -1 || (*out >= 8 && *out <= 11);
+}
+
+static bool parse_quality_arg(const char *arg, int *out)
+{
+    if (!strcmp(arg, "low"))           *out = 1;
+    else if (!strcmp(arg, "medium"))   *out = 2;
+    else if (!strcmp(arg, "high"))     *out = 3;
+    else if (!strcmp(arg, "ultra"))    *out = 4;
+    else *out = atoi(arg);
+    return *out >= 1 && *out <= 4;
+}
+
+static bool vsr_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT)
+        return false;
+    // ── Runtime parameter update (via `vf-command @vsr <param> <value>`) ──
+    // Hot update, no filter chain rebuild. f_process handles the
+    // reconfiguration automatically on the next frame:
+    //   scale   → new resolve_scale value → effective_scale change → ensure_vsr
+    //             lightweight update (SetImage swaps the output buffer, engine
+    //             stays resident)
+    //   quality → ensure_vsr detects the quality change → vsr_set_quality (SetU32)
+    //   denoise → passthrough decision (f_process)
+    if (cmd->arg) {
+        int v;
+        float fv;
+        if (strcmp(cmd->cmd, "scale") == 0) {
+            if (!parse_scale_arg(cmd->arg, &fv))
+                return false;   // illegal value (1 not allowed — scale=1 means denoise mode)
+            if (fabsf(p->opts->scale - fv) > 0.001f) {
+                MP_INFO(f, "vsr: scale %.2f -> %.2f (vf-command)\n",
+                        p->opts->scale, fv);
+                p->opts->scale = fv;
+            }
+            return true;
+        }
+        if (strcmp(cmd->cmd, "seek-target") == 0) {
+            // Called by the client before an absolute seek: frames with pts <
+            // target are dropped outright (0 = clear).
+            char *end = NULL;
+            double t = strtod(cmd->arg, &end);
+            if (end == cmd->arg || *end != '\0' || !isfinite(t) || t < 0)
+                return false;
+            p->skip_before_pts = t;
+            p->skip_count = 0;
+            p->skip_passed = false;
+            p->skip_expire_ms = vsr_now_ms() + 3000.0;
+            MP_VERBOSE(f, "vsr: seek-target %.3f\n", p->skip_before_pts);
+            return true;
+        }
+        if (strcmp(cmd->cmd, "quality") == 0) {
+            if (!parse_quality_arg(cmd->arg, &v))
+                return false;
+            if (p->opts->quality != v) {
+                MP_INFO(f, "vsr: quality %d -> %d (vf-command)\n",
+                        p->opts->quality, v);
+                p->opts->quality = v;
+            }
+            return true;
+        }
+        if (strcmp(cmd->cmd, "denoise") == 0) {
+            if (!parse_denoise_arg(cmd->arg, &v))
+                return false;
+            if (p->opts->denoise != v) {
+                MP_INFO(f, "vsr: denoise %d -> %d (vf-command)\n",
+                        p->opts->denoise, v);
+                p->opts->denoise = v;
+            }
+            return true;
+        }
+    }
+    if (strcmp(cmd->cmd, "dump-both") == 0 && cmd->arg) {
+        // arg: "input_path|output_path"
+        char *sep = strchr((char *)cmd->arg, '|');
+        if (!sep)
+            return false;
+        *sep = '\0';
+        bool ok_in  = vsr_dump_frame(f, p, cmd->arg, false);
+        bool ok_out = vsr_dump_frame(f, p, sep + 1, true);
+        return ok_in && ok_out;
+    }
+    return false;
+}
+
+// ── f_reset ────────────────────────────────────────────────────────────────
+
+static void f_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    // Only clear the per-seek bookkeeping, **keep the engine** (same as the
+    // f_reset of vf_vfg / vf_rife): every mpv seek does
+    // reset_playback_state → mp_filter_reset → this callback, and a VFX engine
+    // destroy + re-Load is a fixed ~300 ms cost (measured 1080p exact seek:
+    // 35 ms without the filter, 330 ms with VSR only, and independent of "how
+    // far it jumps") — every step of holding an arrow key to step frame by
+    // frame would pay it for nothing. VSR is a per-frame spatial operation with
+    // no cross-frame state, so reuse across seeks is safe: bit depth/input size
+    // changes still trigger a rebuild via ensure_vsr's checks, and CUDA context
+    // changes are still handled by ensure_cuda (that path actively calls
+    // vsr_destroy).
+    p->frame_count = 0;
+    p->status_emit = 0;
+    MP_INFO(f, "vsr: reset (engine kept)\n");
+}
+
+// ── f_destroy ──────────────────────────────────────────────────────────────
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    bool ctx_pushed = false;
+    if (p->cuda_ref && p->cuda_ref->ctx) {
+        CUresult cr = cuCtxPushCurrent(p->cuda_ref->ctx);
+        ctx_pushed = (cr == CUDA_SUCCESS);
+    }
+
+    vsr_destroy(&p->vsr);
+
+    if (p->yuv_conv_ready) {
+        yuv_to_rgba_destroy(&p->yuv_conv);
+        p->yuv_conv_ready = false;
+    }
+
+    if (p->out_buf) {
+        if (ctx_pushed) cuMemFree(p->out_buf);
+        p->out_buf      = 0;
+        p->out_buf_size = 0;
+    }
+
+    if (p->cuda_init_done) {
+        if (ctx_pushed) cuStreamDestroy(p->cuda_stream);
+        p->cuda_stream = NULL;
+    }
+
+    if (ctx_pushed)
+        cuCtxPopCurrent(NULL);
+
+    // The frames/device carrier release must happen with nothing pushed: its
+    // uninit may cuCtxDestroy (FFmpeg's self-created ctx / hwdec carrier).
+    // In current_ctx mode the borrowed ctx is not destroyed here — that is
+    // managed by the shared struct's refs.
+    if (p->av_hw_frames) {
+        av_buffer_unref(&p->av_hw_frames);
+        p->av_hw_frames = NULL;
+    }
+    if (p->av_hw_device) {
+        av_buffer_unref(&p->av_hw_device);
+        p->av_hw_device = NULL;
+    }
+
+    // Release the filter's context reference. Frames still in flight
+    // (pin teardown happens after destroy()) hold their own references;
+    // the context is destroyed only when the last one is released.
+    if (p->cuda_ref) {
+        mp_cuda_ctx_ref_release(p->cuda_ref);
+        p->cuda_ref = NULL;
+    }
+
+    p->cuda_init_done = false;
+}
+
+// ── vf_vsr_filter_info ─────────────────────────────────────────────────────
+
+static const struct mp_filter_info vf_vsr_filter = {
+    .name      = "vsr",
+    .priv_size = sizeof(struct priv),
+    .process   = f_process,
+    .reset     = f_reset,
+    .destroy   = f_destroy,
+    .command   = vsr_command,
+};
+
+// ── vf_vsr_create ──────────────────────────────────────────────────────────
+
+static struct mp_filter *vf_vsr_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_vsr_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+
+    // VSR is known to be unnecessary at startup: scale∈{-1,1} and denoise=off.
+    // With denoise>0 passthrough is not allowed (the 1:1 denoise mode has to
+    // run VSR too). Runtime parameter changes are re-evaluated per frame by
+    // f_process (no static branch — caching would break vf-command hot updates,
+    // e.g. after turning scale off, clicking 2x or enabling denoise would never
+    // take effect).
+    p->passthrough = ((p->opts->scale == -1 || fabsf(p->opts->scale - 1.0f) < 0.001f)
+                      && p->opts->denoise == -1);
+    p->warmup_done = false;
+    p->effective_scale = 1;
+
+    if (p->passthrough) {
+        MP_VERBOSE(f, "vsr: passthrough mode (scale=%.2f, denoise=%d)\n",
+                   p->opts->scale, p->opts->denoise);
+        return f;
+    }
+
+    return f;
+}
+
+// ── Registration ───────────────────────────────────────────────────────────
+
+const struct mp_user_filter_entry vf_vsr = {
+    .desc = {
+        .name          = "vsr",
+        .description   = "AI super-resolution via NVIDIA VFX SDK",
+        .priv_size     = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &vf_vsr_opts_def,
+        .options       = vf_opts_fields,
+    },
+    .create = vf_vsr_create,
+};
diff --git a/video/filter/vfg_proc.c b/video/filter/vfg_proc.c
new file mode 100644
index 000000000..d27d3b9d9
--- /dev/null
+++ b/video/filter/vfg_proc.c
@@ -0,0 +1,258 @@
+// src/mpv/video/filter/vfg_proc.c
+// VFG (VideoFrameGeneration) engine wrapper implementation (interface in
+// vfg_proc.h).
+// Structure mirrors vsr_proc.c: per-context NvCVImage buffers, on-demand
+// allocation (on a size change Dealloc first, then Alloc, ruling out "old
+// buffer overwritten without being released"), sync in-flight work before
+// destroy.
+//
+// Logging: this layer has no filter context (same as vsr_proc.c), it uses
+// fprintf(stderr) with a "VFG:" prefix; vf_vfg.c always goes through
+// mp_msg(f->log, ...).
+#include "vfg_proc.h"
+#include "yuv_to_rgba.h"   // VFX_BITS_10 / vfx_* format mapping (single source of truth)
+
+#include <cuda.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#define VFG_INPUT0_IMAGE  "SrcImage0"
+#define VFG_INPUT1_IMAGE  "SrcImage1"
+#define VFG_OUTPUT_IMAGE  "DstImage0"
+#define VFG_CUDA_STREAM   "CudaStream"
+
+// ── on-demand image buffer allocation (mirrors vsr_proc.c ensure_img) ──
+
+static bool ensure_img(NvCVImage *img, int w, int h, int bits, const char *tag)
+{
+    int pf = (bits == VFX_BITS_10) ? NVCV_RGB10A2 : NVCV_RGBA;
+    int ct = (bits == VFX_BITS_10) ? NVCV_P32     : NVCV_U8;
+    if (img->pixels && img->width == (unsigned)w && img->height == (unsigned)h &&
+        img->pixelFormat == pf && img->componentType == ct)
+        return true;
+    if (img->pixels) {
+        pfn_NvCVImage_Dealloc(img);
+        memset(img, 0, sizeof(*img));
+    }
+    int ar = pfn_NvCVImage_Alloc(img, (unsigned)w, (unsigned)h,
+                                 pf, ct, NVCV_CHUNKY, NVCV_GPU, 32);
+    if (ar != 0) {
+        fprintf(stderr, "VFG: Alloc(%s %dx%d %d-bit) failed (%d)\n",
+                tag, w, h, bits, ar);
+        memset(img, 0, sizeof(*img));
+        return false;
+    }
+    return true;
+}
+
+// ── vfg_init ─────────────────────────────────────────────────────────────
+// Parameter set and order copied from vfx13_probe.c:151-179 (verified
+// working on this machine: a 1280x720 single peak landing at the midpoint =
+// a genuinely synthesised intermediate frame). The probe sets all parameters
+// and images before Load.
+
+bool vfg_init(struct vfg_context *c, int in_w, int in_h, int mode,
+              int multiplier, int bits, CUstream stream)
+{
+    if (!vfx_load_libraries())
+        return false;
+    if (multiplier < VFG_MULT_MIN || multiplier > VFG_MULT_MAX) {
+        fprintf(stderr, "VFG: FrameMultiplier %d out of range (%d..%d)\n",
+                multiplier, VFG_MULT_MIN, VFG_MULT_MAX);
+        return false;
+    }
+
+    memset(c, 0, sizeof(*c));
+    c->in_w = in_w;
+    c->in_h = in_h;
+    c->mode = mode;
+    c->multiplier = multiplier;
+    c->bits = (bits == VFX_BITS_10) ? VFX_BITS_10 : VFX_BITS_8;
+
+    int ret = pfn_NvVFX_CreateEffect("VideoFrameGeneration", &c->handle);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: CreateEffect(VideoFrameGeneration) failed (%d)\n",
+                ret);
+        return false;
+    }
+
+    // InputWidth/InputHeight must be set before Load (the official wrapper
+    // marks requires_reload, and sets them inside load() before Load).
+    pfn_NvVFX_SetU32(c->handle, "InputWidth", (unsigned int)in_w);
+    pfn_NvVFX_SetU32(c->handle, "InputHeight", (unsigned int)in_h);
+    pfn_NvVFX_SetU32(c->handle, "Mode", (unsigned int)mode);
+    // FrameMultiplier/FrameIndex are **per-Run** parameters (the official
+    // wrapper's run() re-SetU32 them every time, and they are not marked
+    // requires_reload); setting them once before Load as well keeps the
+    // initial state exactly identical to the probe.
+    pfn_NvVFX_SetU32(c->handle, "FrameMultiplier", (unsigned int)multiplier);
+    pfn_NvVFX_SetU32(c->handle, "FrameIndex", 1);
+    // Scene-change detection is left to the engine (single source of truth):
+    // vf_vfg no longer implements a second MAE.
+    pfn_NvVFX_SetU32(c->handle, "AutomaticShotChangeDetectionEnabled", 1);
+
+    // ── two inputs + one output: RGBA U8 / RGB10A2 chunky GPU ──────────
+    // All three images must have the same encoding (library documentation:
+    // RGB8/RGB10A2 mixing is unsupported).
+    for (int i = 0; i < 2; i++) {
+        if (!ensure_img(&c->in_img[i], in_w, in_h, c->bits, i ? "src1" : "src0")) {
+            vfg_destroy(c);
+            return false;
+        }
+        c->in_pixels[i] = c->in_img[i].pixels;
+        c->in_pitch[i]  = (int)c->in_img[i].pitch;
+    }
+    // VFG output is the same size as the input (probe: ow/oh = W/H)
+    if (!ensure_img(&c->out_img, in_w, in_h, c->bits, "dst")) {
+        vfg_destroy(c);
+        return false;
+    }
+    c->out_pixels = c->out_img.pixels;
+    c->out_pitch  = (int)c->out_img.pitch;
+
+    ret = pfn_NvVFX_SetImage(c->handle, VFG_INPUT0_IMAGE, &c->in_img[0]);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: SetImage(SrcImage0) failed (%d)\n", ret);
+        vfg_destroy(c);
+        return false;
+    }
+    ret = pfn_NvVFX_SetImage(c->handle, VFG_INPUT1_IMAGE, &c->in_img[1]);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: SetImage(SrcImage1) failed (%d)\n", ret);
+        vfg_destroy(c);
+        return false;
+    }
+    ret = pfn_NvVFX_SetImage(c->handle, VFG_OUTPUT_IMAGE, &c->out_img);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: SetImage(DstImage0) failed (%d)\n", ret);
+        vfg_destroy(c);
+        return false;
+    }
+
+    // ── CUDA stream ───────────────────────────────────────────────────────
+    if (stream) {
+        c->stream = stream;
+        c->own_stream = false;
+    } else {
+        cuStreamCreate(&c->stream, CU_STREAM_NON_BLOCKING);
+        c->own_stream = true;
+    }
+    pfn_NvVFX_SetCudaStream(c->handle, VFG_CUDA_STREAM, c->stream);
+
+    // ── Load (model initialisation; the 1.3 VFG library is 218MB, Load
+    // cost far exceeds a single frame) ───────────────────────────────────
+    ret = pfn_NvVFX_Load(c->handle);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: Load failed (%d)\n", ret);
+        vfg_destroy(c);
+        return false;
+    }
+
+    c->ready = true;
+    fprintf(stderr, "VFG: init ok (%dx%d mode=%d k=%d)\n",
+            in_w, in_h, mode, multiplier);
+    return true;
+}
+
+// ── vfg_reconfig ─────────────────────────────────────────────────────────
+// Input size or Mode change: destroy + rebuild + Load again (reasoning in
+// vfg_proc.h).
+
+bool vfg_reconfig(struct vfg_context *c, int in_w, int in_h, int mode,
+                  int multiplier, int bits, CUstream stream)
+{
+    vfg_destroy(c);
+    return vfg_init(c, in_w, in_h, mode, multiplier, bits, stream);
+}
+
+// ── vfg_set_multiplier ───────────────────────────────────────────────────
+
+bool vfg_set_multiplier(struct vfg_context *c, int multiplier)
+{
+    if (!c->handle || !c->ready)
+        return false;
+    if (multiplier < VFG_MULT_MIN || multiplier > VFG_MULT_MAX) {
+        fprintf(stderr, "VFG: FrameMultiplier %d out of range (%d..%d)\n",
+                multiplier, VFG_MULT_MIN, VFG_MULT_MAX);
+        return false;
+    }
+    c->multiplier = multiplier;
+    return true;
+}
+
+// ── vfg_process ──────────────────────────────────────────────────────────
+// Each Run generates 1 interpolated frame (FrameIndex is supplied by the
+// caller as i=1..multiplier-1; the official wrapper's run() likewise does
+// "SetU32(FrameMultiplier) + SetU32(FrameIndex) before every Run", no re-Load
+// needed).
+// The output buffer is taken directly from c->out_img.pixels: the buffer is
+// Alloc'd by this layer and handed to the engine via SetImage, so the address
+// is stable (this is how the probe read it back, without relying on
+// GetImage).
+
+bool vfg_process(struct vfg_context *c, int frame_index,
+                 void **output_ptr, int *out_pitch)
+{
+    if (!c->ready)
+        return false;
+    if (frame_index < 1 || frame_index >= c->multiplier) {
+        fprintf(stderr, "VFG: FrameIndex %d out of range (1..%d)\n",
+                frame_index, c->multiplier - 1);
+        return false;
+    }
+
+    pfn_NvVFX_SetU32(c->handle, "FrameMultiplier", (unsigned int)c->multiplier);
+    pfn_NvVFX_SetU32(c->handle, "FrameIndex", (unsigned int)frame_index);
+
+    int ret = pfn_NvVFX_Run(c->handle, 0);
+    if (ret != 0) {
+        fprintf(stderr, "VFG: Run(FrameIndex=%d) failed (%d)\n", frame_index, ret);
+        return false;
+    }
+
+    if (output_ptr) *output_ptr = c->out_img.pixels;
+    if (out_pitch)  *out_pitch  = (int)c->out_img.pitch;
+    return true;
+}
+
+// ── vfg_destroy ──────────────────────────────────────────────────────────
+// Same as vsr_destroy: sync in-flight work first (Run submits asynchronously
+// and the engine may still be writing the output buffer — releasing the
+// target buffer with DestroyEffect/Dealloc at that point triggers a CUDA
+// illegal access).
+// Sync scope = its own stream (no device-wide cuCtxSynchronize: that would
+// drag in the VO's stream 0 copies and deadlock once the render loop blocks
+// with the core — the Xid 109 lesson).
+// The caller must have already called cuCtxPushCurrent.
+
+void vfg_destroy(struct vfg_context *c)
+{
+    if (c->stream)
+        cuStreamSynchronize(c->stream);
+    if (c->handle) {
+        pfn_NvVFX_DestroyEffect(c->handle);
+        c->handle = NULL;
+    }
+    for (int i = 0; i < 2; i++) {
+        if (c->in_img[i].pixels) {
+            pfn_NvCVImage_Dealloc(&c->in_img[i]);
+            memset(&c->in_img[i], 0, sizeof(c->in_img[i]));
+        }
+        c->in_pixels[i] = NULL;
+        c->in_pitch[i] = 0;
+    }
+    if (c->out_img.pixels) {
+        pfn_NvCVImage_Dealloc(&c->out_img);
+        memset(&c->out_img, 0, sizeof(c->out_img));
+    }
+    c->out_pixels = NULL;
+    c->out_pitch = 0;
+    if (c->own_stream && c->stream) {
+        cuStreamDestroy(c->stream);
+        c->stream = NULL;
+        c->own_stream = false;
+    }
+    c->ready = false;
+    c->in_w = c->in_h = 0;
+}
diff --git a/video/filter/vfg_proc.h b/video/filter/vfg_proc.h
new file mode 100644
index 000000000..c279d88f9
--- /dev/null
+++ b/video/filter/vfg_proc.h
@@ -0,0 +1,76 @@
+// src/mpv/video/filter/vfg_proc.h
+// VFG (NVIDIA VFX SDK VideoFrameGeneration) engine wrapper — isomorphic to
+// the VSR wrapper in vsr_internal.h: engine handle + per-context NvCVImage
+// buffers (SrcImage0/SrcImage1/DstImage0), init/reconfig/process/destroy.
+//
+// Call sequence copied from third_party/.vfx-dl/vfx13_probe.c:143-179
+// (measured working):
+//   CreateEffect("VideoFrameGeneration") → SetU32(InputWidth/InputHeight/
+//   Mode/FrameMultiplier/FrameIndex/AutomaticShotChangeDetectionEnabled) →
+//   SetImage(SrcImage0/SrcImage1/DstImage0) → SetCudaStream → Load → Run(0)
+// Each Run generates 1 interpolated frame (batch size only supports 1).
+#pragma once
+
+#include <stdbool.h>
+
+#include "vfx_loader.h"
+
+// VFG's Mode (nvVideoEffects.h / the official nvvfx wrapper's Mode enum)
+enum vfg_mode {
+    VFG_MODE_LOW    = 0,
+    VFG_MODE_MEDIUM = 1,
+    VFG_MODE_HIGH   = 2,
+};
+
+// FrameMultiplier range supported by the SDK (official docs/wrapper: 2..8)
+#define VFG_MULT_MIN 2
+#define VFG_MULT_MAX 8
+
+struct vfg_context {
+    void   *handle;        // NvVFX_Handle
+    // Two inputs + one output: all RGBA U8 chunky GPU. The SFU roles
+    // (SrcImage0 = previous frame, SrcImage1 = current frame) are
+    // **fixed once** SetImage is done before Load (probe sequence),
+    // contents written on demand by the caller via D2D.
+    struct NvCVImage in_img[2];
+    void   *in_pixels[2];
+    int     in_pitch[2];
+    struct NvCVImage out_img;
+    void   *out_pixels;
+    int     out_pitch;
+    CUstream stream;
+    bool    own_stream;    // self-created when caller gives no stream (vf_vfg always borrows)
+    bool    ready;
+    int     in_w, in_h;
+    int     mode;          // enum vfg_mode
+    int     multiplier;    // FrameMultiplier (SetU32 before every Run)
+    int     bits;          // 8 = RGBA U8, 10 = packed RGB10A2 (all three images must match)
+};
+
+// Create effect, bind buffers and stream, Load. Returns false on failure
+// (and cleans up the state already built).
+bool vfg_init(struct vfg_context *c, int in_w, int in_h, int mode,
+              int multiplier, int bits, CUstream stream);
+
+// Input size / Mode change: destroy effect + rebuild + Load again.
+// Basis: the official nvvfx wrapper marks Mode / InputWidth / InputHeight
+// all as requires_reload (changing these after Load requires a re-load);
+// the probe only set Mode **before** Load, whether a post-Load change takes
+// effect is unverified → always rebuild, do not gamble.
+bool vfg_reconfig(struct vfg_context *c, int in_w, int in_h, int mode,
+                  int multiplier, int bits, CUstream stream);
+
+// FrameMultiplier update (no rebuild needed: the official wrapper's run()
+// SetU32 this parameter every time, and it is not marked requires_reload).
+bool vfg_set_multiplier(struct vfg_context *c, int multiplier);
+
+// Generate the frame_index-th interpolated frame of the current pair
+// (1..multiplier-1, multiplier mode t = frame_index/multiplier). On success
+// *output_ptr points at the engine output buffer (the caller must finish
+// the follow-up copy/sync on its own stream before using it).
+bool vfg_process(struct vfg_context *c, int frame_index,
+                 void **output_ptr, int *out_pitch);
+
+// Destroy effect and buffers; wait for in-flight work before destroying (so
+// the GPU cannot write to an already-freed buffer).
+void vfg_destroy(struct vfg_context *c);
diff --git a/video/filter/vfx_loader.c b/video/filter/vfx_loader.c
new file mode 100644
index 000000000..211f4f50a
--- /dev/null
+++ b/video/filter/vfx_loader.c
@@ -0,0 +1,243 @@
+// src/mpv/video/filter/vfx_loader.c
+// VFX library locator/loader layer, sole implementation (interface in
+// vfx_loader.h) — a pure move out of vsr_proc.c: search order, log text,
+// dlopen order and flags, dlsym symbol set, and failure-branch semantics are
+// all verbatim unchanged.
+#include "vfx_loader.h"
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// ── library handles and symbol table (process-wide singleton) ──────────
+
+void *g_vfx_lib = NULL;
+void *g_nvcv_lib = NULL;
+
+
+PFN_NvVFX_CreateEffect    pfn_NvVFX_CreateEffect;
+PFN_NvVFX_DestroyEffect   pfn_NvVFX_DestroyEffect;
+PFN_NvVFX_SetU32          pfn_NvVFX_SetU32;
+PFN_NvVFX_SetImage        pfn_NvVFX_SetImage;
+PFN_NvVFX_GetImage        pfn_NvVFX_GetImage;
+PFN_NvVFX_SetCudaStream   pfn_NvVFX_SetCudaStream;
+PFN_NvVFX_Load            pfn_NvVFX_Load;
+PFN_NvVFX_Run             pfn_NvVFX_Run;
+PFN_NvCVImage_Alloc       pfn_NvCVImage_Alloc;
+PFN_NvCVImage_Dealloc     pfn_NvCVImage_Dealloc;
+PFN_NvCVImage_Transfer    pfn_NvCVImage_Transfer;
+
+// ── Library loading ──────────────────────────────────────────────────────
+
+#define LOAD_SYM(LIB, NAME)                                      \
+    do {                                                          \
+        pfn_##NAME = (PFN_##NAME)dlsym(LIB, #NAME);             \
+        if (!pfn_##NAME) {                                        \
+            fprintf(stderr, "VSR: dlsym(" #NAME ") failed: %s\n", \
+                    dlerror());                                   \
+            return false;                                         \
+        }                                                         \
+    } while (0)
+
+bool vfx_load_libraries(void) {
+    if (g_vfx_lib) return true;
+
+    // Find nvvfx lib directory — try common locations
+    const char *home = getenv("HOME");
+    char homedir_path[1024] = "";
+    if (home) {
+        snprintf(homedir_path, sizeof(homedir_path), "%s/.local/lib/vsr-player/", home);
+    }
+    // The dev path is derived from the **executable's directory**, and only
+    // enabled when the executable lives inside the build tree (path contains
+    // "/build/") — no CWD-relative path: when a distribution package runs in
+    // an arbitrary directory (e.g. the video's directory), a libNVCVImage.so
+    // in the CWD would be loaded, which is a library-hijack surface.
+    // dev layout: <repo>/build/src/client/vsr-player → ../../../third_party/…
+    char dev_vfx[1024] = "", dev_build_lib[1024] = "";
+    {
+        char exe[1024];
+        ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+        if (n > 0) {
+            exe[n] = '\0';
+            char *slash = strrchr(exe, '/');
+            if (slash && strstr(exe, "/build/")) {
+                *slash = '\0';
+                snprintf(dev_vfx, sizeof(dev_vfx),
+                         "%s/../../../third_party/nvvfx/lib/", exe);
+                snprintf(dev_build_lib, sizeof(dev_build_lib),
+                         "%s/../../../build/lib/", exe);
+            }
+        }
+    }
+    // Search order (the first directory containing libNVCVImage.so wins):
+    // compile-time packaging path → dev tree → HOME user install →
+    // build/lib. The dev tree must come **before** HOME: the install under
+    // HOME may be an older SDK generation (e.g. 1.1 has no
+    // libnvVFXVideoFrameGeneration.so), and if it matches first the newer
+    // libraries in the dev tree are silently shadowed — the old version runs
+    // with no hint whatsoever (this has happened: two whole rounds of VSR
+    // performance A/B both ran the old HOME library, the conclusions were
+    // void).
+    const char *search[] = {
+#ifdef VSR_INSTALL_LIBDIR
+        VSR_INSTALL_LIBDIR,           // compile-time override (packaging)
+#endif
+        dev_vfx,                       // dev only (running inside the build tree; before HOME)
+        homedir_path,                  // user-local default
+        dev_build_lib,                 // dev only
+    };
+    const char *nvvfx_dir = NULL;
+    int n_search = sizeof(search) / sizeof(search[0]);
+    for (int i = 0; i < n_search; i++) {
+        if (!search[i] || !search[i][0]) continue;       // skip NULL or empty
+        char path[1024];
+        snprintf(path, sizeof(path), "%s%s", search[i], "libNVCVImage.so");
+        if (access(path, R_OK) == 0) { nvvfx_dir = search[i]; break; }
+    }
+    if (!nvvfx_dir) {
+        fprintf(stderr, "VSR: nvvfx libs not found\n");
+        return false;
+    }
+
+    // The TensorRT 10 chain bundled by VFX ≤0.1.0.1 (onnxparser → nvinfer →
+    // plugin): preloaded with RTLD_LOCAL, must come before
+    // libVideoFXLocal.so (whose NEEDED libnvonnxparser.so.10 is reused via
+    // SONAME matching). RTLD_GLOBAL would inject TRT 10 symbols into the
+    // global namespace → system TRT 11 (linked by vf_rife) binds the wrong
+    // symbols → ABI crash; LOCAL still satisfies NEEDED.
+    // From 1.3 (wheel 0.2.0.0) that chain is gone: the wheel no longer
+    // bundles libnvinfer*, and libVideoFXLocal.so no longer has a
+    // libnvonnxparser NEEDED (verified with objdump -x) — so under 1.3 this
+    // section is a **normal no-op** (files absent → skip, no more misleading
+    // dlopen failure log). It is kept for compatibility with old ≤0.1.0.1
+    // installs: there this chain is still a hard requirement, without it
+    // libVideoFXLocal.so fails to load.
+    {
+        const char *trt10[] = {
+            "libnvinfer.so.10", "libnvinfer_plugin.so.10", "libnvonnxparser.so.10",
+        };
+        for (int i = 0; i < 3; i++) {
+            char path[1024];
+            snprintf(path, sizeof(path), "%s%s", nvvfx_dir, trt10[i]);
+            if (access(path, R_OK) != 0)
+                continue;   // 1.3+: no TRT10 chain in the directory, skip normally
+            void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+            if (!h)
+                fprintf(stderr, "VSR: dlopen(%s): %s\n", trt10[i], dlerror());
+        }
+    }
+
+    // Load all nvvfx .so files (order matters for deps)
+    // Topological order: deps before dependents
+    const char *libs[] = {
+        "libnppc.so", "libnppial.so", "libnppicc.so", "libnppidei.so",
+        "libnppig.so", "libnppif.so", "libnppim.so", "libnppist.so",
+        "libnppitc.so", "libcudnn.so",
+        "libNVCVImage.so",    // before libnvngxruntime which needs it
+        "libnvngxruntime.so", "libnvidia-ngx-vsr.so",
+        "libVideoFXLocal.so", "libVideoFX.so",
+        "libnvVFXVideoSuperRes.so",
+        // TrueHDR (VFX 1.3's SDR→HDR10 up-conversion effect): libnvVFXTrueHDR.so
+        // depends on the same-generation libnvidia-ngx-truehdr.so (NGX backend).
+        // 1.2 and earlier have neither library — existence guard below
+        // (absent is normal, VSR/VFG keep working), the dlopen failure text
+        // must not spam.
+        "libnvidia-ngx-truehdr.so",
+        // VFG (the AI frame-generation effect added in 1.3) — VFX 1.1 has no
+        // such library in its directory, and it is likewise missing before
+        // 1.2 (only the 1.3 wheel 0.2.0.0 has it). Existence guard below:
+        // without it every start prints one more misleading dlopen failure.
+        "libnvVFXVideoFrameGeneration.so",
+        "libnvVFXTrueHDR.so",
+    };
+    int nlibs = sizeof(libs) / sizeof(libs[0]);
+    for (int i = 0; i < nlibs; i++) {
+        char path[1024];
+        snprintf(path, sizeof(path), "%s%s", nvvfx_dir, libs[i]);
+        // Reachability check first for libraries older SDK generations lack
+        // (absent = feature unavailable, not an error): one clear statement
+        // is enough — the dlopen failure text must not spam.
+        // vfx_load_libraries is process-wide idempotent (g_vfx_lib cache) →
+        // printed only once.
+        if ((strcmp(libs[i], "libnvVFXVideoFrameGeneration.so") == 0 ||
+             strcmp(libs[i], "libnvVFXTrueHDR.so") == 0 ||
+             strcmp(libs[i], "libnvidia-ngx-truehdr.so") == 0) &&
+            access(path, R_OK) != 0) {
+            fprintf(stderr, "VSR: %s unavailable (this VFX SDK has no %s)\n",
+                    strcmp(libs[i], "libnvVFXVideoFrameGeneration.so") == 0
+                        ? "VFG" : "TrueHDR", libs[i]);
+            continue;
+        }
+        void *h = dlopen(path, RTLD_NOW | RTLD_GLOBAL);
+        if (!h) {
+            fprintf(stderr, "VSR: dlopen(%s): %s\n", libs[i], dlerror());
+            // Continue — some libs might be missing but others work
+        }
+    }
+
+    // Retrieve handles for the two we need symbols from
+    char path[1024];
+    snprintf(path, sizeof(path), "%s%s", nvvfx_dir, "libVideoFX.so");
+    g_vfx_lib = dlopen(path, RTLD_NOW | RTLD_GLOBAL);
+    snprintf(path, sizeof(path), "%s%s", nvvfx_dir, "libNVCVImage.so");
+    g_nvcv_lib = dlopen(path, RTLD_NOW);
+    if (!g_vfx_lib || !g_nvcv_lib) {
+        fprintf(stderr, "VSR: core libs failed\n");
+        if (g_vfx_lib) dlclose(g_vfx_lib);
+        if (g_nvcv_lib) dlclose(g_nvcv_lib);
+        g_vfx_lib = NULL;
+        g_nvcv_lib = NULL;
+        return false;
+    }
+
+    LOAD_SYM(g_vfx_lib,  NvVFX_CreateEffect);
+    LOAD_SYM(g_vfx_lib,  NvVFX_DestroyEffect);
+    LOAD_SYM(g_vfx_lib,  NvVFX_SetU32);
+    LOAD_SYM(g_vfx_lib,  NvVFX_SetImage);
+    LOAD_SYM(g_vfx_lib,  NvVFX_GetImage);
+    LOAD_SYM(g_vfx_lib,  NvVFX_SetCudaStream);
+    LOAD_SYM(g_vfx_lib,  NvVFX_Load);
+    LOAD_SYM(g_vfx_lib,  NvVFX_Run);
+    LOAD_SYM(g_nvcv_lib, NvCVImage_Alloc);
+    LOAD_SYM(g_nvcv_lib, NvCVImage_Dealloc);
+    LOAD_SYM(g_nvcv_lib, NvCVImage_Transfer);
+
+    // Report the directory and SDK generation actually in effect (once at
+    // startup, low frequency): the HOME install and the dev tree may be of
+    // different generations, and the log must distinguish them, otherwise
+    // "which SDK version was measured" is untraceable.
+    // Generation criterion: libnvVFXVideoFrameGeneration.so present ⇒ 1.3+;
+    // absent ⇒ older.
+    bool has_vfg = false;
+    bool has_truehdr = false;
+    char ngx_vsr_ver[256] = "";
+    DIR *dir = opendir(nvvfx_dir);
+    if (dir) {
+        struct dirent *ent;
+        while ((ent = readdir(dir)) != NULL) {
+            if (strcmp(ent->d_name, "libnvVFXVideoFrameGeneration.so") == 0)
+                has_vfg = true;
+            else if (strcmp(ent->d_name, "libnvVFXTrueHDR.so") == 0)
+                has_truehdr = true;
+            else if (strncmp(ent->d_name, "libnvidia-ngx-vsr.so.",
+                             sizeof("libnvidia-ngx-vsr.so.") - 1) == 0)
+                snprintf(ngx_vsr_ver, sizeof(ngx_vsr_ver), "%s", ent->d_name);
+        }
+        closedir(dir);
+    }
+    char *resolved_dir = realpath(nvvfx_dir, NULL);   // print the canonical absolute path (otherwise it is a concatenated ".." path)
+    fprintf(stderr, "VSR: NvVFX libraries loaded (nvvfx dir=%s, gen=%s%s%s%s)\n",
+            resolved_dir ? resolved_dir : nvvfx_dir,
+            has_vfg ? "1.3+ (VideoFrameGeneration present)"
+                    : "legacy (no VideoFrameGeneration)",
+            has_truehdr ? ", TrueHDR" : "",
+            ngx_vsr_ver[0] ? ", ngx-vsr=" : "", ngx_vsr_ver);
+    free(resolved_dir);
+    return true;
+}
+
+#undef LOAD_SYM
diff --git a/video/filter/vfx_loader.h b/video/filter/vfx_loader.h
new file mode 100644
index 000000000..1fed8555e
--- /dev/null
+++ b/video/filter/vfx_loader.h
@@ -0,0 +1,100 @@
+// src/mpv/video/filter/vfx_loader.h
+// VFX (NVIDIA Video Effects SDK) library locator and load layer — the
+// **single source of truth** shared by VSR (vsr_proc.c), VFG (vfg_proc.c)
+// and the future TrueHDR: directory search order, dlopen order and flags,
+// the dlsym symbol set, and the failure semantics are all implemented once,
+// only in vfx_loader.c. This header exposes the SDK types (NvCVImage /
+// PFN_*), the library handles and function pointers (extern), and the load
+// entry point.
+#pragma once
+
+#include <cuda.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// ── NvCVImage (struct layout of nvCVImage.h, C-compatible redefinition) ─
+// Image buffers are per-context (multiple instances coexist — the retired
+// queue deferred-destroy scheme): every vsr_context holds its own in/out/tmp
+// buffers, the SDK engine's SetImage references each instance's own pixels
+// address, destroying the old instance does not affect the new one.
+
+typedef struct NvCVImage {
+    unsigned int width, height;
+    int pitch;
+    int pixelFormat, componentType;
+    unsigned char pixelBytes, componentBytes, numComponents;
+    unsigned char planar, gpuMem, colorspace;
+    void *pixels;
+    void *deletePtr;
+    void (*deleteProc)(void*);
+    unsigned long long bufferBytes;
+} NvCVImage;
+
+// ── enum constants of nvCVImage.h (C-compatible redefinition) ──────────
+// Shared by VSR (vsr_proc.c) and VFG (vfg_proc.c) — originally defined in
+// vsr_proc.c, moved to this layer alongside NvCVImage to avoid a second
+// definition diverging (values follow nvCVImage.h).
+#define NVCV_RGB    4
+#define NVCV_RGBA   6
+#define NVCV_BGRA   7
+#define NVCV_U8     1
+#define NVCV_F32    7
+#define NVCV_PLANAR 1
+#define NVCV_CHUNKY 0
+#define NVCV_GPU    1
+// ── 10-bit packed RGB (new path in VFX 1.3; hooked up 2026-10-17) ──────
+// Value source: disassembled libnvVFXVideoSuperRes.so's
+// NvVFXVideoSuperResImpl::CheckImageEncodingMode — it compares pixelFormat
+// against {6,7} (RGBA/BGRA, componentType must = 1/U8) or {13} (componentType
+// must = 11), then requires planar=0 and ImageEncodingMode matching the
+// format.
+// Probe measurement (build/scratch/vsr10_probe.c): with pf=13 + ct=11,
+// Alloc / Load / Run all pass, the VSR 10-bit engine is usable.
+// Pixel bit order in yuv_to_rgba.h (R in bit0-9, same as mpv IMGFMT_X2RGB10).
+#define NVCV_RGB10A2 13
+#define NVCV_P32     11
+
+// ── NvVFX API function pointer types ─────────────────────────────────────
+
+typedef int (*PFN_NvVFX_CreateEffect)(const char*, void**);
+typedef void (*PFN_NvVFX_DestroyEffect)(void*);
+typedef int (*PFN_NvVFX_SetU32)(void*, const char*, unsigned int);
+typedef int (*PFN_NvVFX_SetImage)(void*, const char*, NvCVImage*);
+typedef int (*PFN_NvVFX_GetImage)(void*, const char*, NvCVImage*);
+typedef int (*PFN_NvVFX_SetCudaStream)(void*, const char*, CUstream);
+typedef int (*PFN_NvVFX_Load)(void*);
+typedef int (*PFN_NvVFX_Run)(void*, int);
+typedef int (*PFN_NvCVImage_Alloc)(NvCVImage*, unsigned int, unsigned int,
+    int, int, int, int, unsigned int);
+typedef int (*PFN_NvCVImage_Dealloc)(NvCVImage*);
+typedef int (*PFN_NvCVImage_Transfer)(const NvCVImage*, NvCVImage*, float,
+    CUstream, NvCVImage*);
+
+// ── library handles and symbol table (process-wide singleton; names kept
+// identical to before the move) ────────────────────────────────────────
+
+extern void *g_vfx_lib;
+extern void *g_nvcv_lib;
+
+extern PFN_NvVFX_CreateEffect    pfn_NvVFX_CreateEffect;
+extern PFN_NvVFX_DestroyEffect   pfn_NvVFX_DestroyEffect;
+extern PFN_NvVFX_SetU32          pfn_NvVFX_SetU32;
+extern PFN_NvVFX_SetImage        pfn_NvVFX_SetImage;
+extern PFN_NvVFX_GetImage        pfn_NvVFX_GetImage;
+extern PFN_NvVFX_SetCudaStream   pfn_NvVFX_SetCudaStream;
+extern PFN_NvVFX_Load            pfn_NvVFX_Load;
+extern PFN_NvVFX_Run             pfn_NvVFX_Run;
+extern PFN_NvCVImage_Alloc       pfn_NvCVImage_Alloc;
+extern PFN_NvCVImage_Dealloc     pfn_NvCVImage_Dealloc;
+extern PFN_NvCVImage_Transfer    pfn_NvCVImage_Transfer;
+
+// Locate and load the VFX libraries + resolve the symbols above; returns
+// true directly when already loaded (idempotent).
+bool vfx_load_libraries(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/video/filter/vsr_internal.h b/video/filter/vsr_internal.h
new file mode 100644
index 000000000..c69d35307
--- /dev/null
+++ b/video/filter/vsr_internal.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "vfx_loader.h"
+#include "yuv_to_rgba.h"
+
+// ── VSR processor ─────────────────────────────────────────────────────
+
+struct vsr_context {
+    void   *handle;       // NvVFX_Handle
+    // Buffer format is decided by bits: 8 = RGBA U8; 10 = packed RGB10A2/P32
+    // (bit order in yuv_to_rgba.h). Both are 4 bytes/px, pitch and copy
+    // semantics unchanged.
+    void   *in_pixels;    // allocated RGB GPU buffer
+    void   *out_pixels;   // allocated RGB GPU buffer
+    void   *tmp_pixels;   // temp transfer buffer
+    int     in_pitch, out_pitch, tmp_pitch;
+    CUstream stream;      // stream handed to engine: must be a **blocking stream** (see vsr_init)
+    bool    own_stream;
+    bool    ready;
+    int     in_w, in_h, out_w, out_h;
+    int     quality;
+    int     bits;         // 8 / 10 (engine ImageEncodingMode = bits==10)
+    // ── per-context image buffers (rebuilt on demand with size during
+    // engine lifetime)
+    struct NvCVImage in_img, out_img, tmp_img;
+};
+
+bool vsr_init(struct vsr_context *c, int in_w, int in_h,
+              int out_w, int out_h, int quality, int bits, CUstream stream);
+bool vsr_warmup(struct vsr_context *c, CUstream stream);
+// ── lightweight hot update (engine stays resident) ─────────────────────
+// quality: SetU32 update after Load. Output size only (input unchanged):
+// SetImage swaps the output buffer (vfx_outchange_test + player frame
+// number dump: PSNR 999dB byte-identical) — fullscreen switch avoids an
+// engine rebuild. Input change: rebuild (a real player changing files makes
+// mpv rebuild the whole filter chain, so the engine is inevitably rebuilt +
+// warmup).
+bool vsr_set_quality(struct vsr_context *c, int quality);
+bool vsr_set_output(struct vsr_context *c, int out_w, int out_h);
+// Caller writes RGBA into c->in_pixels before calling vsr_process.
+bool vsr_process(struct vsr_context *c, CUstream stream,
+                 void **output_ptr, int *out_w, int *out_h, int *out_pitch);
+// Destroy the engine; wait for in-flight stream work before destroying (so
+// the GPU cannot write to an already-freed buffer).
+void vsr_destroy(struct vsr_context *c);
diff --git a/video/filter/vsr_proc.c b/video/filter/vsr_proc.c
new file mode 100644
index 000000000..776ef74d6
--- /dev/null
+++ b/video/filter/vsr_proc.c
@@ -0,0 +1,364 @@
+#include "vsr_internal.h"
+#include "vfx_loader.h"
+
+#include <cuda.h>
+#include <dirent.h>
+#include <dlfcn.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+
+// ── Types from nvCVImage.h / nvVideoEffects.h (C-compatible) ────────────
+// struct NvCVImage and the NVCV_* constants are defined in vfx_loader.h
+// (shared by VSR/VFG)
+
+#define NVVFX_INPUT_IMAGE   "SrcImage0"
+#define NVVFX_OUTPUT_IMAGE  "DstImage0"
+#define NVVFX_CUDA_STREAM   "CudaStream"
+
+// Image buffers are per-context (vsr_context.in_img/out_img/tmp_img) — within
+// the engine's lifetime buffers are rebuilt on demand with size
+// (vsr_set_output), the SDK engine's SetImage references each instance's own
+// pixels address.
+
+// ── on-demand image buffer allocation (rebuilt on size change, old buffer
+// released first) ──────────────────────────────────────────────────────
+// Single allocation entry point: shared by vsr_init and
+// vsr_set_output/set_input, ruling out the "old buffer overwritten without
+// being released" leak path (the old implementation's scale hot update
+// memset g_out_img away without Dealloc).
+static bool ensure_img(NvCVImage *img, int w, int h, int bits, const char *tag) {
+    int pf = (bits == VFX_BITS_10) ? NVCV_RGB10A2 : NVCV_RGBA;
+    int ct = (bits == VFX_BITS_10) ? NVCV_P32     : NVCV_U8;
+    if (img->pixels && img->width == (unsigned)w && img->height == (unsigned)h &&
+        img->pixelFormat == pf && img->componentType == ct)
+        return true;
+    if (img->pixels) {
+        pfn_NvCVImage_Dealloc(img);
+        memset(img, 0, sizeof(*img));
+    }
+    int ar = pfn_NvCVImage_Alloc(img, (unsigned)w, (unsigned)h,
+                                 pf, ct, NVCV_CHUNKY, NVCV_GPU, 32);
+    if (ar != 0) {
+        fprintf(stderr, "VSR: Alloc(%s %dx%d %d-bit) failed (%d)\n",
+                tag, w, h, bits, ar);
+        memset(img, 0, sizeof(*img));
+        return false;
+    }
+    return true;
+}
+
+// ── vsr_init ─────────────────────────────────────────────────────────────
+
+bool vsr_init(struct vsr_context *c, int in_w, int in_h,
+              int out_w, int out_h, int quality, int bits, CUstream stream) {
+    if (!vfx_load_libraries()) return false;
+
+    memset(c, 0, sizeof(*c));
+    c->in_w = in_w;
+    c->in_h = in_h;
+    c->out_w = out_w;
+    c->out_h = out_h;
+    c->quality = quality;
+    c->bits = (bits == VFX_BITS_10) ? VFX_BITS_10 : VFX_BITS_8;
+
+    // Create effect — responds to "VideoSuperRes" (not "SuperRes")
+    int ret = pfn_NvVFX_CreateEffect("VideoSuperRes", &c->handle);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: CreateEffect(VideoSuperRes) failed (%d)\n", ret);
+        return false;
+    }
+
+    // QualityLevel (not "Strength")
+    pfn_NvVFX_SetU32(c->handle, "QualityLevel", (unsigned int)quality);
+    // ImageEncodingMode must be set before Load() (documentation string
+    // inside the library: Set before Load(); input/output images must match
+    // this mode). 0=8-bit RGBA/BGRA, 1=10-bit RGB10A2. For 8-bit it is not
+    // set (default 0), keeping historical behaviour byte-for-byte identical.
+    if (c->bits == VFX_BITS_10) {
+        int er = pfn_NvVFX_SetU32(c->handle, "ImageEncodingMode", 1);
+        if (er != 0) {
+            fprintf(stderr, "VSR: SetU32(ImageEncodingMode=1) failed (%d)\n", er);
+            vsr_destroy(c);
+            return false;
+        }
+    }
+    {
+        bool denoise = (in_w == out_w && in_h == out_h);
+        fprintf(stderr, "VSR: [%s] %dx%d->%dx%d quality=%d %s %d-bit\n",
+                denoise ? "DENOISE" : "UPSCALE",
+                in_w, in_h, out_w, out_h, quality,
+                denoise ? "(1:1 denoising)" : "(AI super-resolution)",
+                c->bits);
+    }
+
+    // ── Output image: RGBA U8 chunky GPU ──────────────────────────────────
+    if (!ensure_img(&c->out_img, out_w, out_h, c->bits, "output")) {
+        vsr_destroy(c);
+        return false;
+    }
+    ret = pfn_NvVFX_SetImage(c->handle, NVVFX_OUTPUT_IMAGE, &c->out_img);
+    fprintf(stderr, "VSR: DstImage0 %s -> %d\n",
+            c->bits == VFX_BITS_10 ? "RGB10A2" : "RGBA U8", ret);
+    if (ret != 0) {
+        vsr_destroy(c);
+        return false;
+    }
+    c->out_pixels = c->out_img.pixels;
+    c->out_pitch = (int)c->out_img.pitch;
+
+    // ── Input image: RGBA U8 chunky GPU ───────────────────────────────────
+    if (!ensure_img(&c->in_img, in_w, in_h, c->bits, "input")) {
+        vsr_destroy(c);
+        return false;
+    }
+    ret = pfn_NvVFX_SetImage(c->handle, NVVFX_INPUT_IMAGE, &c->in_img);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: SetImage(input RGBA U8) failed (%d)\n", ret);
+        vsr_destroy(c);
+        return false;
+    }
+    c->in_pixels = c->in_img.pixels;
+    c->in_pitch = (int)c->in_img.pitch;
+
+    // ── Temp buffer for NvCVImage_Transfer ────────────────────────────────
+    {
+        int max_dim = (out_w > in_w) ? out_w : in_w;
+        int max_h = (out_h > in_h) ? out_h : in_h;
+        if (!ensure_img(&c->tmp_img, max_dim, max_h, c->bits, "temp"))
+            memset(&c->tmp_img, 0, sizeof(c->tmp_img));   // not fatal
+    }
+    c->tmp_pixels = c->tmp_img.pixels;
+    c->tmp_pitch = (int)c->tmp_img.pitch;
+
+    // ── CUDA stream ───────────────────────────────────────────────────────
+    // What is handed to the engine must be a **blocking stream** (official
+    // "Setting Up the CUDA Stream": create the stream with cudaStreamCreate()
+    // or NvVFX_CudaStreamCreate(), then NvVFX_SetCudaStream; disassembly
+    // shows the latter is just one cudaStreamCreate → default flags =
+    // blocking stream).
+    // VFX 1.3 internally has a stage permanently attached to the legacy
+    // default stream (1.1 has no such mechanism); a non-blocking stream has
+    // **no implicit ordering** with the legacy stream → the engine reads
+    // input that has not landed yet, showing up as every output frame
+    // carrying the previous frame (plus non-deterministic duplicate/skipped
+    // source frames). Measured: build/scratch/probe/BLOCKING_REPORT.md
+    // (blocking stream offset 0, non-blocking stream 1~2).
+    // ⚠️ The output must be read back on this stream; reading on another
+    // stream requires your own synchronisation.
+    if (stream) {
+        c->stream = stream;
+        c->own_stream = false;
+    } else {
+        cuStreamCreate(&c->stream, CU_STREAM_DEFAULT);
+        c->own_stream = true;
+    }
+    pfn_NvVFX_SetCudaStream(c->handle, NVVFX_CUDA_STREAM, c->stream);
+
+    // ── Load model ────────────────────────────────────────────────────────
+    ret = pfn_NvVFX_Load(c->handle);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: Load failed (%d)\n", ret);
+        vsr_destroy(c);
+        return false;
+    }
+
+    c->ready = true;
+    fprintf(stderr, "VSR: init ok (%d-bit, in_pitch=%d)\n",
+            c->bits, c->in_pitch);
+    return true;
+}
+
+// ── vsr_warmup ────────────────────────────────────────────────────────────
+// Must be called after vsr_init, before the first vsr_process.
+// Blocks until complete (~30ms for 3 random frames on the given stream).
+
+bool vsr_warmup(struct vsr_context *c, CUstream stream)
+{
+    // Temporarily set stream for warmup, restore after
+    CUstream saved = c->stream;
+    c->stream = stream;
+
+    size_t in_bytes = (size_t)c->in_pitch * c->in_h;
+    unsigned char *random_rgba = (unsigned char*)malloc(in_bytes);
+    if (!random_rgba) {
+        fprintf(stderr, "VSR: warmup malloc failed\n");
+        c->stream = saved;
+        return false;
+    }
+    unsigned int seed = 42;
+    for (size_t i = 0; i < in_bytes; i += 4) {
+        seed = seed * 1103515245 + 12345;
+        unsigned int r = (seed >> 16) & 0xFF;
+        seed = seed * 1103515245 + 12345;
+        unsigned int g = (seed >> 16) & 0xFF;
+        seed = seed * 1103515245 + 12345;
+        unsigned int b = (seed >> 16) & 0xFF;
+        if (c->bits == VFX_BITS_10) {
+            // 10-bit: the byte order is a packed word, cannot randomise per
+            // byte (the A bit field must =3); 8-bit data is raised to the
+            // 10-bit magnitude with <<2, the content is still a random
+            // pattern.
+            unsigned int word = (r << 2) | ((g << 2) << 10) |
+                                ((b << 2) << 20) | (3u << 30);
+            memcpy(random_rgba + i, &word, 4);
+        } else {
+            random_rgba[i + 0] = (unsigned char)r;
+            random_rgba[i + 1] = (unsigned char)g;
+            random_rgba[i + 2] = (unsigned char)b;
+            random_rgba[i + 3] = 255;
+        }
+    }
+    cuMemcpyHtoD((CUdeviceptr)c->in_pixels, random_rgba, in_bytes);
+    free(random_rgba);
+
+    for (int wu = 0; wu < 3; wu++) {
+        int wr = pfn_NvVFX_Run(c->handle, 0);
+        if (wr != 0) {
+            fprintf(stderr, "VSR: warmup[%d] Run -> %d\n", wu, wr);
+            c->stream = saved;
+            return false;
+        }
+    }
+    c->stream = saved;
+    fprintf(stderr, "VSR: warmup complete (3 frames with random data)\n");
+    return true;
+}
+
+// ── vsr_process ──────────────────────────────────────────────────────────
+// Caller must have written RGBA into c->in_pixels (HtoD or D2D on stream).
+// The engine runs on c->stream (blocking stream, see vsr_init); the caller's
+// writes and read-backs are on the same stream → CUDA in-stream ordering
+// suffices (write completes before read, copy happens after the run).
+// **The output must be read back on the same stream**; cross-stream read-back
+// needs its own synchronisation.
+
+bool vsr_process(struct vsr_context *c, CUstream stream,
+                 void **output_ptr, int *out_w, int *out_h, int *out_pitch) {
+    if (!c->ready) return false;
+
+    int ret = pfn_NvVFX_Run(c->handle, 0);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: Run failed (%d)\n", ret);
+        return false;
+    }
+
+    ret = pfn_NvVFX_GetImage(c->handle, NVVFX_OUTPUT_IMAGE, &c->out_img);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: GetImage(output) failed (%d)\n", ret);
+        return false;
+    }
+
+    *output_ptr = c->out_img.pixels;
+    *out_w = (int)c->out_img.width;
+    *out_h = (int)c->out_img.height;
+    if (out_pitch) *out_pitch = (int)c->out_img.pitch;
+
+    return true;
+}
+
+// ── lightweight hot update (engine stays resident) ─────────────────────
+// SDK experiment conclusions (vfx_test5):
+//   - SetImage swapping input/output size → corrupted output (PSNR 7.4dB) —
+//     the engine's internal tile split is bound to the size at Load time,
+//     SetImage only updates metadata. A size change must rebuild the
+//     pipeline (vsr_destroy + vsr_init).
+//   - SetU32 changing QualityLevel → takes effect (q1 vs q3 output PSNR
+//     44.8dB structural difference) — quality can be updated lightly, engine
+//     stays resident.
+// The old implementation did a full engine rebuild on every hot update
+// (~1s Load latency + destroy race + old-engine leak on the scale path); the
+// previous light implementation (SetImage swapping size) produced corrupted
+// output — both abandoned.
+
+// ── lightweight hot update: size change (engine stays resident) ────────
+// Experiment (vfx_outchange_test / vfx_inchange_test): after the engine's
+// Load, SetImage swapping the output/input buffer gives output byte-identical
+// to an engine loaded directly at the new size (PSNR 999dB) — the SDK engine
+// re-adapts on SetImage (including the tile split), no rebuild needed. Size
+// changes (input or output) all take this path, bypassing the rebuild's
+// destroy/Load hang point (Xid 109).
+
+bool vsr_set_output(struct vsr_context *c, int out_w, int out_h) {
+    if (!c->handle || !c->ready) return false;
+    if (out_w == c->out_w && out_h == c->out_h)
+        return true;
+    if (!ensure_img(&c->out_img, out_w, out_h, c->bits, "output")) {
+        fprintf(stderr, "VSR: SetOutput alloc %dx%d failed\n", out_w, out_h);
+        return false;
+    }
+    int ret = pfn_NvVFX_SetImage(c->handle, NVVFX_OUTPUT_IMAGE, &c->out_img);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: SetImage(output %dx%d) failed (%d)\n",
+                out_w, out_h, ret);
+        return false;
+    }
+    c->out_pixels = c->out_img.pixels;
+    c->out_pitch = (int)c->out_img.pitch;
+    c->out_w = out_w;
+    c->out_h = out_h;
+    fprintf(stderr, "VSR: output %dx%d -> %dx%d (engine kept)\n",
+            (int)c->in_w, (int)c->in_h, out_w, out_h);
+    return true;
+}
+
+bool vsr_set_quality(struct vsr_context *c, int quality) {
+    if (!c->handle || !c->ready) return false;
+    int ret = pfn_NvVFX_SetU32(c->handle, "QualityLevel", (unsigned)quality);
+    if (ret != 0) {
+        fprintf(stderr, "VSR: SetU32(QualityLevel=%d) failed (%d)\n",
+                quality, ret);
+        return false;
+    }
+    c->quality = quality;
+    fprintf(stderr, "VSR: quality -> %d (engine kept)\n", quality);
+    return true;
+}
+
+// ── vsr_destroy ──────────────────────────────────────────────────────────
+// Wait for in-flight work before destroying: Run submits asynchronously, and
+// if in-flight inference is still executing on the GPU, Dealloc/
+// DestroyEffect releasing its target buffer causes a CUDA illegal access
+// (ILLEGAL_ADDRESS / GPU hang).
+//
+// Sync scope = the engine stream (c->stream, blocking stream, see vsr_init;
+// the stream is idle once inference completes).
+// A device-wide sync (cuCtxSynchronize) must not be used: it would drag in
+// stream 0 as well (the VO map's asynchronous copies on the GUI render
+// thread) and wait on them — once the render loop stops because the mpv core
+// is blocked, the copies on stream 0 never complete → ctx sync deadlock (core
+// measured in the Xid 109 scenario: destroy stuck in cuCtxSynchronize,
+// stream 0 NOT_READY). The caller must have already called
+// cuCtxPushCurrent.
+
+void vsr_destroy(struct vsr_context *c) {
+    if (c->stream)
+        cuStreamSynchronize(c->stream);
+    if (c->handle) {
+        pfn_NvVFX_DestroyEffect(c->handle);
+        c->handle = NULL;
+    }
+    if (c->out_img.pixels) {
+        pfn_NvCVImage_Dealloc(&c->out_img);
+        memset(&c->out_img, 0, sizeof(c->out_img));
+    }
+    if (c->in_img.pixels) {
+        pfn_NvCVImage_Dealloc(&c->in_img);
+        memset(&c->in_img, 0, sizeof(c->in_img));
+    }
+    if (c->tmp_img.pixels) {
+        pfn_NvCVImage_Dealloc(&c->tmp_img);
+        memset(&c->tmp_img, 0, sizeof(c->tmp_img));
+    }
+    if (c->own_stream && c->stream) {
+        cuStreamDestroy(c->stream);
+        c->stream = NULL;
+        c->own_stream = false;
+    }
+    c->ready = false;
+    c->in_w = c->in_h = c->out_w = c->out_h = 0;
+}
diff --git a/video/filter/yuv_to_rgba.c b/video/filter/yuv_to_rgba.c
new file mode 100644
index 000000000..8e1873760
--- /dev/null
+++ b/video/filter/yuv_to_rgba.c
@@ -0,0 +1,261 @@
+// yuv_to_rgba.c — CUDA YUV(NV12/P010/P016)→chunky U8 RGBA via NVRTC
+// Parameterized color matrix + range, compiled into kernel as #defines.
+
+#include "yuv_to_rgba.h"
+
+#include <cuda.h>
+#include <nvrtc.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const char *kKernelSrc =
+"extern \"C\" __global__ void yuv_to_rgb_kernel(\n"
+"    const unsigned char* __restrict__ y_plane,\n"
+"    int y_pitch,\n"
+"    const unsigned char* __restrict__ uv_plane,\n"
+"    int uv_pitch,\n"
+"    unsigned char* __restrict__ rgba_output,\n"
+"    int rgba_pitch,\n"
+"    int width,\n"
+"    int height)\n"
+"{\n"
+"    int x = blockIdx.x * blockDim.x + threadIdx.x;\n"
+"    int y = blockIdx.y * blockDim.y + threadIdx.y;\n"
+"    if (x >= width || y >= height) return;\n"
+"\n"
+"    float Y, U, V;\n"
+"    if (BIT_DEPTH <= 8) {\n"
+"        Y = (float)y_plane[y * y_pitch + x];\n"
+"    } else {\n"
+"        const unsigned short* y16 = (const unsigned short*)y_plane;\n"
+"        Y = (float)y16[y * y_pitch / 2 + x];\n"
+"    }\n"
+"\n"
+"    int uv_x = x & ~1;\n"
+"    int uv_y = y / 2;\n"
+"    if (BIT_DEPTH <= 8) {\n"
+"        U = (float)uv_plane[uv_y * uv_pitch + uv_x];\n"
+"        V = (float)uv_plane[uv_y * uv_pitch + uv_x + 1];\n"
+"    } else {\n"
+"        const unsigned short* uv16 = (const unsigned short*)uv_plane;\n"
+"        int idx = uv_y * (uv_pitch / 2) + uv_x;\n"
+"        U = (float)uv16[idx];\n"
+"        V = (float)uv16[idx + 1];\n"
+"    }\n"
+"\n"
+"    // BIT_DEPTH = sample storage bits (mpv imgfmt_desc.bpp[0]).\n"
+"    // P010/P016 (16): 10bit data is MSB-aligned (lower 6 bits cleared; see\n"
+"    // mpv img_format.c: P010 has the lower 6 bits cleared to 0) --\n"
+"    // the range must use full 16bit scale (65535); 10bit limited values\n"
+"    // (64/512/1023) left-aligned become 4096/32768/65472. Normalising as\n"
+"    // right-aligned 10bit would scale them 64x -> saturation -> magenta.\n"
+"    float y_max = (BIT_DEPTH <= 8) ? 255.0f\n"
+"                 : (BIT_DEPTH >= 16) ? 65535.0f : 1023.0f;\n"
+"    float uv_max = y_max;\n"
+"\n"
+"    if (YUV_RANGE_LIMITED) {\n"
+"        // limited (TV) code range: luma 16..235, chroma 16..240 (8-bit base),\n"
+"        // other depths at the same ratio -- 10-bit packed x4, P010/P016 (16bit\n"
+"        // storage, 10bit MSB-aligned) x64. Do NOT use y_max - y_min (8bit 239 /\n"
+"        // P010 61439): white would only reach 91.6 percent of full scale\n"
+"        // (measured: 8bit white -> 234/255, P010 white -> 934/1023). Reference\n"
+"        // = libplacebo (src/colorspace.c limited branch: scale =\n"
+"        // 2^bits/(2^bits-1), ymax=235/256*scale, ymin=16/256*scale,\n"
+"        // cmax=240/256*scale, cmid=128/256*scale) = ffmpeg swscale's\n"
+"        // (Y-16)*255/219. Cross-check in build/scratch/range/ (synthetic bars:\n"
+"        // kernel vs libplacebo vs swscale, every channel within 1 LSB).\n"
+"        float y_min   = (BIT_DEPTH <= 8) ? 16.0f\n"
+"                       : (BIT_DEPTH >= 16) ? 4096.0f : 64.0f;\n"
+"        float y_span  = (BIT_DEPTH <= 8) ? 219.0f\n"
+"                       : (BIT_DEPTH >= 16) ? 56064.0f : 876.0f;\n"
+"        float uv_mid  = (BIT_DEPTH <= 8) ? 128.0f\n"
+"                       : (BIT_DEPTH >= 16) ? 32768.0f : 512.0f;\n"
+"        float uv_span = (BIT_DEPTH <= 8) ? 224.0f\n"
+"                       : (BIT_DEPTH >= 16) ? 57344.0f : 896.0f;\n"
+"        Y = (Y - y_min) / y_span;\n"
+"        U = (U - uv_mid) / uv_span;\n"
+"        V = (V - uv_mid) / uv_span;\n"
+"    } else {\n"
+"        Y = Y / y_max;\n"
+"        U = U / uv_max - 0.5f;\n"
+"        V = V / uv_max - 0.5f;\n"
+"    }\n"
+"\n"
+"    float r = __saturatef(Y + K_RV * V);\n"
+"    float g = __saturatef(Y - K_GU * U - K_GV * V);\n"
+"    float b = __saturatef(Y + K_BU * U);\n"
+"\n"
+"    int out_idx = y * rgba_pitch + x * 4;\n"
+"#if OUT_BITS == 10\n"
+"    // packed RGB10A2 (little-endian u32): R bit0-9 / G bit10-19 / B bit20-29 / A bit30-31.\n"
+"    // Same bit order as mpv IMGFMT_X2RGB10, VK_FORMAT_A2B10G10R10_UNORM_PACK32\n"
+"    // (measured basis in the VFX_BITS_10 comment in yuv_to_rgba.h).\n"
+"    unsigned int r10 = (unsigned int)(r * 1023.0f + 0.5f);\n"
+"    unsigned int g10 = (unsigned int)(g * 1023.0f + 0.5f);\n"
+"    unsigned int b10 = (unsigned int)(b * 1023.0f + 0.5f);\n"
+"    *(unsigned int *)(rgba_output + out_idx) =\n"
+"        r10 | (g10 << 10) | (b10 << 20) | (3u << 30);\n"
+"#else\n"
+"    rgba_output[out_idx + 0] = (unsigned char)(r * 255.0f + 0.5f);\n"
+"    rgba_output[out_idx + 1] = (unsigned char)(g * 255.0f + 0.5f);\n"
+"    rgba_output[out_idx + 2] = (unsigned char)(b * 255.0f + 0.5f);\n"
+"    rgba_output[out_idx + 3] = 255;\n"
+"#endif\n"
+"}\n";
+
+// ── Matrix coefficient helpers ─────────────────────────────────────────
+
+static void get_matrix_defines(enum yuv_matrix m,
+                                const char **k_rv, const char **k_gu,
+                                const char **k_gv, const char **k_bu)
+{
+    // Kr + Kg + Kb = 1.0 for all matrices, coefficients pre-computed:
+    // K_RV = 2*(1-Kr), K_GU = 2*(1-Kb)*Kb/Kg, K_GV = 2*(1-Kr)*Kr/Kg, K_BU = 2*(1-Kb)
+    static const char *rv_601 = "1.402f",  *gu_601 = "0.34414f";
+    static const char *gv_601 = "0.71414f", *bu_601 = "1.772f";
+    static const char *rv_709 = "1.5748f",  *gu_709 = "0.18732f";
+    static const char *gv_709 = "0.46812f", *bu_709 = "1.8556f";
+    static const char *rv_2020 = "1.4746f",  *gu_2020 = "0.16455f";
+    static const char *gv_2020 = "0.57135f", *bu_2020 = "1.8814f";
+
+    switch (m) {
+    case YUV_MATRIX_BT709:
+        *k_rv = rv_709; *k_gu = gu_709; *k_gv = gv_709; *k_bu = bu_709; break;
+    case YUV_MATRIX_BT2020:
+        *k_rv = rv_2020; *k_gu = gu_2020; *k_gv = gv_2020; *k_bu = bu_2020; break;
+    default:
+        *k_rv = rv_601; *k_gu = gu_601; *k_gv = gv_601; *k_bu = bu_601; break;
+    }
+}
+
+// ── Init ───────────────────────────────────────────────────────────────
+
+bool yuv_to_rgba_init(struct yuv_to_rgba *c, int bit_depth,
+                       enum yuv_matrix matrix, enum yuv_range range,
+                       int out_bits)
+{
+    if (c->ready) return true;
+
+    nvrtcProgram prog;
+    nvrtcResult res = nvrtcCreateProgram(&prog, kKernelSrc,
+                                         "yuv_to_rgb_kernel", 0, NULL, NULL);
+    if (res != NVRTC_SUCCESS) {
+        fprintf(stderr, "yuv_to_rgba: nvrtcCreateProgram failed: %s\n",
+                nvrtcGetErrorString(res));
+        return false;
+    }
+
+    int major = 0, minor = 0;
+    CUdevice dev;
+    cuCtxGetDevice(&dev);
+    cuDeviceGetAttribute(&major, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, dev);
+    cuDeviceGetAttribute(&minor, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, dev);
+
+    char arch[32];
+    snprintf(arch, sizeof(arch), "--gpu-architecture=compute_%d%d", major, minor);
+
+    const char *k_rv, *k_gu, *k_gv, *k_bu;
+    get_matrix_defines(matrix, &k_rv, &k_gu, &k_gv, &k_bu);
+
+    char bd_str[32], range_str[32], ob_str[32];
+    snprintf(bd_str, sizeof(bd_str), "-DBIT_DEPTH=%d", bit_depth);
+    snprintf(range_str, sizeof(range_str), "-DYUV_RANGE_LIMITED=%d",
+             range == YUV_RANGE_LIMITED ? 1 : 0);
+    snprintf(ob_str, sizeof(ob_str), "-DOUT_BITS=%d",
+             out_bits == VFX_BITS_10 ? 10 : 8);
+
+    char krv_str[64], kgu_str[64], kgv_str[64], kbu_str[64];
+    snprintf(krv_str, sizeof(krv_str), "-DK_RV=%s", k_rv);
+    snprintf(kgu_str, sizeof(kgu_str), "-DK_GU=%s", k_gu);
+    snprintf(kgv_str, sizeof(kgv_str), "-DK_GV=%s", k_gv);
+    snprintf(kbu_str, sizeof(kbu_str), "-DK_BU=%s", k_bu);
+
+    const char *opts[] = {arch, "--use_fast_math",
+                          bd_str, range_str, ob_str,
+                          krv_str, kgu_str, kgv_str, kbu_str};
+    int nopts = 9;
+
+    res = nvrtcCompileProgram(prog, nopts, opts);
+    if (res != NVRTC_SUCCESS) {
+        size_t log_size;
+        nvrtcGetProgramLogSize(prog, &log_size);
+        char *log = (char *)malloc(log_size);
+        nvrtcGetProgramLog(prog, log);
+        fprintf(stderr, "yuv_to_rgba: NVRTC compile failed:\n%s\n", log);
+        free(log);
+        nvrtcDestroyProgram(&prog);
+        return false;
+    }
+
+    size_t ptx_size;
+    nvrtcGetPTXSize(prog, &ptx_size);
+    char *ptx = (char *)malloc(ptx_size);
+    nvrtcGetPTX(prog, ptx);
+    nvrtcDestroyProgram(&prog);
+
+    CUresult cu_res = cuModuleLoadData(&c->module, ptx);
+    free(ptx);
+    if (cu_res != CUDA_SUCCESS) {
+        fprintf(stderr, "yuv_to_rgba: cuModuleLoadData failed (%d)\n", cu_res);
+        return false;
+    }
+
+    cu_res = cuModuleGetFunction(&c->kernel, c->module, "yuv_to_rgb_kernel");
+    if (cu_res != CUDA_SUCCESS) {
+        fprintf(stderr, "yuv_to_rgba: cuModuleGetFunction failed (%d)\n", cu_res);
+        return false;
+    }
+
+    fprintf(stderr, "yuv_to_rgba: kernel compiled (sm_%d%d, bd=%d, out=%d-bit)\n",
+            major, minor, bit_depth, out_bits == VFX_BITS_10 ? 10 : 8);
+    c->ready = true;
+    return true;
+}
+
+// ── Convert ────────────────────────────────────────────────────────────
+
+bool yuv_to_rgba_convert(struct yuv_to_rgba *c,
+                          void *y_plane,   int y_pitch,
+                          void *uv_plane,  int uv_pitch,
+                          int width, int height,
+                          void *rgba_output, int rgba_pitch,
+                          CUstream stream)
+{
+    if (!c->ready) return false;
+
+    int block_x = 16, block_y = 16;
+    int grid_x = (width  + block_x - 1) / block_x;
+    int grid_y = (height + block_y - 1) / block_y;
+
+    void *args[] = {
+        &y_plane, &y_pitch,
+        &uv_plane, &uv_pitch,
+        &rgba_output, &rgba_pitch,
+        &width, &height
+    };
+
+    CUresult res = cuLaunchKernel(c->kernel,
+        grid_x, grid_y, 1,
+        block_x, block_y, 1,
+        0, stream, args, NULL);
+
+    if (res != CUDA_SUCCESS) {
+        fprintf(stderr, "yuv_to_rgba: cuLaunchKernel failed (%d)\n", res);
+        return false;
+    }
+    return true;
+}
+
+// ── Destroy ────────────────────────────────────────────────────────────
+
+void yuv_to_rgba_destroy(struct yuv_to_rgba *c)
+{
+    if (c->module) {
+        cuModuleUnload(c->module);
+        c->module = NULL;
+        c->kernel = NULL;
+    }
+    c->ready = false;
+}
diff --git a/video/filter/yuv_to_rgba.h b/video/filter/yuv_to_rgba.h
new file mode 100644
index 000000000..0bdd430ab
--- /dev/null
+++ b/video/filter/yuv_to_rgba.h
@@ -0,0 +1,126 @@
+// src/mpv/video/filter/yuv_to_rgba.h
+#pragma once
+
+#include <cuda.h>
+#include <stdbool.h>
+#include "video/img_format.h"  // mp_get_regular_imgfmt / IMGFMT_*
+#include "video/mp_image.h"    // struct mp_image_params
+#include "video/csputils.h"    // pl_color_system / pl_color_levels / mp_csp_guess_colorspace
+
+enum yuv_matrix {
+    YUV_MATRIX_BT601,
+    YUV_MATRIX_BT709,
+    YUV_MATRIX_BT2020,
+};
+
+enum yuv_range {
+    YUV_RANGE_LIMITED,
+    YUV_RANGE_FULL,
+};
+
+// ── Color params → yuv enum (single source of truth, vf_vsr/vf_rife) ──
+static inline enum yuv_matrix matrix_from_repr(struct mp_image_params *p)
+{
+    if (p->repr.sys == PL_COLOR_SYSTEM_UNKNOWN) {
+        enum pl_color_system guessed = mp_csp_guess_colorspace(p->w, p->h);
+        switch (guessed) {
+        case PL_COLOR_SYSTEM_BT_709:     return YUV_MATRIX_BT709;
+        case PL_COLOR_SYSTEM_BT_2020_NC:
+        case PL_COLOR_SYSTEM_BT_2020_C:  return YUV_MATRIX_BT2020;
+        default:                         return YUV_MATRIX_BT601;
+        }
+    }
+    switch (p->repr.sys) {
+    case PL_COLOR_SYSTEM_BT_709:     return YUV_MATRIX_BT709;
+    case PL_COLOR_SYSTEM_BT_2020_NC:
+    case PL_COLOR_SYSTEM_BT_2020_C:
+    case PL_COLOR_SYSTEM_BT_2100_PQ:
+    case PL_COLOR_SYSTEM_BT_2100_HLG: return YUV_MATRIX_BT2020;
+    // Profile 7/8 carry an HDR10-compatible base layer: BT.2020 YCbCr, PQ.
+    // Without this case the default below hands them BT.601 coefficients
+    // (Kr=0.299 instead of 0.2624) and every DV frame comes out red-shifted.
+    // Profile 5 is ICtCp and no YCbCr matrix is right for it — the P5
+    // profiles in ai.conf keep such files out of this converter entirely.
+    case PL_COLOR_SYSTEM_DOLBYVISION: return YUV_MATRIX_BT2020;
+    default:                          return YUV_MATRIX_BT601;
+    }
+}
+
+static inline enum yuv_range range_from_levels(enum pl_color_levels levels)
+{
+    return (levels == PL_COLOR_LEVELS_FULL) ? YUV_RANGE_FULL : YUV_RANGE_LIMITED;
+}
+
+// ── 10-bit path (VFX RGB10A2): bit depth ↔ mpv pixel format (single
+// source of truth) ─────────────────────────────────────────────────────
+// The packed word is a **little-endian u32**: R in bit0-9, G in bit10-19,
+// B in bit20-29, A in bit30-31. Measured basis (build/scratch/vsr10_probe.c,
+// using NVIDIA's own NvCVImage_Transfer, not guesswork):
+//   RGBA8(255,0,0) -> RGB10A2 yields word=0xC00003FF (low 10 bits = R)
+//   RGB10A2(word=0x000003FF) -> RGBA8 yields (255,0,0)
+// That bit order = mpv **IMGFMT_X2BGR10** ("2pad 10b 10g 10r", MSB→LSB, i.e.
+// R in the lowest bits) = VK_FORMAT_A2B10G10R10_UNORM_PACK32 = FFmpeg
+// AV_PIX_FMT_X2BGR10.
+// ⚠ NOT IMGFMT_X2RGB10 (that is "2pad 10r 10g 10b", R in the highest bits,
+// corresponding to VK_FORMAT_A2R10G10B10) — the names differ by one letter,
+// choosing wrong swaps R/B.
+// So the filter chain carries VFX's RGB10A2 data as X2BGR10, no bit
+// reshuffling needed.
+#define VFX_BITS_8   8
+#define VFX_BITS_10  10
+
+/// mpv frame subfmt → path bit depth (8/10).
+/// ⚠ Cannot use imgfmt_desc.bpp[0]: that is the **whole-pixel bit width**
+/// (RGBA=32, NV12=8, P010=16); comparing it against 8 would classify RGBA
+/// as 10-bit (measured: SDR 8-bit content going through VFG was wrongly
+/// taken as 10-bit, the engine interpreted RGBA bytes as RGB10A2 → garbled
+/// output).
+/// Correct measure = the stored byte count of a single **component**:
+///   NV12/RGBA → 1 byte → 8-bit; P010/P016 → 2 bytes → 10-bit;
+///   X2BGR10 is a packed special format (mp_get_regular_imgfmt does not
+///   support 10bit/8 non-divisible) → decided separately.
+static inline int vfx_bits_from_imgfmt(int imgfmt)
+{
+    if (imgfmt == IMGFMT_X2BGR10 || imgfmt == IMGFMT_X2RGB10)
+        return VFX_BITS_10;
+    struct mp_regular_imgfmt reg;
+    if (mp_get_regular_imgfmt(&reg, imgfmt))
+        return reg.component_size > 1 ? VFX_BITS_10 : VFX_BITS_8;
+    return VFX_BITS_8;
+}
+
+/// Path bit depth → output frame RGB format.
+static inline int vfx_imgfmt_from_bits(int bits)
+{
+    return bits == VFX_BITS_10 ? IMGFMT_X2BGR10 : IMGFMT_RGBA;
+}
+
+/// Whether this subfmt is already RGB (RGBA/BGRA/X2RGB10) — if so copy D2D
+/// directly, do not run the matrix conversion as YUV (otherwise the R plane
+/// would be read as Y and the G plane as chroma).
+static inline bool vfx_imgfmt_is_rgb(int imgfmt)
+{
+    return imgfmt == IMGFMT_RGBA || imgfmt == IMGFMT_BGRA ||
+           imgfmt == IMGFMT_X2BGR10 || imgfmt == IMGFMT_X2RGB10;
+}
+
+struct yuv_to_rgba {
+    CUmodule   module;
+    CUfunction kernel;
+    bool       ready;
+};
+
+/// out_bits: output pixel format, 8 = RGBA U8 (4 bytes/px), 10 = packed
+/// RGB10A2 (also 4 bytes/px, bit order above). The transfer curve **does not
+/// take part** in the conversion (consistent with historical behaviour:
+/// PQ/HLG code values are carried over as-is, tonemap is left to mpv's VO).
+bool yuv_to_rgba_init(struct yuv_to_rgba *c, int bit_depth,
+                       enum yuv_matrix matrix, enum yuv_range range,
+                       int out_bits);
+bool yuv_to_rgba_convert(struct yuv_to_rgba *c,
+                          void *y_plane,   int y_pitch,
+                          void *uv_plane,  int uv_pitch,
+                          int width, int height,
+                          void *rgba_output, int rgba_pitch,
+                          CUstream stream);
+void yuv_to_rgba_destroy(struct yuv_to_rgba *c);
