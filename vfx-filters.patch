+# ── NVIDIA VFX filters (VSR / TrueHDR / VFG) ───────────────────────────────
+# Needs the CUDA toolkit (cuda.h driver API) and NVRTC (runtime kernel JIT
+# used by yuv_to_rgba.c). Missing toolkit = filters simply not built; mpv
+# itself is unaffected.
+cuda_inc = '/opt/cuda/include'
+cuda_lib_dir = '/opt/cuda/lib64'
+cuda_h = cc.has_header('cuda.h', args: '-I' + cuda_inc)
+nvrtc_h = cc.has_header('nvrtc.h', args: '-I' + cuda_inc)
+cuda_lib = cuda_h ? cc.find_library('cuda', required: false) : dependency('', required: false)
+nvrtc_lib = nvrtc_h ? cc.find_library('nvrtc', dirs: cuda_lib_dir, required: false) : dependency('', required: false)
+has_vfx = cuda_h and nvrtc_h and cuda_lib.found() and nvrtc_lib.found()
+features += {'vsr': has_vfx}
+if has_vfx
+    dependencies += [cuda_lib, nvrtc_lib]
+    sources += files(
+        'video/filter/yuv_to_rgba.c',
+        'video/filter/vsr_proc.c',
+        'video/filter/vfx_loader.c',
+        'video/filter/vf_hwup.c',
+        'video/filter/vfg_proc.c',
+        'video/filter/vf_vfg.c',
+        'video/filter/vf_truehdr.c',
+        'video/filter/vf_vsr.c',
+        'video/filter/dlssnr_proc.c',
+        'video/filter/vf_dlssnr.c',
+    )
+        flags += ['-I' + cuda_inc]
+    vfx_rpath = get_option('vfx-rpath')
+    if vfx_rpath != ''
+        link_flags += ['-Wl,--disable-new-dtags', '-Wl,-rpath,' + vfx_rpath]
+    endif
+    message('VFX filters: enabled (vsr, truehdr, vfg, hwup, dlssnr)')
+else
+    message('VFX filters: disabled (CUDA toolkit not found)')
+endif
+
 add_project_arguments(flags, language: ['c', 'cpp', 'objc'])
 add_project_arguments(flags_c, language: ['c', 'objc'])
 add_project_link_arguments(link_flags, language: ['c', 'cpp', 'objc'])
