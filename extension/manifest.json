{
  "manifest_version": 3,
  "name": "mpv AI chain",
  "version": "1.0.0",
  "description": "Send a video, link or the current page to the local mpv NVIDIA AI chain (VSR, TrueHDR, DLSS 5 NR, VFG).",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this video to mpv (Alt+Shift+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "send-to-mpv": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Send the current tab to mpv"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
